---
import SwiperSlider from '../ui/SwiperSlider.astro'
import MediaCarousel from '../ui/MediaCarousel.astro'

type MediaItem = {
  src: string
  alt: string
  duration?: string
}

type Feature = {
  text: string
}

type ApplicationProduct = {
  series: string
  subtitle: string
  features: Feature[]
  image: string
  href: string
}

type CaseData = {
  title: string
  description: string
  logo: string
  logoAlt: string
  videos: MediaItem[]
  images: MediaItem[]
  applicationProduct: ApplicationProduct
}

const caseData: CaseData = {
  title: 'FOXCONN',
  description: 'The AG series electric grippers was applied with robots to complete complex tasks such as grabbing and handling mobile phone shells in FOXCONN factory.',
  logo: '/images/case-logo-template.svg',
  logoAlt: 'Foxconn logo',
  videos: [
    { src: 'https://www.figma.com/api/mcp/asset/ec83ae6f-17ee-43be-94dc-6256df3076a0', alt: 'Case video 1', duration: '03:30' },
    { src: 'https://www.figma.com/api/mcp/asset/eb9eb7c1-7e3d-476d-89b4-d0d6ea97ed44', alt: 'Case video 2', duration: '03:30' },
    { src: 'https://www.figma.com/api/mcp/asset/a67d776a-e858-4c61-be81-26db800a5034', alt: 'Case video 3', duration: '03:30' },
  ],
  images: [
    { src: 'https://www.figma.com/api/mcp/asset/eb9eb7c1-7e3d-476d-89b4-d0d6ea97ed44', alt: 'Case image 1' },
    { src: 'https://www.figma.com/api/mcp/asset/a67d776a-e858-4c61-be81-26db800a5034', alt: 'Case image 2' },
    { src: 'https://www.figma.com/api/mcp/asset/e4cbe213-b394-4385-b278-b0ee88d32c4d', alt: 'Case image 3' },
  ],
  applicationProduct: {
    series: 'AG Series',
    subtitle: 'Slim-type Electric Parallel Gripper',
    features: [
      { text: 'Compact Size & Flexible Installation' },
      { text: 'High Working Speed' },
      { text: 'Precise Force Control' },
    ],
    image: 'https://www.figma.com/api/mcp/asset/335df3b9-7a09-43a6-97f1-b0aca4023a00',
    href: '/products/series',
  },
}
---

<section class="bg-bg-primary pt-page pb-md">

  <!-- Back + Header -->
  <div class="global-padding">
    <div class="mx-auto max-w-[1200px]">
      <div class="max-w-[998px] mx-auto w-full flex flex-col gap-10 max-lg:gap-8">

        <a href="/cases" class="inline-flex items-center gap-2 text-small-caps text-text-primary group w-fit">
          <svg class="size-[14px] rotate-180 transition-transform duration-200 group-hover:-translate-x-1" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M5 11l4-4-4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back cases page
        </a>

        <div class="flex items-end justify-between gap-10 max-lg:flex-col max-lg:items-start max-lg:gap-6">
          <div class="flex flex-col gap-10 flex-1 min-w-0 max-lg:gap-6">
            <h1 class="text-h1 mob-h2 text-text-primary">{caseData.title}</h1>
            <p class="text-large text-text-primary max-w-[694px]">{caseData.description}</p>
          </div>
          <div class="border border-border-other-2 rounded-[6px] shrink-0 w-[187px] h-[106px] flex items-center justify-center bg-bg-primary p-6">
            <img src={caseData.logo} alt={caseData.logoAlt} class="w-full h-full object-contain" />
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Media carousels — full-bleed (videos + images) -->
  <div class="mt-[72px] flex flex-col gap-[72px] max-lg:mt-12 max-lg:gap-12">
    <MediaCarousel id="case-videos" kind="video" items={caseData.videos} />
    <MediaCarousel id="case-images" kind="image" items={caseData.images} />
  </div>

  <!-- Application Products -->
  <div class="global-padding mt-[72px] max-lg:mt-12">
    <div class="mx-auto max-w-[1200px]">
      <div class="max-w-[998px] mx-auto w-full flex flex-col gap-8">

        <h6 class="text-h6 text-text-primary">Application Products</h6>

        <div class="bg-bg-secondary p-10 flex items-start justify-between gap-10 max-lg:flex-col max-lg:px-5 max-lg:pt-9 max-lg:pb-5 max-lg:gap-8">

          <!-- Left: info -->
          <div class="flex flex-col justify-between self-stretch gap-8 max-w-[405px] max-lg:max-w-full max-lg:w-full">
            <div class="flex flex-col gap-6">
              <h3 class="text-h3 mob-h4 text-text-primary">{caseData.applicationProduct.series}</h3>
              <p class="text-large text-text-secondary">{caseData.applicationProduct.subtitle}</p>
            </div>
            <div class="flex items-end justify-between gap-4">
              <ul class="flex flex-col gap-2">
                {caseData.applicationProduct.features.map(f => (
                  <li class="flex items-center gap-2">
                    <span class="size-[6px] rounded-[2px] bg-fg-tertiary shrink-0" aria-hidden="true"></span>
                    <span class="text-regular text-text-primary">{f.text}</span>
                  </li>
                ))}
              </ul>
              <a
                href={caseData.applicationProduct.href}
                class="shrink-0 size-10 bg-btn-black-default hover:bg-btn-black-hover flex items-center justify-center rounded-[2px] transition-colors duration-200"
                aria-label="View product"
              >
                <svg class="size-6 text-text-alternate" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Right: product image -->
          <div class="shrink-0 w-[288px] h-[259px] max-lg:w-full max-lg:h-auto max-lg:aspect-[4/3] overflow-hidden bg-bg-secondary">
            <img
              src={caseData.applicationProduct.image}
              alt={caseData.applicationProduct.series}
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- Demonstration cases slider -->
<section class="bg-bg-other pt-page pb-lg">
  <div class="global-padding">
    <div class="mx-auto max-w-[1200px]">
      <SwiperSlider
        id="cases-demo-slider"
        title="Demonstration cases"
        description="Hundreds of factories are already using DH-Robotics' products. The number of customers continues to grow rapidly..."
        viewMoreHref="/cases"
        viewMoreLabel="View more"
        slideWidth={794}
        slideMobileWidth={320}
        gap={16}
      >
        {[
          {
            title: 'SAIC Volkswagen',
            series: 'PGC',
            href: '/cases/template',
            image: 'https://www.figma.com/api/mcp/asset/488f288e-98fd-481e-a250-ce5e0821a7a8',
          },
          {
            title: 'CHOW TAI FOOK',
            series: 'AG',
            href: '/cases/template',
            image: 'https://www.figma.com/api/mcp/asset/c47f9ca3-6bb1-41d4-80fc-e310ff254f1a',
          },
          {
            title: 'NISSAN',
            series: 'EFG',
            href: '/cases/template',
            image: 'https://www.figma.com/api/mcp/asset/488f288e-98fd-481e-a250-ce5e0821a7a8',
          },
          {
            title: 'FOXCONN',
            series: 'AG',
            href: '/cases/template',
            image: 'https://www.figma.com/api/mcp/asset/c47f9ca3-6bb1-41d4-80fc-e310ff254f1a',
          },
        ].map(item => (
          <div class="swiper-slide">
            <a href={item.href} class="relative overflow-hidden rounded-[2px] block h-[448px] max-lg:h-[280px] bg-bg-secondary group">
              <img src={item.image} alt={item.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 lg:group-hover:scale-105" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-r from-black/40 to-transparent"></div>
              <p class="text-h2 mob-h4 text-text-alternate absolute top-8 left-8 max-w-[300px]">{item.title}</p>
              <div class="absolute bottom-8 left-8 flex flex-col gap-3">
                <span class="text-tiny text-text-alternate opacity-60">Series:</span>
                <span class="border border-white/24 rounded-[4px] px-2 py-2 text-large-medium text-text-alternate">{item.series}</span>
              </div>
              <a href={item.href} class="absolute bottom-8 right-8 size-10 bg-btn-black-default hover:bg-btn-black-hover flex items-center justify-center rounded-[2px] transition-colors duration-200">
                <svg class="size-6 text-text-alternate" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </a>
          </div>
        ))}
      </SwiperSlider>
    </div>
  </div>
</section>
