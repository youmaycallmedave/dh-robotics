---
import Button from '../ui/Button.astro'
import { client } from '../../lib/sanity'

const tabs = [
  { id: 'all', label: 'All' },
  { id: 'product-manuals', label: 'Product Manuals' },
  { id: '3d-model', label: '3D Model' },
  { id: 'user-guides', label: 'User Guides' },
  { id: 'plugin', label: 'Plugin' },
  { id: 'dexterous-hand', label: 'Dexterous Hand' },
]

const [categories, seriesList, products, downloads] = await Promise.all([
  client.fetch(`*[_type == "productCategory"] | order(order asc) { _id, title }`),
  client.fetch(`*[_type == "productSeries"] | order(order asc) { _id, title, "categoryId": category._ref }`),
  client.fetch(`*[_type == "product"] | order(order asc) { _id, title, "seriesId": series._ref }`),
  client.fetch(`*[_type == "download"] | order(date desc) {
    _id, title, version, fileFormat, date, fileUrl, tab,
    "categoryId": category._ref,
    "categoryTitle": category->title,
    "seriesId": series._ref,
    "seriesTitle": series->title,
    "productId": product._ref,
    "productTitle": product->title
  }`),
])

const dlData = JSON.stringify({ categories, series: seriesList, products, downloads })
---

<section class="bg-bg-primary pt-page pb-14 max-lg:pb-10">
  <div class="global-padding">
    <div class="max-w-[694px] mx-auto text-center flex flex-col gap-6 max-lg:gap-5">
      <h1 class="text-h1 mob-h2 text-text-primary">Download Center</h1>
      <p class="text-regular text-text-primary">With deep technical background, DH-Robotics has developed the robotic and precision motion control technologies for many years.</p>
    </div>
  </div>
</section>

<!-- div, not section — avoids global section overflow:clip which breaks sticky -->
<div id="downloads-content" class="bg-bg-primary pb-[120px] max-lg:pb-20">
  <div class="global-padding">
    <div class="mx-auto max-w-[1000px] flex flex-col gap-[120px] max-lg:gap-16 items-center">

      <!-- Filters row -->
      <div class="flex gap-4 items-end w-full max-lg:flex-col max-lg:items-stretch max-lg:gap-3">

        <!-- Category -->
        <div class="flex flex-col gap-[2px] flex-1 min-w-0 dl-select-field" id="field-category">
          <label class="text-small text-text-primary text-trim-off">Product Category</label>
          <input type="hidden" id="filter-category" value="" />
          <div class="relative">
            <div class="input-row border-b flex items-center gap-4 py-4 cursor-pointer select-none dl-select-trigger" data-for="filter-category" data-placeholder="All Categories">
              <span class="dl-select-display flex-1 text-regular text-text-secondary opacity-50">All Categories</span>
              <svg class="dl-select-chevron shrink-0 text-text-primary transition-transform duration-200" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="dl-select-dropdown absolute top-full left-0 w-full z-20 hidden">
              <div class="border-2 border-border-quinary">
                <div class="border border-border-tertiary bg-bg-primary p-3 flex flex-col max-h-[240px] overflow-y-auto">
                  <button type="button" data-value="" class="dl-option text-trim-off flex items-center gap-4 text-left px-2 py-2 text-regular text-text-primary rounded-[4px] hover:bg-fg-other-4 transition-colors w-full cursor-pointer">
                    <span class="flex-1">All Categories</span>
                    <span class="check-badge bg-bg-tertiary p-[2px] rounded-full opacity-0 shrink-0">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6L5 9L10 3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </button>
                  {categories.map((c: any) => (
                    <button type="button" data-value={c._id} class="dl-option text-trim-off flex items-center gap-4 text-left px-2 py-2 text-regular text-text-secondary rounded-[4px] hover:bg-fg-other-4 hover:text-text-primary transition-colors w-full cursor-pointer">
                      <span class="flex-1">{c.title}</span>
                      <span class="check-badge bg-bg-tertiary p-[2px] rounded-full opacity-0 shrink-0">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6L5 9L10 3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Series -->
        <div class="flex flex-col gap-[2px] flex-1 min-w-0 dl-select-field" id="field-series">
          <label class="text-small text-text-primary text-trim-off">Product</label>
          <input type="hidden" id="filter-series" value="" />
          <div class="relative">
            <div class="input-row border-b flex items-center gap-4 py-4 cursor-pointer select-none dl-select-trigger" data-for="filter-series" data-placeholder="All Product Types">
              <span class="dl-select-display flex-1 text-regular text-text-secondary opacity-50">All Product Types</span>
              <svg class="dl-select-chevron shrink-0 text-text-primary transition-transform duration-200" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="dl-select-dropdown absolute top-full left-0 w-full z-20 hidden">
              <div class="border-2 border-border-quinary">
                <div class="border border-border-tertiary bg-bg-primary p-3 flex flex-col max-h-[240px] overflow-y-auto">
                  <button type="button" data-value="" class="dl-option text-trim-off flex items-center gap-4 text-left px-2 py-2 text-regular text-text-primary rounded-[4px] hover:bg-fg-other-4 transition-colors w-full cursor-pointer">
                    <span class="flex-1">All Product Types</span>
                    <span class="check-badge bg-bg-tertiary p-[2px] rounded-full opacity-0 shrink-0">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6L5 9L10 3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </button>
                  {seriesList.map((s: any) => (
                    <button type="button" data-value={s._id} data-category={s.categoryId} class="dl-option text-trim-off flex items-center gap-4 text-left px-2 py-2 text-regular text-text-secondary rounded-[4px] hover:bg-fg-other-4 hover:text-text-primary transition-colors w-full cursor-pointer">
                      <span class="flex-1">{s.title}</span>
                      <span class="check-badge bg-bg-tertiary p-[2px] rounded-full opacity-0 shrink-0">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6L5 9L10 3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Product -->
        <div class="flex flex-col gap-[2px] flex-1 min-w-0 dl-select-field" id="field-product">
          <label class="text-small text-text-primary text-trim-off">Product Model</label>
          <input type="hidden" id="filter-product" value="" />
          <div class="relative">
            <div class="input-row border-b flex items-center gap-4 py-4 cursor-pointer select-none dl-select-trigger" data-for="filter-product" data-placeholder="All Models">
              <span class="dl-select-display flex-1 text-regular text-text-secondary opacity-50">All Models</span>
              <svg class="dl-select-chevron shrink-0 text-text-primary transition-transform duration-200" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="dl-select-dropdown absolute top-full left-0 w-full z-20 hidden">
              <div class="border-2 border-border-quinary">
                <div class="border border-border-tertiary bg-bg-primary p-3 flex flex-col max-h-[240px] overflow-y-auto">
                  <button type="button" data-value="" class="dl-option text-trim-off flex items-center gap-4 text-left px-2 py-2 text-regular text-text-primary rounded-[4px] hover:bg-fg-other-4 transition-colors w-full cursor-pointer">
                    <span class="flex-1">All Models</span>
                    <span class="check-badge bg-bg-tertiary p-[2px] rounded-full opacity-0 shrink-0">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6L5 9L10 3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </button>
                  {products.map((p: any) => (
                    <button type="button" data-value={p._id} data-series={p.seriesId} class="dl-option text-trim-off flex items-center gap-4 text-left px-2 py-2 text-regular text-text-secondary rounded-[4px] hover:bg-fg-other-4 hover:text-text-primary transition-colors w-full cursor-pointer">
                      <span class="flex-1">{p.title}</span>
                      <span class="check-badge bg-bg-tertiary p-[2px] rounded-full opacity-0 shrink-0">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6L5 9L10 3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Search -->
        <div class="flex flex-col gap-[2px] flex-1 min-w-0">
          <label for="downloads-search" class="text-small text-text-primary text-trim-off">Search</label>
          <div class="input-row border-b flex items-center gap-4 py-4">
            <input
              id="downloads-search"
              type="text"
              placeholder="Enter keywords..."
              class="text-regular text-text-primary flex-1 bg-transparent outline-none placeholder:text-text-secondary placeholder:opacity-50"
            />
          </div>
        </div>

      </div>

      <!-- Category tabs (left) + list (right) -->
      <div class="w-full flex gap-10 max-lg:flex-col max-lg:gap-8 items-start" id="downloads-list-wrap">

        <!-- Vertical category tabs -->
        <div
          id="downloads-tabs"
          class="shrink-0 lg:w-[160px] flex flex-col gap-4 self-start lg:sticky lg:top-[120px] lg:border-l lg:border-border-secondary lg:pl-4 max-lg:w-full max-lg:flex-row max-lg:overflow-x-auto max-lg:border-b max-lg:border-border-other-2 max-lg:pb-3 max-lg:gap-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {tabs.map((tab: any, i: number) => (
            <button
              type="button"
              data-tab={tab.id}
              class:list={['dl-tab text-small-medium text-trim-off text-left whitespace-nowrap shrink-0 transition-colors duration-200 cursor-pointer', i === 0 ? 'is-active' : '']}
            >{tab.label}</button>
          ))}
        </div>

        <!-- List -->
        <div class="flex-1 min-w-0 w-full">

        <div id="downloads-items" class="relative z-[1]">
          {downloads.map((item: any) => (
            <div
              class="border-t border-border-other-2 flex items-center justify-between py-8 gap-4 downloads-item"
              data-tab={item.tab}
              data-category={item.categoryId ?? ''}
              data-series={item.seriesId ?? ''}
              data-product={item.productId ?? ''}
            >
              <div class="flex flex-col gap-5">
                <p class="text-h6 text-text-primary">{item.title}</p>
                <p class="text-regular text-text-secondary">
                  {[item.version && `Version ${item.version}`, item.fileFormat && `Format ${item.fileFormat}`, item.date].filter(Boolean).join(' · ')}
                </p>
              </div>
              <Button label="Download" href={item.fileUrl ?? '#'} variant="black" class="shrink-0" />
            </div>
          ))}
        </div>

        <div id="downloads-empty" class="hidden items-center justify-center py-[120px]">
          <div class="flex items-start gap-[72px]">
            <div class="relative shrink-0 size-16">
              <svg class="size-16 text-text-primary" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                <circle cx="26" cy="26" r="18" stroke="currentColor" stroke-width="3"/>
                <path d="M39 39L56 56" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
              </svg>
              <div class="absolute top-0 right-0 size-6 bg-bg-quaternary rounded-full border-2 border-bg-primary flex items-center justify-center">
                <svg class="size-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M3 3l6 6M9 3l-6 6" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </div>
            </div>
            <p class="text-h5 text-text-primary">Sorry, no matches found.<br/>Try entering a new query or using a filter.</p>
          </div>
        </div>

        </div>

      </div>

    </div>
  </div>
</div>

<style>
  .dl-option[data-filtered] { display: none; }

  .dl-tab {
    color: var(--color-text-secondary);
    position: relative;
  }
  .dl-tab:hover { color: var(--color-text-primary); }
  .dl-tab.is-active { color: var(--color-text-primary); }

  @media (min-width: 1024px) {
    .dl-tab.is-active::before {
      content: '';
      position: absolute;
      left: -17px;
      top: 50%;
      transform: translateY(-50%);
      width: 2px;
      height: 14px;
      background: var(--color-fg-alternative);
    }
  }
</style>

<script define:vars={{ dlData }} is:inline>
  const { series, products } = JSON.parse(dlData)

  // ── Custom select logic ──────────────────────────────────────
  class DlSelect {
    constructor(fieldEl) {
      this.field    = fieldEl
      this.trigger  = fieldEl.querySelector('.dl-select-trigger')
      this.dropdown = fieldEl.querySelector('.dl-select-dropdown')
      this.display  = fieldEl.querySelector('.dl-select-display')
      this.chevron  = fieldEl.querySelector('.dl-select-chevron')
      this.input    = document.getElementById(this.trigger.dataset.for)
      this.options  = Array.from(fieldEl.querySelectorAll('.dl-option'))
      this.placeholder = this.trigger.dataset.placeholder || 'All'

      this.trigger.addEventListener('click', () => {
        this.dropdown.classList.contains('hidden') ? this.open() : this.close()
      })

      this.options.forEach(btn => {
        btn.addEventListener('click', () => {
          this.select(btn.dataset.value, btn.querySelector('span')?.textContent?.trim() ?? '')
          this.close()
          this.field.dispatchEvent(new CustomEvent('dl-change', { bubbles: true }))
        })
      })
    }

    get value() { return this.input.value }

    open() {
      this.dropdown.classList.remove('hidden')
      this.chevron.classList.add('rotate-180')
      this.trigger.querySelector('.input-row')?.classList.add('is-focused-custom')
    }

    close() {
      this.dropdown.classList.add('hidden')
      this.chevron.classList.remove('rotate-180')
    }

    select(value, label) {
      this.input.value = value
      if (value) {
        this.display.textContent = label
        this.display.classList.remove('opacity-50', 'text-text-secondary')
        this.display.classList.add('text-text-primary')
      } else {
        this.display.textContent = this.placeholder
        this.display.classList.add('opacity-50', 'text-text-secondary')
        this.display.classList.remove('text-text-primary')
      }
      this.options.forEach(btn => {
        const selected = btn.dataset.value === value
        btn.classList.toggle('bg-fg-other-4', selected)
        btn.classList.toggle('text-text-primary', selected)
        btn.classList.toggle('rounded-[2px]', selected)
        btn.classList.toggle('text-text-secondary', !selected && btn.dataset.value !== '')
        btn.querySelector('.check-badge').style.opacity = selected ? '1' : '0'
      })
    }

    reset() { this.select('', '') }

    filterOptions(predicate) {
      let hasVisible = false
      this.options.forEach(btn => {
        if (!btn.dataset.value) return
        const hide = !predicate(btn)
        btn.toggleAttribute('data-filtered', hide)
        if (!hide) hasVisible = true
      })
      if (this.value && !this.options.find(b => b.dataset.value === this.value && !b.hasAttribute('data-filtered'))) {
        this.reset()
      }
    }

    showAll() {
      this.options.forEach(btn => btn.removeAttribute('data-filtered'))
    }
  }

  const selCategory = new DlSelect(document.getElementById('field-category'))
  const selSeries   = new DlSelect(document.getElementById('field-series'))
  const selProduct  = new DlSelect(document.getElementById('field-product'))

  // Close dropdowns on outside click
  document.addEventListener('click', (e) => {
    [selCategory, selSeries, selProduct].forEach(sel => {
      if (!sel.field.contains(e.target)) sel.close()
    })
  })

  const searchInput = document.getElementById('downloads-search')
  const items       = document.querySelectorAll('.downloads-item')
  const emptyState  = document.getElementById('downloads-empty')
  let activeTab = 'all'

  function updateSelects() {
    const catId    = selCategory.value
    const seriesId = selSeries.value

    selSeries.filterOptions(btn => !catId || btn.dataset.category === catId)

    const validSeriesIds = catId
      ? series.filter(s => s.categoryId === catId).map(s => s._id)
      : series.map(s => s._id)

    selProduct.filterOptions(btn => {
      const inSeries   = !seriesId || btn.dataset.series === seriesId
      const inCategory = !catId   || validSeriesIds.includes(btn.dataset.series)
      return inSeries && inCategory
    })
  }

  function filterItems() {
    const catId     = selCategory.value
    const seriesId  = selSeries.value
    const productId = selProduct.value
    const query     = (searchInput?.value ?? '').toLowerCase().trim()

    let visible = 0
    items.forEach(item => {
      const itemTab     = item.dataset.tab ?? ''
      const itemCat     = item.dataset.category ?? ''
      const itemSeries  = item.dataset.series ?? ''
      const itemProduct = item.dataset.product ?? ''
      const isGlobal    = !itemCat && !itemSeries && !itemProduct
      const title       = item.querySelector('p')?.textContent?.toLowerCase() ?? ''

      if (activeTab !== 'all' && itemTab !== activeTab) { item.style.display = 'none'; return }

      if (productId) {
        if (!isGlobal && itemProduct !== productId) { item.style.display = 'none'; return }
      } else if (seriesId) {
        if (!isGlobal && itemSeries !== seriesId)   { item.style.display = 'none'; return }
      } else if (catId) {
        if (!isGlobal && itemCat !== catId)          { item.style.display = 'none'; return }
      }

      if (query && !title.includes(query)) { item.style.display = 'none'; return }

      item.style.display = ''
      visible++
    })

    if (emptyState) emptyState.style.display = visible === 0 ? 'flex' : 'none'
  }

  document.getElementById('field-category').addEventListener('dl-change', () => {
    selSeries.reset()
    selProduct.reset()
    updateSelects()
    filterItems()
  })

  document.getElementById('field-series').addEventListener('dl-change', () => {
    const seriesId = selSeries.value
    if (seriesId) {
      const ser = series.find(s => s._id === seriesId)
      if (ser?.categoryId) selCategory.select(ser.categoryId, document.querySelector(`#field-category [data-value="${ser.categoryId}"] span`)?.textContent?.trim() ?? '')
    }
    selProduct.reset()
    updateSelects()
    filterItems()
  })

  document.getElementById('field-product').addEventListener('dl-change', () => {
    const productId = selProduct.value
    if (productId) {
      const prod = products.find(p => p._id === productId)
      if (prod?.seriesId) {
        const serBtn = document.querySelector(`#field-series [data-value="${prod.seriesId}"]`)
        selSeries.select(prod.seriesId, serBtn?.querySelector('span')?.textContent?.trim() ?? '')
        const ser = series.find(s => s._id === prod.seriesId)
        if (ser?.categoryId) {
          const catBtn = document.querySelector(`#field-category [data-value="${ser.categoryId}"]`)
          selCategory.select(ser.categoryId, catBtn?.querySelector('span')?.textContent?.trim() ?? '')
        }
      }
    }
    updateSelects()
    filterItems()
  })

  searchInput?.addEventListener('input', filterItems)

  // ── Vertical category tabs ───────────────────────────────────
  const dlTabs = document.getElementById('downloads-tabs')
  if (dlTabs) {
    const tabBtns = dlTabs.querySelectorAll('[data-tab]')
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('is-active'))
        btn.classList.add('is-active')
        dlTabs.dispatchEvent(new CustomEvent('tabchange', { detail: { tab: btn.dataset.tab }, bubbles: true }))
      })
    })
  }

  document.addEventListener('tabchange', (e) => {
    if (e.target.id !== 'downloads-tabs') return
    activeTab = e.detail.tab || 'all'
    filterItems()
  })

  document.querySelector('[href="#downloads-content"]')
    ?.addEventListener('click', (e) => {
      e.preventDefault()
      document.getElementById('downloads-content')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
    })

  updateSelects()
  filterItems()
</script>
