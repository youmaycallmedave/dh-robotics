---
import Button from '../ui/Button.astro'
import FilterTabs from '../ui/FilterTabs.astro'
import PageHero from '../ui/PageHero.astro'
import { client } from '../../lib/sanity'

const tabs = [
  { id: 'all', label: 'All' },
  { id: 'product-manuals', label: 'Product Manuals' },
  { id: '3d-model', label: '3D Model' },
  { id: 'user-guides', label: 'User Guides' },
  { id: 'plugin', label: 'Plugin' },
  { id: 'dexterous-hand', label: 'Dexterous Hand' },
]

const [categories, seriesList, products, downloads] = await Promise.all([
  client.fetch(`*[_type == "productCategory"] | order(order asc) { _id, title }`),
  client.fetch(`*[_type == "productSeries"] | order(order asc) { _id, title, "categoryId": category._ref }`),
  client.fetch(`*[_type == "product"] | order(order asc) { _id, title, "seriesId": series._ref }`),
  client.fetch(`*[_type == "download"] | order(date desc) {
    _id, title, version, fileFormat, date, fileUrl, tab,
    "categoryId": category._ref,
    "categoryTitle": category->title,
    "seriesId": series._ref,
    "seriesTitle": series->title,
    "productId": product._ref,
    "productTitle": product->title
  }`),
])

const dlData = JSON.stringify({ categories, series: seriesList, products, downloads })
---

<PageHero
  title="Download Center"
  description="With deep technical background, DH-Robotics has developed the robotic and precision motion control technologies for many years."
  image="https://www.figma.com/api/mcp/asset/92148eb6-c027-4479-b8d5-83460911b97e"
  imageAlt="DH-Robotics products"
  scrollTarget="downloads-content"
/>

<section id="downloads-content" class="bg-bg-primary pb-[120px] max-lg:pb-20">
  <div class="global-padding">
    <div class="mx-auto max-w-[1200px] flex flex-col gap-[120px] max-lg:gap-16 items-center">

      <!-- Filters row -->
      <div class="flex gap-4 items-end w-full max-lg:flex-col max-lg:items-stretch max-lg:gap-3">

        <!-- Category -->
        <div class="flex flex-col gap-[2px] flex-1 min-w-0">
          <label for="filter-category" class="text-small text-text-primary">Product Category</label>
          <div class="input-row border-b flex items-center gap-4 py-4">
            <select id="filter-category" class="text-regular text-text-primary flex-1 bg-transparent outline-none appearance-none cursor-pointer">
              <option value="">All Categories</option>
              {categories.map((c: any) => <option value={c._id}>{c.title}</option>)}
            </select>
          </div>
        </div>

        <!-- Series -->
        <div class="flex flex-col gap-[2px] flex-1 min-w-0">
          <label for="filter-series" class="text-small text-text-primary">Series</label>
          <div class="input-row border-b flex items-center gap-4 py-4">
            <select id="filter-series" class="text-regular text-text-primary flex-1 bg-transparent outline-none appearance-none cursor-pointer">
              <option value="">All Series</option>
              {seriesList.map((s: any) => <option value={s._id} data-category={s.categoryId}>{s.title}</option>)}
            </select>
          </div>
        </div>

        <!-- Product -->
        <div class="flex flex-col gap-[2px] flex-1 min-w-0">
          <label for="filter-product" class="text-small text-text-primary">Product Model</label>
          <div class="input-row border-b flex items-center gap-4 py-4">
            <select id="filter-product" class="text-regular text-text-primary flex-1 bg-transparent outline-none appearance-none cursor-pointer">
              <option value="">All Models</option>
              {products.map((p: any) => <option value={p._id} data-series={p.seriesId}>{p.title}</option>)}
            </select>
          </div>
        </div>

        <!-- Search -->
        <div class="flex flex-col gap-[2px] flex-1 min-w-0">
          <label for="downloads-search" class="text-small text-text-primary">Search</label>
          <div class="input-row border-b flex items-center gap-4 py-4">
            <input
              id="downloads-search"
              type="text"
              placeholder="Enter keywords..."
              class="text-regular text-text-primary flex-1 bg-transparent outline-none placeholder:text-text-secondary placeholder:opacity-50"
            />
          </div>
        </div>

        <button id="search-btn" class="bg-btn-black-default hover:bg-btn-black-hover text-text-alternate rounded-[2px] shrink-0 size-10 flex items-center justify-center transition-colors self-end mb-4">
          <svg class="size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"/>
            <path d="M13.5 13.5L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>

      </div>

      <!-- Tabs + list -->
      <div class="w-[999px] max-xl:w-full flex flex-col gap-0" id="downloads-list-wrap">

        <FilterTabs id="downloads-tabs" tabs={tabs} />

        <div id="downloads-items" class="relative z-[1] mt-[-1px]">
          {downloads.map((item: any) => (
            <div
              class="border-t border-border-other-2 flex items-center justify-between py-8 gap-4 downloads-item"
              data-tab={item.tab}
              data-category={item.categoryId ?? ''}
              data-series={item.seriesId ?? ''}
              data-product={item.productId ?? ''}
            >
              <div class="flex flex-col gap-5">
                <p class="text-h6 text-text-primary">{item.title}</p>
                <p class="text-regular text-text-secondary">
                  {[item.version && `Version ${item.version}`, item.fileFormat && `Format ${item.fileFormat}`, item.date].filter(Boolean).join(' · ')}
                </p>
                <div class="flex flex-col gap-1">
                  {item.tab          && <p class="text-tiny text-text-secondary">Type: {item.tab}</p>}
                  {item.categoryTitle && <p class="text-tiny text-text-secondary">Cat: {item.categoryTitle}</p>}
                  {item.seriesTitle   && <p class="text-tiny text-text-secondary">Series: {item.seriesTitle}</p>}
                  {item.productTitle  && <p class="text-tiny text-text-secondary">Product: {item.productTitle}</p>}
                </div>
              </div>
              <Button label="Download" href={item.fileUrl ?? '#'} variant="black" class="shrink-0" />
            </div>
          ))}
        </div>

        <div id="downloads-empty" class="hidden items-center justify-center py-[120px]">
          <div class="flex items-start gap-[72px]">
            <div class="relative shrink-0 size-16">
              <svg class="size-16 text-text-primary" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                <circle cx="26" cy="26" r="18" stroke="currentColor" stroke-width="3"/>
                <path d="M39 39L56 56" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
              </svg>
              <div class="absolute top-0 right-0 size-6 bg-bg-quaternary rounded-full border-2 border-bg-primary flex items-center justify-center">
                <svg class="size-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M3 3l6 6M9 3l-6 6" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </div>
            </div>
            <p class="text-h5 text-text-primary">Sorry, no matches found.<br/>Try entering a new query or using a filter.</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script define:vars={{ dlData }} is:inline>
  const { series, products } = JSON.parse(dlData)

  const selCategory = document.getElementById('filter-category')
  const selSeries   = document.getElementById('filter-series')
  const selProduct  = document.getElementById('filter-product')
  const searchInput = document.getElementById('downloads-search')
  const items       = document.querySelectorAll('.downloads-item')
  const emptyState  = document.getElementById('downloads-empty')

  // All <option> elements (excluding "All" placeholder)
  const seriesOpts  = Array.from(selSeries.querySelectorAll('option[value]:not([value=""])'))
  const productOpts = Array.from(selProduct.querySelectorAll('option[value]:not([value=""])'))

  let activeTab = 'all'

  // ── Cascade: update visible options ─────────────────────────
  function updateSelects() {
    const catId    = selCategory.value
    const seriesId = selSeries.value

    // Series options: show only those matching selected category
    seriesOpts.forEach(opt => {
      const matches = !catId || opt.dataset.category === catId
      opt.hidden = !matches
    })
    // If current series selection is now hidden, reset it
    if (selSeries.value && selSeries.querySelector(`option[value="${selSeries.value}"]`)?.hidden) {
      selSeries.value = ''
    }

    // Product options: match selected series (or all series of selected category)
    const validSeriesIds = catId
      ? series.filter(s => s.categoryId === catId).map(s => s._id)
      : series.map(s => s._id)

    productOpts.forEach(opt => {
      const inSeries   = !seriesId || opt.dataset.series === seriesId
      const inCategory = !catId   || validSeriesIds.includes(opt.dataset.series)
      opt.hidden = !(inSeries && inCategory)
    })
    if (selProduct.value && selProduct.querySelector(`option[value="${selProduct.value}"]`)?.hidden) {
      selProduct.value = ''
    }
  }

  // ── Filter download rows ─────────────────────────────────────
  function filterItems() {
    const catId     = selCategory.value
    const seriesId  = selSeries.value
    const productId = selProduct.value
    const query     = (searchInput?.value ?? '').toLowerCase().trim()

    let visible = 0
    items.forEach(item => {
      const itemTab     = item.dataset.tab ?? ''
      const itemCat     = item.dataset.category ?? ''
      const itemSeries  = item.dataset.series ?? ''
      const itemProduct = item.dataset.product ?? ''
      const isGlobal    = !itemCat && !itemSeries && !itemProduct
      const title       = item.querySelector('p')?.textContent?.toLowerCase() ?? ''

      // Tab
      if (activeTab !== 'all' && itemTab !== activeTab) { item.style.display = 'none'; return }

      // Cascade: product → series → category (most specific wins)
      if (productId) {
        if (!isGlobal && itemProduct !== productId) { item.style.display = 'none'; return }
      } else if (seriesId) {
        if (!isGlobal && itemSeries !== seriesId)   { item.style.display = 'none'; return }
      } else if (catId) {
        if (!isGlobal && itemCat !== catId)          { item.style.display = 'none'; return }
      }

      // Search
      if (query && !title.includes(query)) { item.style.display = 'none'; return }

      item.style.display = ''
      visible++
    })

    if (emptyState) emptyState.style.display = visible === 0 ? 'flex' : 'none'
  }

  selCategory.addEventListener('change', () => {
    // Reset more specific filters when category changes
    selSeries.value  = ''
    selProduct.value = ''
    updateSelects()
    filterItems()
  })

  selSeries.addEventListener('change', () => {
    const seriesId = selSeries.value
    if (seriesId) {
      // Auto-fill category from selected series
      const ser = series.find(s => s._id === seriesId)
      if (ser?.categoryId) selCategory.value = ser.categoryId
    }
    selProduct.value = ''
    updateSelects()
    filterItems()
  })

  selProduct.addEventListener('change', () => {
    const productId = selProduct.value
    if (productId) {
      // Auto-fill series and category from selected product
      const prod = products.find(p => p._id === productId)
      if (prod?.seriesId) {
        selSeries.value = prod.seriesId
        const ser = series.find(s => s._id === prod.seriesId)
        if (ser?.categoryId) selCategory.value = ser.categoryId
      }
    }
    updateSelects()
    filterItems()
  })
  searchInput?.addEventListener('input', filterItems)

  document.addEventListener('tabchange', (e) => {
    if (e.target.id !== 'downloads-tabs') return
    activeTab = e.detail.tab || 'all'
    filterItems()
  })

  document.querySelector('[href="#downloads-content"]')
    ?.addEventListener('click', (e) => {
      e.preventDefault()
      document.getElementById('downloads-content')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
    })

  updateSelects()
  filterItems()
</script>
