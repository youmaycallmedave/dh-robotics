---
import Section from '../ui/Section.astro'
import Button from '../ui/Button.astro'
import { client, urlFor } from '../../lib/sanity'

const PAGE_SIZE = 5

type EventTag = 'future' | 'past'

type EventItem = {
  date: string
  tag: EventTag
  image: string
  alt: string
  title: string
  location: string
  eventDate: string
  time: string
  href: string
}

function formatDate(iso: string) {
  const d = new Date(iso)
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
}

const FALLBACK_IMAGE = '/images/placeholder.webp'

const raw = await client.fetch(`
  *[_type == "event"] | order(date desc) {
    title, slug, tag, date, location, time, heroImage
  }
`)

const events: EventItem[] = raw.map((item: any) => ({
  title: item.title,
  tag: item.tag as EventTag,
  date: formatDate(item.date),
  eventDate: formatDate(item.date),
  location: item.location ?? '',
  time: item.time ?? '',
  image: item.heroImage ? urlFor(item.heroImage).width(600).url() : FALLBACK_IMAGE,
  alt: item.title,
  href: `/events/${item.slug.current}`,
}))

const hasMore = events.length > PAGE_SIZE
---

<Section class="bg-bg-primary pt-[208px] pb-[160px] max-md:pt-20 max-md:pb-20">

  <!-- Title row -->
  <div class="flex items-start justify-between mb-14 max-md:mb-10">
    <h1 class="text-h1 text-text-primary">Events</h1>
    <span class="text-h1 text-text-secondary">{events.length}</span>
  </div>

  <!-- Column labels — desktop only -->
  <div class="hidden lg:flex text-regular text-text-secondary mb-4 pr-6">
    <span class="shrink-0" style="width: calc(10rem + 1rem + 390px + 1rem)">Date</span>
    <span>Event</span>
  </div>

  <!-- Events list -->
  <div id="events-list" class="flex flex-col gap-12 max-md:gap-6">
    {events.map((event, i) => (
      <div
        class:list={[
          "event-item relative group border-t border-border-other-2 pt-12 px-6 flex gap-3 items-start",
          "max-lg:flex-col max-lg:pt-8 max-lg:px-0",
          "max-md:pt-6",
          i === events.length - 1 ? "pb-12 max-lg:pb-8 max-md:pb-6" : "",
          i >= PAGE_SIZE ? "hidden" : "",
        ]}
        data-index={i}
      >

        <!-- Date + tag -->
        <div class="flex flex-col items-start justify-center gap-4 shrink-0 w-[10rem] max-lg:flex-row max-lg:items-center max-lg:gap-2 max-lg:w-auto">
          <span class="text-regular text-text-primary">{event.date}</span>
          <span class:list={[
            "inline-flex items-center px-2 py-2 rounded-[4px] text-small text-text-primary leading-none whitespace-nowrap",
            event.tag === 'future' ? 'bg-fg-other-2' : 'bg-fg-other-1',
          ]}>
            {event.tag === 'future' ? 'Future event' : 'Past event'}
          </span>
        </div>

        <!-- Image + text -->
        <div class="flex flex-1 gap-4 items-start min-w-0 max-lg:flex-col max-lg:w-full">

          <a href={event.href} class="bg-bg-secondary rounded-[4px] overflow-hidden shrink-0 w-[390px] h-[216px] max-lg:w-full max-lg:h-auto max-lg:aspect-video block">
            <img
              src={event.image}
              alt={event.alt}
              class="w-full h-full object-cover transition-transform duration-700 ease-in-out lg:group-hover:scale-110"
              loading="lazy"
            />
          </a>

          <div class="flex flex-col justify-between self-stretch flex-1 min-w-0 max-lg:gap-4">
            <a href={event.href} class="text-h6 text-text-primary text-trim-off pr-[10rem] max-lg:pr-0 hover:text-text-tertiary transition-colors duration-200">{event.title}</a>

            <div class="flex gap-x-14 lg:group-hover:gap-x-8 transition-all duration-300 ease-in-out max-md:gap-x-5 max-md:flex-wrap">

              <div class="flex flex-col gap-2">
                <span class="text-small text-text-secondary max-md:hidden">Location</span>
                <div class="flex items-center gap-3 max-md:flex-col max-md:items-start max-md:gap-3">
                  <img src="/images/icons/location.svg" alt="" class="shrink-0 size-5 max-md:size-4" aria-hidden="true" />
                  <span class="text-regular max-md:text-small text-text-primary whitespace-nowrap">{event.location}</span>
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <span class="text-small text-text-secondary max-md:hidden">Date</span>
                <div class="flex items-center gap-3 max-md:flex-col max-md:items-start max-md:gap-3">
                  <img src="/images/icons/date.svg" alt="" class="shrink-0 size-5 max-md:size-4" aria-hidden="true" />
                  <span class="text-regular max-md:text-small text-text-primary whitespace-nowrap">{event.eventDate}</span>
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <span class="text-small text-text-secondary max-md:hidden">Time</span>
                <div class="flex items-center gap-3 max-md:flex-col max-md:items-start max-md:gap-3">
                  <img src="/images/icons/time.svg" alt="" class="shrink-0 size-5 max-md:size-4" aria-hidden="true" />
                  <span class="text-regular max-md:text-small text-text-primary whitespace-nowrap">{event.time}</span>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Details button -->
        <div class="hidden lg:block absolute top-12 right-6 z-[1] opacity-0 lg:group-hover:opacity-100 transition-opacity duration-500 ease-in-out">
          <Button label="Details" href={event.href} variant="black" />
        </div>
        <div class="relative z-[1] lg:hidden mt-2 max-md:mt-1">
          <Button label="Details" href={event.href} variant="black" />
        </div>

      </div>
    ))}
  </div>

  <!-- Load More -->
  {hasMore && (
    <button
      id="events-more-btn"
      class="w-full text-pagination text-text-primary text-center mt-12 cursor-pointer hover:text-text-secondary transition-colors duration-200"
      data-shown={PAGE_SIZE}
      data-page-size={PAGE_SIZE}
    >
      More ↓
    </button>
  )}

</Section>

<script>
  const btn = document.getElementById('events-more-btn') as HTMLButtonElement | null
  if (btn) {
    btn.addEventListener('click', () => {
      const shown = Number(btn.dataset.shown)
      const pageSize = Number(btn.dataset.pageSize)
      const next = shown + pageSize

      const items = document.querySelectorAll<HTMLElement>('.event-item')
      let newShown = 0
      items.forEach((item, i) => {
        if (i < next) {
          item.classList.remove('hidden')
          newShown = i + 1
        }
      })

      btn.dataset.shown = String(next)
      if (next >= items.length) btn.hidden = true
    })
  }
</script>
