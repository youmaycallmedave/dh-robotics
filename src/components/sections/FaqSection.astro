---
import Section from '../ui/Section.astro'
import { client } from '../../lib/sanity'

const raw = await client.fetch(`*[_type == "faqGroup"] | order(order asc) { title, items }`)
const groups: { title: string; items: { question: string; answer: string }[] }[] = raw
---

<Section class="bg-bg-primary" pt="page" pb="lg" size="xl">

  <h1 class="text-h1 text-text-primary mb-14 max-lg:mb-10">FAQ</h1>

  <div class="flex flex-col">
    {groups.map((group, gi) => (
      <div class:list={[
        "flex flex-col lg:flex-row lg:justify-between gap-2 lg:gap-4 items-start",
        gi < groups.length - 1 ? "lg:mb-[160px] max-lg:mb-[88px]" : ""
      ]}>

        <!-- Left: nav title — always visible, sticky on desktop -->
        <div class="shrink-0 w-full lg:w-[260px] lg:sticky lg:top-[100px] lg:self-start max-lg:mb-2 lg:mb-0">
          <p class="faq-nav-title text-large max-lg:text-h3 text-text-primary max-lg:text-text-secondary inline-block relative" data-nav={gi}>
            {group.title}
            <span class="faq-nav-line absolute bottom-[-2px] left-0 h-[1px] bg-text-primary w-full origin-left scale-x-0 transition-transform duration-1000 ease-[cubic-bezier(0.4,0,0.2,1)] max-lg:hidden"></span>
          </p>
        </div>

        <!-- Right: h2 desktop only + accordion -->
        <div class="w-full lg:flex-1 lg:min-w-0 lg:max-w-[55%]" data-group={gi}>
          <h2 class="text-h3 text-text-primary mb-[40px] hidden lg:block">{group.title}</h2>
          <div>
            {group.items.map((item) => (
              <div
                class="faq-item relative border-b border-border-other-2 cursor-pointer"
                data-open="false"
              >
                <div class="faq-header flex items-center justify-between px-4 py-6">
                  <p class="faq-question text-h6 text-text-primary text-trim-off flex-1 min-w-0 pr-4">{item.question}</p>
                  <span class="faq-icon relative shrink-0 size-6 text-text-primary">
                    <span class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 w-4 h-px bg-current rounded-full"></span>
                    <span class="faq-vline absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 w-4 h-px bg-current rounded-full rotate-90 transition-[rotate] duration-300 ease-in-out"></span>
                  </span>
                </div>
                <div class="faq-body grid transition-[grid-template-rows] duration-300 ease-in-out" style="grid-template-rows: 0fr">
                  <div class="overflow-hidden">
                    <p class="text-regular text-text-primary px-4 pb-6">{item.answer}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    ))}
  </div>

</Section>


<script>
  // Active section underline via scroll
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'))
  const navLines = Array.from(document.querySelectorAll<HTMLElement>('.faq-nav-line'))

  function updateActive() {
    const trigger = window.innerHeight * 0.15
    let activeIndex = 0

    groups.forEach((group, i) => {
      const top = group.getBoundingClientRect().top
      if (top <= trigger) activeIndex = i
    })

    navLines.forEach((line, i) => {
      if (i === activeIndex) {
        line.classList.remove('scale-x-0')
        line.classList.add('scale-x-100')
      } else {
        line.classList.remove('scale-x-100')
        line.classList.add('scale-x-0')
      }
    })
  }

  window.addEventListener('scroll', updateActive, { passive: true })
  updateActive()

  document.querySelectorAll('.faq-item').forEach(item => {
    const header = item.querySelector('.faq-header')
    const body = item.querySelector('.faq-body')
    const vline = item.querySelector<HTMLElement>('.faq-vline')

    if (!header) return

    header.addEventListener('click', () => {
      const isOpen = item.getAttribute('data-open') === 'true'
      const bodyEl = body as HTMLElement | null

      if (isOpen) {
        item.setAttribute('data-open', 'false')
        item.classList.remove('bg-fg-other-4')
        if (bodyEl) bodyEl.style.gridTemplateRows = '0fr'
        if (vline) vline.style.rotate = '90deg'
      } else {
        item.setAttribute('data-open', 'true')
        item.classList.add('bg-fg-other-4')
        if (bodyEl) bodyEl.style.gridTemplateRows = '1fr'
        if (vline) vline.style.rotate = '0deg'
      }
    })
  })
</script>
