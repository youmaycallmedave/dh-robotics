---
import Button from '../ui/Button.astro'

interface Industry {
  _id: string
  title: string
  description: string
  imageUrl: string
  href: string
}

interface Props {
  industries: Industry[]
  title?: string
  titleSize?: 'h2' | 'h3'
  description?: string
  viewMoreHref?: string
  initialSlide?: number
}

const {
  industries,
  title = 'Industries',
  titleSize = 'h2',
  description,
  viewMoreHref = '/applications/industry',
  initialSlide = 2,
} = Astro.props
---

<div class="pt-[120px] mb-20 max-lg:pt-20 max-lg:mb-10">
  {titleSize === 'h2'
    ? <h2 class="text-h2 mob-h3 text-text-primary mb-10">{title}</h2>
    : <h2 class="text-h3 mob-h4 text-text-primary mb-10">{title}</h2>
  }
  {description && (
    <p class="text-regular text-text-secondary max-w-[694px]">{description}</p>
  )}
</div>

<div class="relative" data-industries-wrap>
  <div class="swiper" data-industries-swiper data-initial={initialSlide}>
    <div class="swiper-wrapper">
      {industries.map((industry) => (
        <div class="swiper-slide slide-item w-[calc(100%-120px)] max-lg:w-[calc(100%-48px)] flex flex-col gap-8 max-lg:gap-6">
          <div class="slide-image-wrap relative w-full aspect-[795/538] rounded-[4px] overflow-hidden bg-bg-secondary">
            <img
              src={industry.imageUrl}
              alt={industry.title}
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute bottom-0 inset-x-0 h-[148px] bg-gradient-to-t from-[rgba(5,11,19,0.8)] to-transparent"></div>
          </div>
          <div class="slide-text flex items-start justify-between gap-10 max-lg:flex-col max-lg:gap-6">
            <div class="flex flex-col gap-6 max-w-[490px] max-lg:max-w-full">
              <h3 class="text-h5 mob-h6 text-text-primary">{industry.title}</h3>
              <p class="text-regular text-text-secondary">{industry.description}</p>
            </div>
            <Button label="Explore" href={industry.href} variant="black" class="shrink-0" />
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="flex items-center gap-10 mt-8 max-lg:gap-6">
    <div class="flex-1 h-px bg-border-other-2 relative">
      <div class="ind-progress absolute left-0 top-0 h-px bg-text-primary transition-all duration-500" style={`width: ${(1 / industries.length * 100).toFixed(0)}%`}></div>
    </div>
    <div class="flex gap-4 shrink-0">
      <button class="ind-prev size-8 border border-border-other-2 rounded-[4px] flex items-center justify-center text-text-secondary hover:text-text-primary hover:border-text-primary transition-colors" aria-label="Previous">
        <svg width="8" height="12" viewBox="0 0 8 12" fill="none" aria-hidden="true">
          <path d="M6 10L2 6L6 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="ind-next size-8 border border-border-other-2 rounded-[4px] flex items-center justify-center text-text-secondary hover:text-text-primary hover:border-text-primary transition-colors" aria-label="Next">
        <svg width="8" height="12" viewBox="0 0 8 12" fill="none" aria-hidden="true">
          <path d="M2 2L6 6L2 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <a href={viewMoreHref} class="shrink-0 inline-flex items-center gap-2 text-small-caps text-text-primary hover:opacity-70 transition-opacity">
      VIEW MORE
      <svg width="5" height="9" viewBox="0 0 5 9" fill="none" aria-hidden="true">
        <path d="M1 1L4 4.5L1 8" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</div>

<style>
  :global([data-industries-swiper]) { overflow: visible !important; }
  :global([data-industries-swiper] .swiper-slide) { display: flex; flex-direction: column; }

  :global(.slide-image-wrap) {
    clip-path: inset(0 0 20% 0);
    transition: clip-path 0.55s cubic-bezier(.21, 1, .34, 1);
  }
  :global(.swiper-slide-active .slide-image-wrap) {
    clip-path: inset(0 0 0% 0);
  }

  :global(.slide-item .slide-text) {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity   0.45s cubic-bezier(.21, 1, .34, 1) 0.15s,
      transform 0.45s cubic-bezier(.21, 1, .34, 1) 0.15s;
    pointer-events: none;
  }
  :global(.swiper-slide-active .slide-text) {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

<script>
  import Swiper from 'swiper'
  import 'swiper/css'

  document.querySelectorAll<HTMLElement>('[data-industries-wrap]').forEach((wrap) => {
    const swiperEl  = wrap.querySelector<HTMLElement>('[data-industries-swiper]')!
    const progress  = wrap.querySelector<HTMLElement>('.ind-progress')
    const prevBtn   = wrap.querySelector<HTMLButtonElement>('.ind-prev')
    const nextBtn   = wrap.querySelector<HTMLButtonElement>('.ind-next')
    const initialSlide = parseInt(swiperEl.dataset.initial ?? '2')

    const swiper = new Swiper(swiperEl, {
      centeredSlides: true,
      slidesPerView: 'auto',
      spaceBetween: 40,
      initialSlide,
      grabCursor: true,
      on: {
        init(s) {
          if (progress) progress.style.width = `${((s.activeIndex + 1) / s.slides.length) * 100}%`
        },
        activeIndexChange(s) {
          if (progress) progress.style.width = `${((s.activeIndex + 1) / s.slides.length) * 100}%`
        },
      },
    })

    prevBtn?.addEventListener('click', () => swiper.slidePrev())
    nextBtn?.addEventListener('click', () => swiper.slideNext())
  })
</script>
