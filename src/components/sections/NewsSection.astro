---
import FilterTabs from '../ui/FilterTabs.astro'

type NewsCategory = 'news' | 'insights'

export type NewsItem = {
  title: string
  date: string
  image: string
  alt: string
  category: NewsCategory
  href: string
  featured?: boolean
}

export type NewsPageInfo = {
  data: NewsItem[]
  currentPage: number
  lastPage: number
  url: { prev?: string; next?: string }
}

interface Props {
  featured?: NewsItem
  gridCards: NewsItem[]
  page: NewsPageInfo
}

const { featured, gridCards, page } = Astro.props

const tabs = [
  { id: 'all',      label: 'All' },
  { id: 'news',     label: 'News' },
  { id: 'insights', label: 'Insights' },
]
---

<section class="bg-bg-primary pt-[208px] pb-0 max-lg:pt-20">
  <div class="global-padding">
    <div class="mx-auto max-w-[1200px] flex flex-col gap-14 items-center">

      <!-- Title row + featured card -->
      <div class="flex flex-col gap-14 w-full max-w-[999px]">

        <div class="flex items-end justify-between gap-8 max-lg:flex-col max-lg:items-start max-lg:gap-4">
          <h1 class="text-h1 text-text-primary shrink-0">News</h1>
          <div class="flex items-center gap-8 max-lg:items-start">
            <p class="text-medium text-text-secondary max-w-[320px]">
              Browse most recent company news, press coverage, and media resources
            </p>
            <svg class="shrink-0 size-6 text-text-secondary max-lg:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3v15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M6 13l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

        {featured && (
          <a href={featured.href} class="group border border-border-other-2 flex overflow-hidden max-lg:flex-col relative">
            <div class="news-fill-bg"></div>
            <div class="relative shrink-0 w-[593px] h-[335px] max-lg:w-full max-lg:h-auto max-lg:aspect-video overflow-hidden bg-bg-secondary z-[1]">
              <img
                src={featured.image}
                alt={featured.alt}
                class="w-full h-full object-cover transition-transform duration-700 ease-in-out lg:group-hover:scale-110"
              />
              <span class="absolute top-10 left-10 bg-fg-alternative text-text-alternate text-small-caps px-2 py-2 max-lg:top-6 max-lg:left-6">
                {featured.category === 'news' ? 'News' : 'Insights'}
              </span>
            </div>
            <div class="relative flex flex-col justify-between flex-1 p-8 max-lg:p-6 gap-4 z-[1]">
              <p class="text-small text-text-primary">{featured.date}</p>
              <p class="text-h5 text-text-primary">{featured.title}</p>
            </div>
          </a>
        )}
      </div>

      <!-- Tabs + flat grid -->
      <div class="flex flex-col gap-[72px] w-full max-w-[999px] max-lg:gap-8" id="news-content">

        <FilterTabs id="news-tabs" tabs={tabs} fit />

        <div id="news-grid">
          {gridCards.map((item, i) => {
            const pos = (i % 5) + 1
            return (
              <a
                href={item.href}
                class:list={['news-card group border border-border-other-2 flex flex-col overflow-hidden relative', pos <= 2 ? 'is-large' : 'is-small']}
                data-category={item.category}
              >
                <div class="news-fill-bg"></div>
                <div class="card-text flex flex-col gap-4 flex-1 relative z-[1]">
                  <p class="card-date text-small text-text-primary">{item.date}</p>
                  <p class="card-title text-text-primary text-trim-off line-clamp-2">{item.title}</p>
                </div>
                <div class="card-image relative overflow-hidden bg-bg-secondary shrink-0">
                  <img
                    src={item.image}
                    alt={item.alt}
                    class="w-full h-full object-cover transition-transform duration-700 ease-in-out lg:group-hover:scale-110"
                    loading="lazy"
                  />
                  <span class="card-badge absolute bg-fg-alternative text-text-alternate text-small-caps px-2 py-2">
                    {item.category === 'news' ? 'News' : 'Insights'}
                  </span>
                </div>
              </a>
            )
          })}
        </div>

        <!-- Pagination prev / next -->
        <div class="flex items-center gap-8 lg:gap-16 justify-center">
          {page.url.prev
            ? <a href={page.url.prev} class="text-pagination text-text-primary hover:text-text-secondary transition-colors duration-200">← Prev</a>
            : <span class="text-pagination text-text-secondary opacity-40 cursor-not-allowed select-none">← Prev</span>
          }
          {page.url.next
            ? <a href={page.url.next} class="text-pagination text-text-primary hover:text-text-secondary transition-colors duration-200">Next →</a>
            : <span class="text-pagination text-text-secondary opacity-40 cursor-not-allowed select-none">Next →</span>
          }
        </div>

      </div>


    </div>
  </div>

  <!-- Subscribe -->
  <div class="pt-0" id="news-subscribe">
    <div class="global-padding">
      <div class="border-t border-border-other-2 py-20 max-lg:py-14 mt-[160px] max-lg:mt-[72px]">

    <div class="flex gap-4 items-center max-w-[795px] mx-auto max-lg:flex-col max-lg:items-start max-lg:gap-8" id="news-subscribe-form">
      <div class="flex flex-col gap-6 flex-1 min-w-0">
        <h4 class="text-h4 text-text-primary text-balance">Subscribe to News Alerts</h4>
        <p class="text-regular text-text-primary text-balance">
          Get email alerts when new press releases are published, and stay up to date on company news.
        </p>
      </div>
      <div class="flex flex-col gap-8 flex-1 min-w-0 w-full">
        <div class="flex flex-col gap-[2px]" id="news-email-field">
          <label for="news-email" class="text-small text-text-primary">E-mail</label>
          <div class="input-row border-b flex items-center gap-4 py-4">
            <input
              id="news-email"
              type="email"
              placeholder="Enter your e-mail..."
              class="flex-1 min-w-0 text-regular text-text-primary bg-transparent outline-none placeholder:text-text-secondary placeholder:opacity-50"
            />
          </div>
          <p class="error-msg text-tiny text-text-quaternary mt-2 hidden">Enter a valid email address</p>
        </div>
        <div class="flex items-start gap-4 max-md:flex-col">
          <p class="text-tiny text-text-primary flex-1 min-w-0">
            By subscribing you agree to our <a href="/privacy-policy" class="text-text-tertiary underline">Privacy Policy</a> and provide consent to receive updates from DH-Robotics.
          </p>
          <button
            id="news-subscribe-btn"
            type="button"
            class="self-start inline-flex items-center gap-6 pl-4 pr-2 rounded-[2px] min-h-[40px] text-small-caps text-trim-off transition-colors cursor-pointer bg-btn-black-default hover:bg-btn-black-hover text-text-alternate shrink-0"
          >
            <span>Subscribe</span>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="hidden flex-col gap-6 max-w-[795px] mx-auto" id="news-subscribe-success">
      <h4 class="text-h4 text-text-primary">You're subscribed!</h4>
      <p class="text-regular text-text-secondary">
        Thank you — you'll receive the latest DH-Robotics news and insights directly to your inbox.
      </p>
    </div>

      </div>
    </div>
  </div>

</section>

<style>
  .news-fill-bg {
    position: absolute;
    inset: 0;
    background-color: var(--color-bg-other);
    opacity: 0.5;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.8s ease;
    z-index: 0;
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .group:hover .news-fill-bg {
      transform: scaleY(1);
    }
  }

  #news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    #news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 1023px) {
    #news-grid .news-card.is-large,
    #news-grid .news-card.is-small {
      grid-column: span 1;
    }
  }

  #news-grid .card-image {
    height: auto;
    aspect-ratio: 16 / 9;
  }

  #news-grid .card-text {
    padding: 1.25rem;
    gap: 0.75rem;
  }

  #news-grid .card-badge {
    top: 1rem;
    left: 1rem;
  }

  #news-grid .card-title {
    font-family: var(--font-secondary);
    font-size: 1.125rem;
    line-height: 1.333em;
    letter-spacing: -0.0225rem;
    font-weight: 600;
    min-height: auto;
  }

  #news-grid .card-date {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  @media (min-width: 1024px) {
    #news-grid {
      grid-template-columns: repeat(6, 1fr);
      column-gap: 1rem;
      row-gap: 4.5rem;
    }

    #news-grid .news-card.is-large { grid-column: span 3; }
    #news-grid .news-card.is-small { grid-column: span 2; }

    #news-grid .news-card.is-large .card-image { height: 282px; aspect-ratio: unset; }
    #news-grid .news-card.is-small .card-image { height: 188px; aspect-ratio: unset; }

    #news-grid .news-card.is-large .card-text { padding: 2rem; }
    #news-grid .news-card.is-small .card-text { padding: 1.5rem; }

    #news-grid .news-card.is-large .card-badge { top: 2rem; left: 2rem; }
    #news-grid .news-card.is-small .card-badge { top: 1.5rem; left: 1.5rem; }

    #news-grid .news-card.is-large .card-title {
      font-family: var(--font-primary);
      font-size: 1.5rem;
      line-height: 1.167em;
      letter-spacing: -0.03125rem;
      font-weight: 500;
      min-height: 3.5rem;
    }

    #news-grid .news-card.is-small .card-title {
      font-family: var(--font-secondary);
      font-size: 1.125rem;
      line-height: 1.333em;
      letter-spacing: -0.0225rem;
      font-weight: 500;
      min-height: 3rem;
    }
  }
</style>

<script>
  const urlCategory = new URLSearchParams(window.location.search).get('category')
  if (urlCategory) {
    const tabBtn = document.querySelector<HTMLButtonElement>(`#news-tabs [data-tab="${urlCategory}"]`)
    tabBtn?.click()
  }

  function assignSizes() {
    const all = Array.from(document.querySelectorAll<HTMLElement>('#news-grid .news-card'))
    const visible = all.filter(c => c.style.display !== 'none')
    visible.forEach((card, i) => {
      const pos = (i % 5) + 1
      card.classList.toggle('is-large', pos <= 2)
      card.classList.toggle('is-small', pos > 2)
    })
  }

  assignSizes()

  document.addEventListener('tabchange', (e) => {
    if ((e.target as HTMLElement).id !== 'news-tabs') return
    const active = (e as CustomEvent<{ tab: string }>).detail.tab || 'all'
    document.querySelectorAll<HTMLElement>('#news-grid .news-card').forEach(card => {
      card.style.display = (active === 'all' || card.dataset.category === active) ? '' : 'none'
    })
    assignSizes()
  })

  const emailInput   = document.getElementById('news-email') as HTMLInputElement | null
  const emailField   = document.getElementById('news-email-field')
  const emailRow     = emailField?.querySelector<HTMLElement>('.input-row')
  const emailError   = emailField?.querySelector<HTMLElement>('.error-msg')
  const subscribeBtn = document.getElementById('news-subscribe-btn')
  const subscribeForm    = document.getElementById('news-subscribe-form')
  const subscribeSuccess = document.getElementById('news-subscribe-success')

  function isValidEmail(v: string) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)
  }

  subscribeBtn?.addEventListener('click', () => {
    const val = emailInput?.value.trim() ?? ''
    if (!isValidEmail(val)) {
      emailRow?.classList.add('is-error')
      emailError?.classList.remove('hidden')
      emailInput?.focus()
      return
    }
    subscribeForm?.classList.add('hidden')
    subscribeSuccess?.classList.remove('hidden')
  })

  emailInput?.addEventListener('input', () => {
    if (emailRow?.classList.contains('is-error') && isValidEmail(emailInput.value.trim())) {
      emailRow.classList.remove('is-error')
      emailError?.classList.add('hidden')
    }
  })
</script>
