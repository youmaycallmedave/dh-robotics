---
interface Crumb {
  label: string
  href?: string
}

interface Props {
  crumbs: Crumb[]
  overlay?: boolean
}

const { crumbs, overlay = false } = Astro.props
---

<nav aria-label="Breadcrumb" class:list={[!overlay && 'border-b border-border-other-2']}>
  <div class="global-padding py-5">
    <div class="mx-auto max-w-[1200px] flex items-center gap-4">

      <a href="/" aria-label="Home" class="shrink-0 text-text-primary hover:text-text-tertiary transition-colors duration-150">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path d="M13.3363 6.85122L8.336 2.30527C8.24396 2.2216 8.12403 2.17523 7.99964 2.17524C7.87525 2.17524 7.75532 2.22161 7.66329 2.30529L2.66363 6.85122C2.61209 6.89808 2.57091 6.9552 2.54273 7.0189C2.51456 7.08261 2.5 7.1515 2.5 7.22116V13C2.5 13.1326 2.55268 13.2598 2.64645 13.3536C2.74021 13.4473 2.86739 13.5 3 13.5H13C13.1326 13.5 13.2598 13.4473 13.3536 13.3536C13.4473 13.2598 13.5 13.1326 13.5 13V7.22118C13.5 7.15151 13.4854 7.08262 13.4573 7.01891C13.4291 6.9552 13.3879 6.89808 13.3363 6.85122Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      {crumbs.map((crumb) => (
        <>
          <svg width="4" height="9" viewBox="0 0 4 9" fill="none" aria-hidden="true" class="shrink-0 text-text-secondary" xmlns="http://www.w3.org/2000/svg">
            <path d="M0.5 8.5L2.84253 6.116C3.26351 5.68733 3.5 5.10607 3.5 4.5C3.5 3.89393 3.26351 3.31267 2.84253 2.884L0.5 0.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>

          {crumb.href ? (
            <a
              href={crumb.href}
              class="text-tiny text-text-primary hover:text-text-tertiary transition-colors duration-150 shrink-0 whitespace-nowrap"
            >
              {crumb.label}
            </a>
          ) : (
            <span class="text-tiny text-text-secondary shrink-0 whitespace-nowrap" aria-current="page">
              {crumb.label}
            </span>
          )}
        </>
      ))}

    </div>
  </div>
</nav>
