---
interface Props {
  label: string
  href?: string
  variant?: 'black' | 'blue' | 'red' | 'white'
  class?: string
  type?: 'submit' | 'button' | 'reset'
}

const {
  label,
  href = '/',
  variant = 'black',
  class: className,
  type,
} = Astro.props

const variants = {
  black: 'bg-btn-black-default hover:bg-btn-black-hover text-text-alternate',
  blue:  'bg-btn-blue-default  hover:bg-btn-blue-hover  text-text-alternate',
  red:   'bg-btn-red-default   hover:bg-btn-red-hover   text-text-alternate',
  white: 'bg-btn-white-default hover:bg-btn-white-hover text-text-primary',
}

const baseClass = [
  'self-start inline-flex items-center gap-6 pl-4 pr-2 rounded-[2px] min-h-[40px]',
  'text-small-caps text-trim-off no-underline transition-colors cursor-pointer',
  'disabled:opacity-40 disabled:cursor-not-allowed',
  variants[variant],
  className,
]
---
{type ? (
  <button
    type={type}
    class:list={baseClass}
  >
    <span>{label}</span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
) : (
  <a
    href={href}
    class:list={baseClass}
  >
    <span>{label}</span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
)}
