---
interface Props {
  label: string
  href?: string
  variant?: 'black' | 'blue' | 'red' | 'white'
  class?: string
  type?: 'submit' | 'button' | 'reset'
}

const {
  label,
  href = '/',
  variant = 'black',
  class: className,
  type,
} = Astro.props

const variants = {
  black: 'bg-btn-black-default text-text-alternate btn-flop [--flop-bg:var(--color-btn-black-hover)]',
  blue:  'bg-btn-blue-default  text-text-alternate btn-flop [--flop-bg:var(--color-btn-blue-hover)]',
  red:   'bg-btn-red-default   text-text-alternate btn-flop [--flop-bg:var(--color-btn-red-hover)]',
  white: 'bg-btn-white-default text-text-primary   btn-flop [--flop-bg:var(--color-btn-white-hover)] btn-flop--light',
}

const baseClass = [
  'self-start inline-flex items-center gap-6 pl-4 pr-2 rounded-[2px] min-h-[40px]',
  'text-small-caps text-trim-off no-underline cursor-pointer relative overflow-hidden',
  'disabled:opacity-40 disabled:cursor-not-allowed',
  variants[variant],
  className,
]
---
{type ? (
  <button type={type} class:list={baseClass}>
    <span class="btn-label text-trim-off relative z-[1]">{label}</span>
    <svg class="relative z-[1] shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
) : (
  <a href={href} class:list={baseClass}>
    <span class="btn-label text-trim-off relative z-[1]">{label}</span>
    <svg class="relative z-[1] shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
)}

<style>
  /* Kill any global text-trim pseudo-elements that might bleed into buttons */
  a::before, a::after,
  button::before, button::after {
    display: none !important;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-flop::before {
      content: '';
      display: block !important;
      position: absolute;
      inset: 0;
      background-color: var(--flop-bg, var(--color-btn-black-hover));
      clip-path: inset(100% 0 0 0);
      transition: clip-path 0.45s cubic-bezier(.21, 1, .34, 1);
      z-index: 0;
    }

    .btn-flop:hover::before {
      clip-path: inset(0 0 0 0);
    }

    .btn-flop .btn-label {
      text-shadow: 0 -2em 0 white;
      transform: translateY(2em);
      transition:
        transform 0.45s cubic-bezier(.21, 1, .34, 1),
        text-shadow 0.15s cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    .btn-flop:hover .btn-label {
      transform: translateY(0);
      text-shadow: 0 -2em 0 white;
    }

    .btn-flop--light .btn-label {
      text-shadow: 0 -2em 0 var(--color-black-1000);
    }

    .btn-flop--light:hover .btn-label {
      text-shadow: 0 -2em 0 var(--color-black-1000);
    }
  }
</style>
