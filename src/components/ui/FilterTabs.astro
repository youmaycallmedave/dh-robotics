---
interface Tab {
  id: string
  label: string
}

interface Props {
  id: string
  tabs: Tab[]
  defaultTab?: string
}

const { id, tabs, defaultTab = tabs[0]?.id } = Astro.props
---

<div class="max-md:-mx-4 max-lg:-mx-10 lg:mx-0">
  <div
    id={id}
    data-filter-tabs
    class="flex gap-16 overflow-x-auto border-b border-border-other-2 relative z-[2] pb-[1px] max-md:px-4 max-lg:px-10 lg:px-0"
    style="scrollbar-width: none"
  >
    {tabs.map(tab => (
      <button
        class:list={[
          "text-small-medium text-trim-off whitespace-nowrap transition-colors duration-200 shrink-0 cursor-pointer pb-4 relative",
          tab.id === defaultTab
            ? 'text-text-primary after:absolute after:bottom-[-1px] after:left-0 after:w-full after:h-px after:bg-text-primary'
            : 'text-text-secondary hover:text-text-primary',
        ]}
        data-tab={tab.id}
      >
        {tab.label}
      </button>
    ))}
  </div>
</div>

<script>
  function initFilterTabs() {
    document.querySelectorAll<HTMLElement>('[data-filter-tabs]:not([data-ft-init])').forEach(list => {
      list.dataset.ftInit = '1'
      const buttons = list.querySelectorAll<HTMLButtonElement>('[data-tab]')

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => {
            b.classList.remove(
              'text-text-primary',
              'after:absolute', 'after:bottom-[-1px]', 'after:left-0',
              'after:w-full', 'after:h-px', 'after:bg-text-primary',
            )
            b.classList.add('text-text-secondary')
          })
          btn.classList.remove('text-text-secondary')
          btn.classList.add(
            'text-text-primary',
            'after:absolute', 'after:bottom-[-1px]', 'after:left-0',
            'after:w-full', 'after:h-px', 'after:bg-text-primary',
          )
          list.dispatchEvent(new CustomEvent('tabchange', {
            detail: { tab: btn.dataset.tab ?? '' },
            bubbles: true,
          }))
        })
      })
    })
  }

  initFilterTabs()
  document.addEventListener('astro:page-load', initFilterTabs)
</script>
