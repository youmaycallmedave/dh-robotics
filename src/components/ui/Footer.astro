---
---

<footer class="border-t border-border-other-2 bg-bg-primary">
  <div class="global-padding pt-[72px] pb-10 max-lg:pt-14 max-lg:pb-10">
    <div class="mx-auto max-w-[1200px] flex flex-col gap-14 max-lg:gap-0">

      <!-- TOP ROW: Logo+desc+subscription | Phone+Email | Up -->
      <div class="flex items-start justify-between gap-10 max-lg:flex-col max-lg:gap-0">

        <!-- Left: Logo row + desc + subscription -->
        <div class="flex flex-col gap-6 shrink-0 w-[422px] max-lg:w-full">
          <div class="flex items-start gap-6">
            <a href="/" aria-label="DH-Robotics" class="shrink-0">
              <img src="/logotype-dh-robotics.svg" alt="DH-Robotics" class="h-[63px] w-auto" />
            </a>
            <p class="text-tiny text-text-primary">
              DH-Robotics is a high-tech company which is dedicated on providing core components of precision and motion controls for industrial intelligent manufacturing scenarios.
            </p>
          </div>
          <!-- Subscription: desktop only -->
          <div class="flex gap-4 items-end max-lg:hidden">
            <div class="flex-1 flex flex-col gap-0.5">
              <p class="text-small text-text-primary mb-1">Get the latest news from DH-Robotics</p>
              <div class="flex items-center border-b border-border-other-2 py-4">
                <input
                  type="email"
                  placeholder="Enter your e-mail..."
                  class="flex-1 bg-transparent text-regular text-text-primary placeholder:text-text-secondary outline-none"
                />
              </div>
            </div>
            <button class="bg-btn-black-default p-2 rounded-[2px] flex items-center justify-center shrink-0 size-10" aria-label="Subscribe">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Center: Phone + Email (desktop only) -->
        <div class="flex flex-col gap-6 max-lg:hidden">
          <div class="flex flex-col gap-5">
            <p class="text-tiny text-text-secondary">Phone</p>
            <a href="tel:+8618814357627" class="footer-link footer-link-large text-h3 text-text-primary whitespace-nowrap"><span>+86 18814357627</span></a>
          </div>
          <div class="flex flex-col gap-5">
            <p class="text-tiny text-text-secondary">E-mail</p>
            <a href="mailto:info@dh-robotics.com" class="footer-link footer-link-large text-h3 text-text-primary whitespace-nowrap"><span>info@dh-robotics.com</span></a>
          </div>
        </div>

        <!-- Right: Up (desktop only) -->
        <div class="flex flex-col gap-3 max-lg:hidden">
          <p class="text-tiny text-text-secondary">Up</p>
          <button id="scroll-to-top" class="border border-border-other-2 rounded-[8px] p-3 flex items-center justify-center hover:border-border-alternative transition-colors duration-200 cursor-pointer" aria-label="Scroll to top">
            <svg class="size-6 text-text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
          </button>
        </div>

        <!-- Mobile: subscription + phone + email + up -->
        <div class="lg:hidden w-full mt-10 flex flex-col gap-10">
          <div class="flex gap-4 items-end">
            <div class="flex-1 flex flex-col gap-0.5">
              <p class="text-small text-text-primary mb-1">Get the latest news from DH-Robotics</p>
              <div class="flex items-center border-b border-border-other-2 py-4">
                <input type="email" placeholder="Enter your e-mail..." class="flex-1 bg-transparent text-regular text-text-primary placeholder:text-text-secondary outline-none" />
              </div>
            </div>
            <button class="bg-btn-black-default p-2 rounded-[2px] flex items-center justify-center shrink-0 size-10" aria-label="Subscribe">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          <div class="flex flex-col gap-4">
            <p class="text-tiny text-text-secondary">Phone</p>
            <a href="tel:+8618814357627" class="footer-link footer-link-large text-h5 text-text-primary whitespace-nowrap"><span>+86 18814357627</span></a>
          </div>
          <div class="flex flex-col gap-4">
            <p class="text-tiny text-text-secondary">E-mail</p>
            <a href="mailto:info@dh-robotics.com" class="footer-link footer-link-large text-h5 text-text-primary whitespace-nowrap"><span>info@dh-robotics.com</span></a>
          </div>
          <div class="flex flex-col gap-3">
            <p class="text-tiny text-text-secondary">Up</p>
            <button id="scroll-to-top-mobile" class="border border-border-other-2 rounded-[8px] p-3 w-fit flex items-center justify-center hover:border-border-alternative transition-colors duration-200 cursor-pointer" aria-label="Scroll to top">
              <svg class="size-6 text-text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
            </button>
          </div>
        </div>

      </div>

      <!-- NAV SECTION -->
      <nav class="border-t border-border-other-2 pt-14 flex items-start gap-8
                  max-lg:flex-wrap max-lg:gap-4 max-lg:pt-14 max-lg:mt-10">

        <!-- Products col 1 -->
        <div class="flex flex-col gap-2 max-lg:w-[calc(50%-8px)]">
          <p class="text-tiny text-text-secondary">Products</p>
          <div class="flex flex-col">
            <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>All products</span></a>
            <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Electric Grippers</span></a>
            <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Rotary Electric Grippers</span></a>
            <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Servo Drive</span></a>
            <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Linear Coil Actuator</span></a>
            <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Servo Electric Cylinder</span></a>
          </div>
        </div>

        <!-- Products col 2 (no label, offset to align with links) -->
        <div class="flex flex-col max-lg:w-[calc(50%-8px)]">
          <div class="h-[24px] max-lg:h-0 shrink-0"></div>
          <div class="flex flex-col">
            <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Servo Electric Cylinder</span></a>
            <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Dexterous Hand</span></a>
            <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>iFM intelligent Flexible Motion System</span></a>
            <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Hexapods</span></a>
          </div>
        </div>

        <!-- Applications -->
        <div class="flex flex-col gap-2 max-lg:w-[calc(50%-8px)]">
          <p class="text-tiny text-text-secondary">Applications</p>
          <div class="flex flex-col">
            <a href="/applications" class="footer-link text-small-medium text-text-primary py-2 block"><span>All Applications</span></a>
            <a href="/applications" class="footer-link text-small-medium text-text-primary py-2 block"><span>Industry</span></a>
            <a href="/applications/action" class="footer-link text-small-medium text-text-primary py-2 block"><span>Processes</span></a>
          </div>
        </div>

        <!-- Service -->
        <div class="flex flex-col gap-2 max-lg:w-[calc(50%-8px)]">
          <p class="text-tiny text-text-secondary">Service</p>
          <div class="flex flex-col">
            <a href="/services" class="footer-link text-small-medium text-text-primary py-2 block"><span>All Services</span></a>
            <a href="/services/technology" class="footer-link text-small-medium text-text-primary py-2 block"><span>Technology</span></a>
            <a href="/services/software" class="footer-link text-small-medium text-text-primary py-2 block"><span>User Control Software</span></a>
          </div>
        </div>

        <!-- Resources -->
        <div class="flex flex-col gap-2 max-lg:w-[calc(50%-8px)]">
          <p class="text-tiny text-text-secondary">Resources</p>
          <div class="flex flex-col">
            <a href="/news" class="footer-link text-small-medium text-text-primary py-2 block"><span>News</span></a>
            <a href="/events" class="footer-link text-small-medium text-text-primary py-2 block"><span>Events</span></a>
            <a href="/resources/faq" class="footer-link text-small-medium text-text-primary py-2 block"><span>FAQ</span></a>
            <a href="/cases" class="footer-link text-small-medium text-text-primary py-2 block"><span>Case</span></a>
            <a href="/resources/downloads" class="footer-link text-small-medium text-text-primary py-2 block"><span>Download Center</span></a>
          </div>
        </div>

        <!-- Company + Get in Touch -->
        <div class="flex flex-col gap-6 max-lg:w-[calc(50%-8px)]">
          <div class="flex flex-col gap-2">
            <p class="text-tiny text-text-secondary">Company</p>
            <a href="/about" class="footer-link text-small-medium text-text-primary py-2 block"><span>About us</span></a>
          </div>
          <div class="flex flex-col gap-2">
            <p class="text-tiny text-text-secondary">Get in Touch</p>
            <a href="/contact" class="footer-link text-small-medium text-text-primary py-2 block"><span>Contact us</span></a>
          </div>
        </div>

        <!-- Social media -->
        <div class="flex flex-col gap-2 max-lg:w-[calc(50%-8px)]">
          <p class="text-tiny text-text-secondary">Social media</p>
          <div class="flex flex-col">
            <a href="https://www.linkedin.com/company/dh-robotics" target="_blank" rel="noopener noreferrer" class="footer-link text-small-medium text-text-primary py-2 block"><span>Linkedin</span></a>
            <a href="https://www.youtube.com/@dh-robotics" target="_blank" rel="noopener noreferrer" class="footer-link text-small-medium text-text-primary py-2 block"><span>Youtube</span></a>
            <a href="https://www.facebook.com/dhrobotics" target="_blank" rel="noopener noreferrer" class="footer-link text-small-medium text-text-primary py-2 block"><span>Facebook</span></a>
          </div>
        </div>

      </nav>

      <!-- BOTTOM -->
      <div class="border-t border-border-other-2 pt-14 flex items-center justify-between gap-4
                  max-lg:flex-col max-lg:items-center max-lg:gap-6 max-lg:pt-8 max-lg:mt-10">
        <p class="text-tiny text-text-primary whitespace-nowrap max-lg:text-center">© 2017-2026 DH-Robotics Technology Co., Ltd. all rights reserved.</p>
        <div class="flex items-center gap-6 flex-wrap max-lg:justify-center">
          <a href="/privacy-policy" class="footer-link text-tiny text-text-primary whitespace-nowrap"><span>Privacy Policy</span></a>
          <span class="text-tiny text-text-primary">Terms of Service</span>
          <a href="/sitemap" class="footer-link text-tiny text-text-primary whitespace-nowrap"><span>Sitemap</span></a>
        </div>
        <p class="text-tiny text-text-primary whitespace-nowrap max-lg:text-center">created by <a href="https://celerart.com/" target="_blank" rel="noopener noreferrer" class="footer-link"><span>celerart</span></a></p>
      </div>

    </div>
  </div>
</footer>

<style>
  .footer-link {
    text-decoration: none;
  }
  .footer-link span {
    position: relative;
  }
  .footer-link span::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .footer-link:hover span::after {
    transform: scaleX(1);
  }
  .footer-link-large span::after {
    height: 2px;
  }
</style>

<script>
  document.getElementById('scroll-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' })
  })
  document.getElementById('scroll-to-top-mobile')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' })
  })
</script>
