---
---

<footer class="border-t border-border-other-2 bg-bg-primary">
  <div class="global-padding pt-20 pb-10 max-lg:pt-14 max-lg:pb-10">
    <div class="mx-auto max-w-[1200px] flex flex-col gap-20 max-lg:gap-8">

      <!-- Top: logo + nav -->
      <div class="flex items-start justify-between gap-10 max-lg:flex-col max-lg:gap-10">

        <!-- Logo + description: row on mobile -->
        <div class="flex flex-col gap-6 shrink-0 max-w-[244px] max-lg:flex-row max-lg:items-start max-lg:gap-6 max-lg:max-w-full">
          <a href="/" aria-label="DH-Robotics" class="shrink-0">
            <img src="/logotype-dh-robotics.svg" alt="DH-Robotics" class="h-[63px] w-auto" />
          </a>
          <p class="text-tiny text-text-primary">
            DH-Robotics is a high-tech company which is dedicated on providing core components of precision and motion controls for industrial intelligent manufacturing scenarios.
          </p>
        </div>

        <!-- Nav -->
        <nav class="flex items-start gap-8 max-lg:flex-wrap max-lg:gap-x-0 max-lg:gap-y-4 max-lg:w-full">

          <!-- Products -->
          <div class="flex flex-col gap-4 max-lg:w-full">
            <a href="/products" class="footer-link text-small-medium text-text-primary"><span>Products</span></a>
            <div class="flex gap-8 max-lg:gap-4">
              <div class="flex flex-col gap-1">
                <p class="text-tiny text-text-secondary mb-1">Automation</p>
                <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Electric Grippers</span></a>
                <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Rotary Electric Grippers</span></a>
                <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Servo Drive</span></a>
                <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Linear Coil Actuator</span></a>
                <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Servo Electric Cylinder</span></a>
              </div>
              <div class="flex flex-col gap-1">
                <p class="text-tiny text-text-secondary mb-1">Robotics</p>
                <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Dexterous Hand</span></a>
                <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>iFM Intelligent Flexible Motion System</span></a>
                <a href="/products" class="footer-link text-small-medium text-text-primary py-2 block"><span>Hexapods</span></a>
              </div>
            </div>
          </div>

          <!-- Applications + Service -->
          <div class="flex gap-8 max-lg:w-full max-lg:gap-0 max-lg:justify-between">
            <div class="flex flex-col gap-2 max-lg:w-[calc(50%-8px)]">
              <a href="/applications" class="footer-link text-small-medium text-text-primary mb-2 block"><span>Applications</span></a>
              <a href="/applications/industry/template" class="footer-link text-small-medium text-text-primary py-2 block"><span>Industry</span></a>
              <a href="/applications/processes/template" class="footer-link text-small-medium text-text-primary py-2 block"><span>Processes</span></a>
              <a href="/cases" class="footer-link text-small-medium text-text-primary py-2 block"><span>Case</span></a>
            </div>
            <div class="flex flex-col gap-2 max-lg:w-[calc(50%-8px)]">
              <a href="/services" class="footer-link text-small-medium text-text-primary mb-2 block"><span>Service</span></a>
              <a href="/services/technology" class="footer-link text-small-medium text-text-primary py-2 block"><span>Technology</span></a>
              <a href="/services/software" class="footer-link text-small-medium text-text-primary py-2 block"><span>User Control Software</span></a>
              <a href="/resources/downloads" class="footer-link text-small-medium text-text-primary py-2 block"><span>Download Center</span></a>
            </div>
          </div>

          <!-- Resources + About -->
          <div class="flex gap-8 max-lg:w-full max-lg:gap-0 max-lg:justify-between">
            <div class="flex flex-col gap-2 max-lg:w-[calc(50%-8px)]">
              <span class="text-small-medium text-text-primary mb-2 block">Resources</span>
              <a href="/news" class="footer-link text-small-medium text-text-primary py-2 block"><span>News</span></a>
              <a href="/news?category=insights" class="footer-link text-small-medium text-text-primary py-2 block"><span>Insights</span></a>
              <a href="/events" class="footer-link text-small-medium text-text-primary py-2 block"><span>Events</span></a>
              <a href="/resources/faq" class="footer-link text-small-medium text-text-primary py-2 block"><span>FAQ</span></a>
            </div>
            <div class="flex flex-col gap-2 max-lg:w-[calc(50%-8px)]">
              <a href="/about" class="footer-link text-small-medium text-text-primary mb-2 block"><span>About</span></a>
            </div>
          </div>

          <!-- Contact us -->
          <div class="flex flex-col max-lg:w-full">
            <a href="/contact" class="footer-link text-small-medium text-text-primary block whitespace-nowrap"><span>Contact us</span></a>
          </div>

        </nav>
      </div>

      <!-- Middle -->
      <div class="border-t border-border-other-2 pt-14 flex items-end justify-between gap-8 max-lg:flex-col max-lg:items-start max-lg:gap-10 max-lg:pt-8">

        <div class="flex flex-col gap-6 max-lg:gap-4">
          <p class="text-tiny text-text-secondary">Phone</p>
          <a href="tel:+8618814357627" class="footer-link text-h3 mob-h5 text-text-primary whitespace-nowrap"><span>+86 18814357627</span></a>
        </div>

        <div class="flex flex-col gap-6 max-lg:gap-4">
          <p class="text-tiny text-text-secondary">E-mail</p>
          <a href="mailto:info@dh-robotics.com" class="footer-link text-h3 mob-h5 text-text-primary whitespace-nowrap"><span>info@dh-robotics.com</span></a>
        </div>

        <!-- Social + Up -->
        <div class="flex items-end gap-8 max-lg:w-full max-lg:justify-between">
          <div class="flex flex-col gap-3">
            <p class="text-tiny text-text-secondary">Social media</p>
            <div class="flex items-center gap-2">
              <a href="https://www.linkedin.com/company/dh-robotics" target="_blank" rel="noopener noreferrer" class="border border-border-other-2 rounded-[8px] p-3 flex items-center justify-center hover:border-border-alternative transition-colors duration-200" aria-label="LinkedIn">
                <svg class="size-6 text-text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
              <a href="https://www.youtube.com/@dh-robotics" target="_blank" rel="noopener noreferrer" class="border border-border-other-2 rounded-[8px] p-3 flex items-center justify-center hover:border-border-alternative transition-colors duration-200" aria-label="YouTube">
                <svg class="size-6 text-text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"/></svg>
              </a>
              <a href="https://www.facebook.com/dhrobotics" target="_blank" rel="noopener noreferrer" class="border border-border-other-2 rounded-[8px] p-3 flex items-center justify-center hover:border-border-alternative transition-colors duration-200" aria-label="Facebook">
                <svg class="size-6 text-text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
            </div>
          </div>
          <div class="flex flex-col gap-3">
            <p class="text-tiny text-text-secondary">Up</p>
            <button id="scroll-to-top" class="border border-border-other-2 rounded-[8px] p-3 flex items-center justify-center hover:border-border-alternative transition-colors duration-200 cursor-pointer" aria-label="Scroll to top">
              <svg class="size-6 text-text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
            </button>
          </div>
        </div>

      </div>

      <!-- Bottom -->
      <div class="border-t border-border-other-2 pt-8 flex items-center justify-between gap-4 max-lg:flex-col max-lg:items-center max-lg:gap-6">
        <p class="text-tiny text-text-primary whitespace-nowrap max-lg:text-center">© 2017-2026 DH-Robotics Technology Co., Ltd. all rights reserved.</p>
        <div class="flex items-center gap-6 flex-wrap max-lg:justify-center">
          <a href="/privacy-policy" class="footer-link text-tiny text-text-primary whitespace-nowrap"><span>Privacy Policy</span></a>
          <span class="text-tiny text-text-primary">Terms of Service</span>
          <a href="/sitemap" class="footer-link text-tiny text-text-primary whitespace-nowrap"><span>Sitemap</span></a>
        </div>
        <p class="text-tiny text-text-primary whitespace-nowrap max-lg:text-center">created by <a href="https://celerart.com/" target="_blank" rel="noopener noreferrer" class="footer-link"><span>celerart</span></a></p>
      </div>

    </div>
  </div>
</footer>

<style>
  .footer-link {
    text-decoration: none;
  }
  .footer-link span {
    position: relative;
  }
  .footer-link span::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .footer-link:hover span::after {
    transform: scaleX(1);
  }
</style>

<script>
  document.getElementById('scroll-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' })
  })
</script>
