      {megaMenus.map(menu => (
        <div class="mobile-section border-b border-border-other-2">
          <button class="mobile-section-btn flex items-center justify-between w-full text-text-primary py-5" aria-expanded="false">
            <span class="text-h6">{menu.label}</span>
            <svg class="mobile-chevron size-6 text-text-primary transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="mobile-section-content hidden pb-5">
            <div class="flex flex-col gap-4">
              {menu.items.map(item => (
                <a href={item.href} class="flex items-center gap-4">
                  <span class="size-12 shrink-0 rounded-tiny overflow-hidden bg-bg-secondary block">
                    <img src={item.img} alt="" class="w-full h-full object-cover" loading="lazy" />
                  </span>
                  <span class="text-medium text-text-primary">{item.title}</span>
