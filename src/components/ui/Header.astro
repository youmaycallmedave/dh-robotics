        href: '/products',
        cards: [
          { label: 'PGE Series',  desc: 'Industrial Slim-type Electric Parallel Gripper',        href: '/products', img: '/images/menu/gripper-pge.png' },
          { label: 'PGIE Series', desc: 'Industrial Electric Parallel Gripper',                  href: '/products', img: '/images/menu/gripper-pgie.png' },
          { label: 'AG Series',   desc: 'Linkage-type Adaptive Electric Gripper',                href: '/products', img: '/images/menu/gripper-ag.png' },
