    cards: [
      { label: 'Motorized Linear Stage',            href: '/products', img: '/images/menu/electric-grippers.png' },
      { label: 'Motorized Rotary Stage',            href: '/products', img: '/images/menu/servo-electric-cylinders.png' },
      { label: 'Motorized Goniometer Stage',        href: '/products', img: '/images/menu/voice-coil-actuators.png' },
      { label: 'Motorized Horizontal Lifting Stage', href: '/products', img: '/images/menu/servo-drives.png' },
