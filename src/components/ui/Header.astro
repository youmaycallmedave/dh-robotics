const languages = [
  { code: 'zh', label: 'Chinese',  flag: '🇨🇳' },
  { code: 'en', label: 'English',  flag: '🇺🇸', active: true },
  { code: 'ja', label: 'Japanese', flag: '🇯🇵' },
]
---

<!-- Scrim sits under the header but over the page while a mega panel is open -->
<div id="nav-scrim" class="nav-scrim fixed inset-0 z-40 hidden"></div>

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-bg-primary border-b border-border-other-2 transition-transform duration-300 ease-in-out">

  <!-- Промо-полоса (Figma 01.1 Menu). Закрытие запоминается в localStorage -->
  <div id="promo-bar" class="hidden border-b border-border-other-2 bg-bg-other">
    <div class="global-padding py-2">
      <div class="mx-auto max-w-[1200px] flex items-center justify-center gap-4">
        <p class="text-tiny text-text-primary text-center">
          From automotive lines to electronics assembly — see how world leaders deploy our solutions.
          <a href="/cases" class="underline underline-offset-2 hover:text-text-tertiary transition-colors duration-150">Explore Case Studies →</a>
        </p>
        <button
          id="promo-close"
          type="button"
          aria-label="Dismiss announcement"
          class="shrink-0 size-6 flex items-center justify-center rounded-tiny text-text-primary hover:bg-bg-secondary transition-colors duration-150 cursor-pointer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M18.75 5.25L5.25 18.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18.75 18.75L5.25 5.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="global-padding py-3">
    <div class="mx-auto max-w-[1200px] flex items-center justify-between gap-6">

      <div class="flex items-center gap-6 shrink-0">
        <a href="/" class="shrink-0 flex h-12 items-center" aria-label="DH-Robotics">
          <img src="/logotype-dh-robotics.svg" alt="DH-Robotics" class="h-[48.63px] w-[66px] max-lg:h-[41px] max-lg:w-auto" />
        </a>

        <!-- Разделитель логотип / язык (Figma: divider 16px) -->
        <span class="max-lg:hidden block h-4 w-px bg-border-other-2 shrink-0" aria-hidden="true"></span>

        <!-- Language (desktop) -->
        <div class="relative max-lg:hidden" data-lang-wrap>
          <button id="lang-btn" class="flex items-center gap-1 px-2 py-1 rounded-tiny text-small-medium text-text-primary hover:bg-bg-secondary transition-colors duration-150 uppercase" aria-expanded="false">
            EN
            <svg class="lang-chevron size-4 transition-transform duration-200" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div id="lang-panel" class="absolute top-full left-0 mt-2 w-[200px] bg-bg-primary border border-border-other-2 rounded-tiny shadow-[0_12px_40px_rgba(10,15,21,0.12)] p-2 hidden z-50">
            {languages.map(l => (
              <button class="w-full flex items-center gap-3 px-2 py-2 rounded-tiny hover:bg-bg-secondary transition-colors duration-150 text-left">
                <span class="text-large leading-none">{l.flag}</span>
                <span class="flex-1 text-regular text-text-primary">{l.label}</span>
                {l.active && (
                  <svg class="size-4 text-text-primary" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                )}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Desktop nav -->
      <nav class="flex items-center gap-2 max-lg:hidden">
        <div class="nav-wrap" data-menu="products">
          <button class="nav-btn flex items-center gap-1 px-2 py-1 rounded-tiny text-small-medium text-text-primary hover:bg-bg-secondary transition-colors duration-150 cursor-pointer whitespace-nowrap" aria-expanded="false">
            Products
            <svg class="nav-chevron size-4 transition-transform duration-200" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>

        {megaMenus.map(menu => (
          <div class="nav-wrap" data-menu={menu.id}>
            <button class="nav-btn flex items-center gap-1 px-2 py-1 rounded-tiny text-small-medium text-text-primary hover:bg-bg-secondary transition-colors duration-150 cursor-pointer whitespace-nowrap" aria-expanded="false">
              {menu.label}
              <svg class="nav-chevron size-4 transition-transform duration-200" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        ))}

        <a href="/about" class="flex items-center px-2 py-1 rounded-tiny text-small-medium text-text-primary hover:bg-bg-secondary transition-colors duration-150 whitespace-nowrap">About</a>
        <!-- DEV-only quick link -->
        <a href="/sitemap" class="flex items-center px-2 py-1 rounded-tiny text-small-medium text-text-primary hover:bg-bg-secondary transition-colors duration-150 whitespace-nowrap">Sitemap</a>
      </nav>

      <div class="flex items-center gap-4 shrink-0 max-lg:gap-3">
        <button id="search-btn" class="flex items-center gap-1 px-2 py-1 rounded-tiny text-text-primary hover:bg-bg-secondary transition-colors duration-150 cursor-pointer" aria-label="Search">
          <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true" class="size-4"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M13 13l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>

        <!-- Разделитель поиск / CTA (Figma: divider 16px) -->
        <span class="max-lg:hidden block h-4 w-px bg-border-other-2 shrink-0" aria-hidden="true"></span>

        <a href="/contact" class="contact-btn relative overflow-hidden inline-flex items-center justify-center gap-0 pl-3 pr-1 py-1 rounded-full bg-btn-black-default text-text-alternate text-small-caps text-trim-off whitespace-nowrap">
          <span class="contact-label relative z-[1]">CONTACT US</span>
          <svg class="size-6 text-text-alternate relative z-[1]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <button id="burger-btn" class="lg:hidden border border-border-other-2 rounded-tiny p-3 flex items-center justify-center hover:border-border-alternative transition-colors duration-200" aria-label="Menu" aria-expanded="false">
          <svg id="burger-icon" class="size-4 text-text-primary" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <svg id="close-icon" class="size-4 text-text-primary hidden" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Products panel — Figma 11862:82108 -->
  <div class="nav-panel absolute left-0 right-0 top-full hidden" data-panel="products">
    <div class="global-padding">
      <div class="mx-auto w-[800px] max-w-full bg-bg-primary rounded-medium-small shadow-[0_20px_50px_rgba(10,15,21,0.14)] flex gap-4 items-start pl-3 pr-5 py-5" id="products-menu">

        <!-- Левый рельс -->
        <div class="w-[179px] shrink-0 relative">
          <div class="flex flex-col gap-2 items-start border-l border-border-secondary pl-4">
            {productMenu.map((item, i) => (
              <>
                <button
                  type="button"
                  data-product-tab={item.key}
                  data-active={i === 0 ? 'true' : 'false'}
                  aria-expanded={item.children ? 'false' : undefined}
                  class="product-tab flex gap-4 items-center w-full text-left cursor-pointer"
                >
                  <span class="size-6 shrink-0 rounded-micro bg-black-150 overflow-clip flex items-center justify-center">
                    {item.logoIcon && (
                      <img src="/logotype-dh-robotics.svg" alt="" aria-hidden="true" class="w-[15px] h-auto" />
                    )}
                  </span>
                  <span class="product-tab-label flex-1 min-w-0 text-[13px] leading-[14px] tracking-[-0.26px] font-secondary font-medium text-trim-off">{item.label}</span>
                  {item.children && (
                    <svg width="8" height="4" viewBox="0 0 4.5 9.5" fill="none" aria-hidden="true" class="product-tab-caret shrink-0 w-2 h-1 rotate-90 transition-transform duration-200">
                      <path d="M0.75 8.75L3.09253 6.366C3.51351 5.93733 3.75 5.35607 3.75 4.75C3.75 4.14393 3.51351 3.56267 3.09253 3.134L0.75 0.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  )}
                </button>

                {item.children && (
                  <div data-product-sub={item.key} class="hidden flex-col gap-2 items-start w-full pl-10">
                    {item.children.map(child => (
                      <button
                        type="button"
                        data-product-tab={child.key}
                        data-active="false"
                        class="product-tab flex gap-4 items-center w-full text-left cursor-pointer"
                      >
                        <span class="product-tab-label flex-1 min-w-0 text-[13px] leading-[14px] tracking-[-0.26px] font-secondary font-medium text-trim-off">{child.label}</span>
                      </button>
                    ))}
                  </div>
                )}
              </>
            ))}
          </div>
          <!-- Индикатор активного пункта: 1×24 на линии рельса -->
          <span id="product-tab-indicator" class="absolute left-0 top-0 w-px h-6 bg-fg-alternative transition-transform duration-200 ease-out" aria-hidden="true"></span>
        </div>

        <!-- Правая часть: hero-карточка или сетка продуктов -->
        <div class="flex-1 min-w-0 relative">
          {productPanels.map((p, i) => (
            <div data-product-card={p.key} class:list={[i === 0 ? '' : 'hidden']}>

              {p.cards ? (
                <div class="flex flex-col gap-3">

                  <!-- Полоса над сеткой: название категории и ссылка «view more» -->
                  <div class="flex items-center justify-between h-4">
                    <p class="text-regular-medium text-text-primary whitespace-nowrap">{p.title}</p>
                    <a href={p.href} class="group/vm flex items-center gap-2 text-text-primary">
                      <span class="text-[12px] leading-4 uppercase text-trim-off">view more</span>
                      <svg width="4" height="8" viewBox="0 0 4.5 9.5" fill="none" aria-hidden="true" class="shrink-0 transition-transform duration-200 group-hover/vm:translate-x-0.5">
                        <path d="M0.75 8.75L3.09253 6.366C3.51351 5.93733 3.75 5.35607 3.75 4.75C3.75 4.14393 3.51351 3.56267 3.09253 3.134L0.75 0.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  </div>

                  <div class:list={['grid gap-2', gridClass(p.cards.length), p.cards.some(c => c.desc) ? '' : 'h-[295px]']}>
                  {p.cards.map((c, ci) => (
                    c.desc ? (
                      <!-- Карточка продукта: иконка 80x80, серия, описание -->
                      <a
                        href={c.href}
                        class="group/c flex flex-col gap-4 rounded-small bg-bg-other p-3 overflow-clip transition-colors duration-200 hover:bg-bg-secondary"
                      >
                        <span class="h-[79px] w-full relative overflow-clip shrink-0">
                          <img src={c.img} alt="" aria-hidden="true" class="absolute left-1/2 -translate-x-1/2 top-[-1px] size-20 object-cover" />
                        </span>
                        <span class="flex flex-col gap-2 w-full">
                          <span class="text-small-medium text-text-primary w-full">{c.label}</span>
                          <span class="text-tiny text-black-800 w-full">{c.desc}</span>
                        </span>
                      </a>
                    ) : (
                      <a
                        href={c.href}
                        class:list={[
                          'group/c relative block overflow-clip rounded-small bg-bg-other',
                          // при трёх карточках первая занимает оба ряда — бенто из макета
                          p.cards!.length === 3 && ci === 0 ? 'row-span-2' : '',
                        ]}
                      >
                        <img src={c.img} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" />
                        <span class="absolute left-4 top-4 text-tiny-medium text-text-primary">{c.label}</span>
                        <span class="absolute bottom-3 right-3 size-6 rounded-full bg-btn-black-default flex items-center justify-center transition-colors duration-200 group-hover/c:bg-btn-black-hover">
                          <svg width="24" height="24" viewBox="0 0 4.5 9.5" fill="none" aria-hidden="true" class="size-6 p-2 text-text-alternate">
                            <path d="M0.75 8.75L3.09253 6.366C3.51351 5.93733 3.75 5.35607 3.75 4.75C3.75 4.14393 3.51351 3.56267 3.09253 3.134L0.75 0.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      </a>
                    )
                  ))}
                  </div>
                </div>
              ) : (
                <div class="h-[365px] relative overflow-clip rounded-small bg-bg-secondary">
                  {p.img && (
                    <img src={p.img} alt="" aria-hidden="true" class="absolute left-[-10px] top-0 h-[365px] w-[600px] max-w-none object-cover" />
                  )}
                  <div class="absolute bottom-4 left-4 w-[212px] flex flex-col gap-4 items-start justify-center">
                    <div class="flex flex-col gap-4 items-start w-full">
                      <p class="text-large-medium text-text-primary w-full">{p.title}</p>
                      <p class="text-tiny text-text-secondary w-full">{p.desc}</p>
                    </div>
                    <a
                      href={p.href}
                      class="inline-flex items-center justify-center gap-6 pl-4 pr-2 py-1 rounded-full bg-btn-black-default text-text-alternate text-small-caps text-trim-off whitespace-nowrap transition-colors duration-200 hover:bg-btn-black-hover"
                    >
                      <span>explore</span>
                      <svg width="24" height="24" viewBox="0 0 4.5 9.5" fill="none" aria-hidden="true" class="size-6 p-1.5 shrink-0">
                        <path d="M0.75 8.75L3.09253 6.366C3.51351 5.93733 3.75 5.35607 3.75 4.75C3.75 4.14393 3.51351 3.56267 3.09253 3.134L0.75 0.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Mega panels — floating cards -->
  {megaMenus.map(menu => (
    <div class="nav-panel absolute left-0 right-0 top-full hidden" data-panel={menu.id}>
      <div class="global-padding">
        <div class="mx-auto w-[800px] max-w-full">
          <div class="bg-bg-primary rounded-medium-small shadow-[0_20px_50px_rgba(10,15,21,0.14)] flex gap-4 items-start p-4">

            <div class="flex-1 min-w-0 self-start flex flex-col gap-5 pl-4 border-l border-border-secondary">
              {menu.items.map((item, i) => (
                <button
                  class:list={['mega-item text-tiny-medium text-trim-off text-left whitespace-nowrap transition-colors duration-150 relative cursor-pointer', i === 0 ? 'is-active' : '']}
