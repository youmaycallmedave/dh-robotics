    href: '/products',
    // В макете у этих карточек переиспользованы рендеры Smart Actuators — своих ещё нет
    cards: [
      { label: 'Annular Line',                    href: '/products', img: '/images/menu/electric-grippers.png' },
      { label: 'Logistics Line',                  href: '/products', img: '/images/menu/servo-electric-cylinders.png' },
      { label: 'Docking Line',                    href: '/products', img: '/images/menu/voice-coil-actuators.png' },
      { label: 'Wireless Power Supply Solution',  href: '/products', img: '/images/menu/servo-drives.png' },
    ],
  },
  {
    key: 'hexapods',
    label: 'Hexapods',
    title: 'Hexapods',
    desc: 'Six-axis positioning systems for sub-micron alignment and precision manipulation.',
    href: '/products',
    cards: [
      { label: 'DHEX-100-50 Hexapod', href: '/products', img: '/images/menu/hexapod.png' },
    ],
  },
  {
    key: 'sensor',
