---
type NavColumn = { group?: string; links: { label: string; href: string }[] }
type MegaItem = { key: string; title: string; desc: string; img: string; href: string }
type Mega = { id: string; label: string; items: MegaItem[] }

// Products keeps the plain column dropdown until its mega-menu design is finalized
const productsColumns: NavColumn[] = [
  {
    group: 'Automation',
    links: [
      { label: 'Electric Grippers',        href: '/products' },
      { label: 'Rotary Electric Grippers', href: '/products' },
      { label: 'Servo Drive',              href: '/products' },
      { label: 'Linear Coil Actuator',     href: '/products' },
      { label: 'Servo Electric Cylinder',  href: '/products' },
    ],
  },
  {
    group: 'Robotics',
    links: [
      { label: 'Dexterous Hand',                         href: '/products' },
      { label: 'iFM Intelligent Flexible Motion System', href: '/products' },
      { label: 'Hexapods',                               href: '/products' },
    ],
  },
]

const megaMenus: Mega[] = [
  {
    id: 'applications',
    label: 'Applications',
    items: [
      { key: 'all',        title: 'Applications', desc: 'Explore how DH-Robotics powers automation across industries and tasks.', img: '/images/applications-hero.webp',       href: '/applications' },
      { key: 'industries', title: 'Industries',   desc: 'Medical, automotive, electronics, food & beverage and more.',            img: '/images/applications-medical.webp',    href: '/applications' },
      { key: 'tasks',      title: 'Tasks',        desc: 'Grabbing, clamping, transport, assembly and other core operations.',     img: '/images/service-technology-hero.webp', href: '/applications' },
    ],
  },
  {
    id: 'support',
    label: 'Support',
    items: [
      { key: 'support-hub', title: 'Support Hub',     desc: 'Guides, tutorials and answers from our engineering team.',  img: '/images/service-content-2.webp',       href: '/support' },
      { key: 'downloads',   title: 'Download Center', desc: 'Product datasheets, manuals, and technical documentation.', img: '/images/download hero.webp',           href: '/explore/downloads' },
      { key: 'software',    title: 'Software',        desc: 'DH-Robotics ServoStudio and other control software.',       img: '/images/service-content-1.webp',       href: '/support/software' },
      { key: 'faq',         title: 'FAQ',             desc: 'Quick answers to common questions about our products.',     img: '/images/service-technology-book.webp', href: '/explore/faq' },
      // HIDDEN (draft): Technology — restore when the page is ready
      // { key: 'technology', title: 'Technology', desc: 'The precision motion control tech behind our products.', img: '/images/service-technology-core.webp', href: '/support/technology' },
    ],
  },
  {
    id: 'explore',
    label: 'Explore',
    items: [
      { key: 'news',     title: 'News',     desc: 'Stay updated with the latest company announcements, product launches, and technological breakthroughs from DH-Robotics.', img: '/images/menu/news.jpg',              href: '/news' },
      { key: 'insights', title: 'Insights', desc: 'Deep dives on motion control, gripping and factory automation from our engineers.',                                       img: '/images/service-technology-core.webp', href: '/news?category=insights' },
      { key: 'events',   title: 'Events',   desc: 'Meet DH-Robotics at trade shows, conferences and industry events worldwide.',                                             img: '/images/service-software-hero.webp', href: '/events' },
      { key: 'cases',    title: 'Cases',    desc: 'See how world leaders deploy DH-Robotics solutions on the factory floor.',                                                img: '/images/dh56-hero-bg.jpg',           href: '/cases' },
    ],
  },
]

const languages = [
  { code: 'zh', label: 'Chinese',  flag: '🇨🇳' },
  { code: 'en', label: 'English',  flag: '🇺🇸', active: true },
  { code: 'ja', label: 'Japanese', flag: '🇯🇵' },
]
---

<!-- Scrim sits under the header but over the page while a mega panel is open -->
<div id="nav-scrim" class="nav-scrim fixed inset-0 z-40 hidden"></div>

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-bg-primary border-b border-border-other-2 transition-transform duration-300 ease-in-out">
  <div class="global-padding py-3">
    <div class="mx-auto max-w-[1200px] flex items-center justify-between gap-6">

      <div class="flex items-center gap-6 shrink-0">
        <a href="/" class="shrink-0" aria-label="DH-Robotics">
          <img src="/logotype-dh-robotics.svg" alt="DH-Robotics" class="h-14 w-auto max-lg:h-[41px]" />
        </a>

        <!-- Language (desktop) -->
        <div class="relative max-lg:hidden" data-lang-wrap>
          <button id="lang-btn" class="flex items-center gap-1 px-2 py-1 rounded-tiny text-small-medium text-text-primary hover:bg-bg-secondary transition-colors duration-150 uppercase" aria-expanded="false">
            EN
            <svg class="lang-chevron size-4 transition-transform duration-200" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div id="lang-panel" class="absolute top-full left-0 mt-2 w-[200px] bg-bg-primary border border-border-other-2 rounded-tiny shadow-[0_12px_40px_rgba(10,15,21,0.12)] p-2 hidden z-50">
            {languages.map(l => (
              <button class="w-full flex items-center gap-3 px-2 py-2 rounded-tiny hover:bg-bg-secondary transition-colors duration-150 text-left">
                <span class="text-large leading-none">{l.flag}</span>
                <span class="flex-1 text-regular text-text-primary">{l.label}</span>
                {l.active && (
                  <svg class="size-4 text-text-primary" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                )}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Desktop nav -->
      <nav class="flex items-center gap-1 max-lg:hidden">
        <div class="nav-wrap" data-menu="products">
          <button class="nav-btn flex items-center gap-1 px-2 py-1 rounded-tiny text-small-medium text-text-primary hover:bg-bg-secondary transition-colors duration-150 cursor-pointer whitespace-nowrap" aria-expanded="false">
            Products
            <svg class="nav-chevron size-4 transition-transform duration-200" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>

        {megaMenus.map(menu => (
          <div class="nav-wrap" data-menu={menu.id}>
            <button class="nav-btn flex items-center gap-1 px-2 py-1 rounded-tiny text-small-medium text-text-primary hover:bg-bg-secondary transition-colors duration-150 cursor-pointer whitespace-nowrap" aria-expanded="false">
              {menu.label}
              <svg class="nav-chevron size-4 transition-transform duration-200" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        ))}

        <a href="/about" class="flex items-center px-2 py-1 rounded-tiny text-small-medium text-text-primary hover:bg-bg-secondary transition-colors duration-150 whitespace-nowrap">About</a>
        <!-- DEV-only quick link -->
        <a href="/sitemap" class="flex items-center px-2 py-1 rounded-tiny text-small-medium text-text-primary hover:bg-bg-secondary transition-colors duration-150 whitespace-nowrap">Sitemap</a>
      </nav>

      <div class="flex items-center gap-4 shrink-0 max-lg:gap-3">
        <button id="search-btn" class="size-8 flex items-center justify-center text-text-primary hover:text-text-secondary transition-colors cursor-pointer" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M13 13l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>

        <a href="/contact" class="contact-btn relative overflow-hidden inline-flex items-center gap-6 pl-4 pr-2 py-2 rounded-full bg-btn-black-default text-text-alternate text-small-caps text-trim-off whitespace-nowrap max-lg:gap-2 max-lg:pl-3 max-lg:pr-1">
          <span class="contact-label relative z-[1]">CONTACT US</span>
          <svg class="size-6 text-text-alternate relative z-[1]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <button id="burger-btn" class="lg:hidden border border-border-other-2 rounded-tiny p-3 flex items-center justify-center hover:border-border-alternative transition-colors duration-200" aria-label="Menu" aria-expanded="false">
          <svg id="burger-icon" class="size-4 text-text-primary" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <svg id="close-icon" class="size-4 text-text-primary hidden" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Products panel — plain columns -->
  <div class="nav-panel absolute left-0 right-0 top-full hidden" data-panel="products">
    <div class="global-padding">
      <div class="mx-auto max-w-[1200px]">
        <div class="w-[800px] max-w-full bg-bg-primary rounded-[6px] shadow-[0_20px_50px_rgba(10,15,21,0.14)] border border-border-other-2 flex gap-16 p-8">
          {productsColumns.map(col => (
            <div class="flex flex-col gap-2 min-w-[160px]">
              {col.group && <p class="text-tiny text-text-secondary mb-2">{col.group}</p>}
              {col.links.map(link => (
                <a href={link.href} class="text-small-medium text-text-primary hover:text-text-tertiary transition-colors duration-150 py-1 block">{link.label}</a>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Mega panels — floating cards -->
  {megaMenus.map(menu => (
    <div class="nav-panel absolute left-0 right-0 top-full hidden" data-panel={menu.id}>
      <div class="global-padding">
        <div class="mx-auto max-w-[1200px]">
          <div class="w-[800px] max-w-full bg-bg-primary rounded-[6px] shadow-[0_20px_50px_rgba(10,15,21,0.14)] border border-border-other-2 flex gap-4 p-4">

            <div class="flex-1 min-w-0 self-start flex flex-col gap-5 pl-4 border-l border-border-secondary">
              {menu.items.map((item, i) => (
                <button
                  class:list={['mega-item text-tiny-medium text-trim-off text-left whitespace-nowrap transition-colors duration-150 relative cursor-pointer', i === 0 ? 'is-active' : '']}
                  data-item={item.key}
                >{item.title}</button>
              ))}
            </div>

            <div class="shrink-0 w-[600px] max-w-full h-[365px] relative overflow-hidden rounded-tiny bg-bg-secondary">
              {menu.items.map((item, i) => (
                <a
                  href={item.href}
                  class:list={['mega-preview absolute inset-0 block transition-opacity duration-200', i === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none']}
                  data-preview={item.key}
                >
                  <img src={item.img} alt={item.title} class="absolute inset-0 w-full h-full object-cover" />
                  <div class="mega-glow absolute inset-0"></div>
                  <div class="absolute bottom-4 left-4 w-[240px] flex flex-col gap-4">
                    <div class="flex flex-col gap-4">
                      <p class="text-h5 text-text-primary">{item.title}</p>
                      <p class="text-tiny-medium text-text-primary">{item.desc}</p>
                    </div>
                    <span class="mega-btn self-start inline-flex items-center gap-2 pl-4 pr-2 py-1 rounded-full bg-btn-black-default text-text-alternate text-small-caps text-trim-off relative overflow-hidden">
                      <span class="mega-btn-label relative z-[1]">Explore</span><svg class="mega-btn-arrow size-6 relative z-[1] shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </div>
                </a>
              ))}
            </div>

          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-border-other-2 bg-bg-primary h-[calc(100dvh-65px)] overflow-y-auto">
    <div class="global-padding flex flex-col">

      <div class="mobile-section border-b border-border-other-2">
        <button class="mobile-section-btn flex items-center justify-between w-full text-text-primary py-5" aria-expanded="false">
          <span class="text-h6">Products</span>
          <svg class="mobile-chevron size-6 text-text-primary transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="mobile-section-content hidden pb-5">
          {productsColumns.map(col => (
            <div>
              {col.group && <p class="text-tiny text-text-secondary mb-3 mt-1">{col.group}</p>}
              {col.links.map(link => (
                <a href={link.href} class="text-medium text-text-primary py-2 block">{link.label}</a>
              ))}
            </div>
          ))}
        </div>
      </div>

      {megaMenus.map(menu => (
        <div class="mobile-section border-b border-border-other-2">
          <button class="mobile-section-btn flex items-center justify-between w-full text-text-primary py-5" aria-expanded="false">
            <span class="text-h6">{menu.label}</span>
            <svg class="mobile-chevron size-6 text-text-primary transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="mobile-section-content hidden pb-5">
            <div class="flex flex-col gap-4">
              {menu.items.map(item => (
                <a href={item.href} class="flex items-center gap-4">
                  <span class="size-12 shrink-0 rounded-tiny overflow-hidden bg-bg-secondary block">
                    <img src={item.img} alt="" class="w-full h-full object-cover" loading="lazy" />
                  </span>
                  <span class="text-medium text-text-primary">{item.title}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}

      <a href="/about" class="text-trim-off text-h6 text-text-primary py-5 block border-b border-border-other-2">About</a>
      <a href="/sitemap" class="text-trim-off text-h6 text-text-primary py-5 block border-b border-border-other-2">Sitemap</a>

      <div class="mobile-section border-b border-border-other-2">
        <button class="mobile-section-btn flex items-center justify-between w-full text-text-primary py-5" aria-expanded="false">
          <span class="text-h6 uppercase">EN</span>
          <svg class="mobile-chevron size-6 text-text-primary transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="mobile-section-content hidden pb-5">
          <div class="flex flex-col gap-1">
            {languages.map(l => (
              <button class="flex items-center gap-3 py-2 text-left w-full">
                <span class="text-large leading-none">{l.flag}</span>
                <span class="flex-1 text-medium text-text-primary">{l.label}</span>
                {l.active && <svg class="size-4 text-text-primary" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Contacts block -->
      <div class="pt-8 pb-10 flex flex-col gap-6">
        <div class="flex flex-col gap-1">
          <p class="text-tiny text-text-secondary">Phone</p>
          <a href="tel:+8618814357627" class="text-h5 text-text-primary">+86 18814357627</a>
        </div>
        <div class="flex flex-col gap-1">
          <p class="text-tiny text-text-secondary">E-mail</p>
          <a href="mailto:info@dh-robotics.com" class="text-h5 text-text-primary">info@dh-robotics.com</a>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-tiny text-text-secondary">Social media</p>
          <div class="flex items-center gap-2">
            <a href="https://www.linkedin.com/company/dh-robotics" target="_blank" rel="noopener noreferrer" class="border border-border-other-2 rounded-[8px] p-3 flex items-center justify-center hover:border-border-alternative transition-colors duration-200" aria-label="LinkedIn">
              <svg class="size-6 text-text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://www.youtube.com/@dh-robotics" target="_blank" rel="noopener noreferrer" class="border border-border-other-2 rounded-[8px] p-3 flex items-center justify-center hover:border-border-alternative transition-colors duration-200" aria-label="YouTube">
              <svg class="size-6 text-text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"/></svg>
            </a>
            <a href="https://www.facebook.com/dhrobotics" target="_blank" rel="noopener noreferrer" class="border border-border-other-2 rounded-[8px] p-3 flex items-center justify-center hover:border-border-alternative transition-colors duration-200" aria-label="Facebook">
              <svg class="size-6 text-text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>

</header>

<!-- Spacer so content doesn't go under fixed header -->
<div class="h-[80px] max-lg:h-[65px]"></div>

<!-- Search overlay -->
<div id="search-overlay" class="fixed inset-0 z-[200] bg-bg-primary flex-col hidden">

  <div class="global-padding border-b border-border-other-2">
    <div class="mx-auto max-w-[1200px] h-[80px] max-lg:h-[65px] flex items-center gap-4">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="shrink-0 text-text-tertiary" aria-hidden="true">
        <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.5"/>
        <path d="M14 14l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search products, applications, news…"
        autocomplete="off"
        class="flex-1 bg-transparent text-text-primary outline-none placeholder:text-text-tertiary text-large"
      />
      <button id="search-close" class="size-8 flex items-center justify-center text-text-secondary hover:text-text-primary transition-colors shrink-0" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto">
    <div class="global-padding py-8">
      <div class="mx-auto max-w-[1200px]">
        <div id="search-results" class="flex flex-col"></div>
        <div id="search-see-all-wrap" class="hidden mt-8">
          <a id="search-see-all" href="/search" class="inline-flex items-center gap-2 text-small-caps text-text-primary hover:opacity-70 transition-opacity">
            VIEW ALL RESULTS
            <svg width="5" height="9" viewBox="0 0 5 9" fill="none" aria-hidden="true">
              <path d="M1 1L4 4.5L1 8" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .nav-scrim { background: rgba(10, 15, 21, 0.28); }

  .mega-item { color: var(--color-text-secondary); }
  .mega-item:hover, .mega-item.is-active { color: var(--color-text-primary); }
  .mega-item.is-active::before {
    content: '';
    position: absolute;
    left: -17px; top: 50%; transform: translateY(-50%);
    width: 2px; height: 9px; background: var(--color-fg-alternative);
  }

  /* White glow bottom-left so the dark title/description stay readable over any image */
  .mega-glow {
    background: radial-gradient(120% 90% at 8% 92%, rgba(255,255,255,0.96) 0%, rgba(255,255,255,0.82) 22%, rgba(255,255,255,0.35) 45%, rgba(255,255,255,0) 62%);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-btn::before,
    .mega-btn::before {
      content: '';
      display: block;
      position: absolute;
      inset: 0;
      background-color: var(--color-btn-black-hover);
      clip-path: inset(100% 0 0 0);
      transition: clip-path 0.45s cubic-bezier(.21, 1, .34, 1);
      z-index: 0;
    }
    .contact-btn:hover::before,
    .mega-preview:hover .mega-btn::before { clip-path: inset(0 0 0 0); }

    .contact-label,
    .mega-btn-label {
      text-shadow: 0 -2em 0 white;
      transform: translateY(2em);
      transition:
        transform 0.45s cubic-bezier(.21, 1, .34, 1),
        text-shadow 0.15s cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    .contact-btn:hover .contact-label,
    .mega-preview:hover .mega-btn-label { transform: translateY(0); }

    .mega-btn-arrow { transition: transform 0.45s cubic-bezier(.21, 1, .34, 1); }
    .mega-preview:hover .mega-btn-arrow { transform: translateX(4px); }
  }
</style>

<script>
  // ── Desktop dropdowns ────────────────────────────────────────
  const scrim = document.getElementById('nav-scrim')
  const wraps = Array.from(document.querySelectorAll<HTMLElement>('.nav-wrap'))
  const panels = new Map<string, HTMLElement>()
  document.querySelectorAll<HTMLElement>('.nav-panel').forEach(p => panels.set(p.dataset.panel!, p))

  let openId: string | null = null
  let closeTimer: ReturnType<typeof setTimeout> | null = null

  function openMenu(id: string) {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null }
    if (openId === id) return
    closeAll(false)
    openId = id
    panels.get(id)?.classList.remove('hidden')
    const wrap = wraps.find(w => w.dataset.menu === id)
    wrap?.querySelector('.nav-btn')?.setAttribute('aria-expanded', 'true')
    wrap?.querySelector('.nav-chevron')?.classList.add('rotate-180')
    scrim?.classList.remove('hidden')
  }

  function closeAll(clear = true) {
    panels.forEach(p => p.classList.add('hidden'))
    wraps.forEach(w => {
      w.querySelector('.nav-btn')?.setAttribute('aria-expanded', 'false')
      w.querySelector('.nav-chevron')?.classList.remove('rotate-180')
    })
    if (clear) { openId = null; scrim?.classList.add('hidden') }
  }

  function scheduleClose() {
    if (closeTimer) clearTimeout(closeTimer)
    closeTimer = setTimeout(() => closeAll(), 150)
  }

  wraps.forEach(wrap => {
    const id = wrap.dataset.menu!
    wrap.addEventListener('mouseenter', () => openMenu(id))
    wrap.addEventListener('mouseleave', scheduleClose)
    wrap.querySelector('.nav-btn')?.addEventListener('click', () => openId === id ? closeAll() : openMenu(id))
  })

  panels.forEach((panel, id) => {
    panel.addEventListener('mouseenter', () => {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null }
      openId = id
    })
    panel.addEventListener('mouseleave', scheduleClose)

    const items = Array.from(panel.querySelectorAll<HTMLElement>('.mega-item'))
    const previews = Array.from(panel.querySelectorAll<HTMLElement>('.mega-preview'))
    items.forEach(item => {
      const activate = () => {
        items.forEach(i => i.classList.toggle('is-active', i === item))
        previews.forEach(p => {
          const on = p.dataset.preview === item.dataset.item
          p.classList.toggle('opacity-100', on)
          p.classList.toggle('opacity-0', !on)
          p.classList.toggle('pointer-events-none', !on)
        })
      }
      item.addEventListener('mouseenter', activate)
      item.addEventListener('focus', activate)
    })
  })

  scrim?.addEventListener('click', () => closeAll())
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll() })

  // ── Language dropdown ────────────────────────────────────────
  const langBtn = document.getElementById('lang-btn')
  const langPanel = document.getElementById('lang-panel')
  const langChevron = langBtn?.querySelector('.lang-chevron')

  langBtn?.addEventListener('click', e => {
    e.stopPropagation()
    const open = !langPanel?.classList.contains('hidden')
    langPanel?.classList.toggle('hidden', open)
    langChevron?.classList.toggle('rotate-180', !open)
  })

  document.addEventListener('click', e => {
    if (!(e.target as HTMLElement).closest('[data-lang-wrap]')) {
      langPanel?.classList.add('hidden')
      langChevron?.classList.remove('rotate-180')
    }
  })

  // ── Mobile menu ──────────────────────────────────────────────
  const burgerBtn = document.getElementById('burger-btn')
  const mobileMenu = document.getElementById('mobile-menu')
  const burgerIcon = document.getElementById('burger-icon')
  const closeIcon  = document.getElementById('close-icon')
  let menuOpen = false

  burgerBtn?.addEventListener('click', () => {
    menuOpen = !menuOpen
    mobileMenu?.classList.toggle('hidden', !menuOpen)
    burgerIcon?.classList.toggle('hidden', menuOpen)
    closeIcon?.classList.toggle('hidden', !menuOpen)
    burgerBtn.setAttribute('aria-expanded', String(menuOpen))
    document.body.style.overflow = menuOpen ? 'hidden' : ''
  })

  document.querySelectorAll<HTMLButtonElement>('.mobile-section-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const section = btn.closest('.mobile-section')
      const content = section?.querySelector<HTMLElement>('.mobile-section-content')
      const chevron = btn.querySelector('.mobile-chevron')
      const isOpen = !content?.classList.contains('hidden')
      content?.classList.toggle('hidden', isOpen)
      chevron?.classList.toggle('rotate-180', !isOpen)
      btn.setAttribute('aria-expanded', String(!isOpen))
    })
  })

  // ── Search overlay ───────────────────────────────────────────
  const SEARCH_PROJECT = import.meta.env.PUBLIC_SANITY_PROJECT_ID ?? '0ufm7kaw'
  const SEARCH_DATASET  = import.meta.env.PUBLIC_SANITY_DATASET ?? 'production'

  const searchOverlay    = document.getElementById('search-overlay')
  const searchInput      = document.getElementById('search-input') as HTMLInputElement | null
  const searchClose      = document.getElementById('search-close')
  const searchResults    = document.getElementById('search-results')
  const searchSeeAll     = document.getElementById('search-see-all') as HTMLAnchorElement | null
  const searchSeeAllWrap = document.getElementById('search-see-all-wrap')
  const searchBtnEl      = document.getElementById('search-btn')

  let searchDebounce: ReturnType<typeof setTimeout> | null = null

  const RESULT_LABELS: Record<string, string> = {
    product: 'Product', productSeries: 'Series', industry: 'Industry',
    action: 'Application', news: 'News', caseStudy: 'Case', event: 'Event',
  }

  function getResultHref(type: string, slug: string) {
    const map: Record<string, string> = {
      product:       `/products/product/${slug}`,
      productSeries: `/products/series/${slug}`,
      industry:      `/applications/industry/${slug}`,
      action:        `/applications/action/${slug}`,
      news:          `/news/${slug}`,
      caseStudy:     `/cases/${slug}`,
      event:         `/events/${slug}`,
    }
    return map[type] ?? '/'
  }

  function openSearch() {
    closeAll()
    searchOverlay?.classList.remove('hidden')
    searchOverlay?.classList.add('flex')
    document.body.style.overflow = 'hidden'
    setTimeout(() => searchInput?.focus(), 50)
  }

  function closeSearch() {
    searchOverlay?.classList.add('hidden')
    searchOverlay?.classList.remove('flex')
    document.body.style.overflow = ''
    if (searchInput) searchInput.value = ''
    if (searchResults) searchResults.innerHTML = ''
    searchSeeAllWrap?.classList.add('hidden')
  }

  function renderSearchResults(results: any[], query: string) {
    if (!searchResults) return
    if (!results.length) {
      searchResults.innerHTML = `<p class="text-regular text-text-secondary py-4">No results for "${query}"</p>`
      searchSeeAllWrap?.classList.add('hidden')
      return
    }
    searchResults.innerHTML = results.map((r: any) => `
      <a href="${getResultHref(r._type, r.slug?.current ?? '')}"
         class="flex items-center gap-4 py-3 border-b border-border-other-2 hover:opacity-70 transition-opacity group">
        <span class="text-tiny text-text-tertiary uppercase shrink-0 w-[88px]">${RESULT_LABELS[r._type] ?? r._type}</span>
        <span class="flex-1 text-small-medium text-text-primary truncate">${r.title ?? ''}</span>
        <svg width="6" height="10" viewBox="0 0 6 10" fill="none" class="shrink-0 text-text-tertiary group-hover:text-text-primary transition-colors" aria-hidden="true">
          <path d="M1 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    `).join('')
    if (searchSeeAll) searchSeeAll.href = `/search?q=${encodeURIComponent(query)}`
    searchSeeAllWrap?.classList.remove('hidden')
  }

  async function runSearch(query: string) {
    const safe = query.replace(/["\\]/g, '').trim()
    if (!safe) {
      if (searchResults) searchResults.innerHTML = ''
      searchSeeAllWrap?.classList.add('hidden')
      return
    }
    if (searchResults) searchResults.innerHTML = '<p class="text-tiny text-text-tertiary py-3">Searching…</p>'
    try {
      const groq = `*[_type in ["product","productSeries","industry","action","news","caseStudy","event"] && title match "${safe}*"][0...8]{_type, title, slug}`
      const url = `https://${SEARCH_PROJECT}.api.sanity.io/v2024-01-01/data/query/${SEARCH_DATASET}?query=${encodeURIComponent(groq)}`
      const res = await fetch(url)
      const data = await res.json()
      renderSearchResults(data.result ?? [], query)
    } catch (err) {
      console.error('Search error:', err)
      if (searchResults) searchResults.innerHTML = '<p class="text-tiny text-text-tertiary py-3">Search unavailable</p>'
    }
  }

  searchBtnEl?.addEventListener('click', openSearch)
  searchClose?.addEventListener('click', closeSearch)

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !searchOverlay?.classList.contains('hidden')) closeSearch()
  })

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim()
    if (searchDebounce) clearTimeout(searchDebounce)
    searchDebounce = setTimeout(() => runSearch(q), 220)
  })

  searchInput?.addEventListener('keydown', e => {
    if (e.key === 'Enter') {
      const q = searchInput.value.trim()
      if (q) window.location.href = `/search?q=${encodeURIComponent(q)}`
    }
  })

  // ── Hide on scroll down, show on scroll up ───────────────────
  const header = document.getElementById('site-header')!
  let lastY = window.scrollY
  let ticking = false

  window.addEventListener('scroll', () => {
    if (ticking) return
    ticking = true
    requestAnimationFrame(() => {
      const currentY = window.scrollY
      const headerH = header.offsetHeight

      if (currentY <= headerH) {
        header.style.transform = 'translateY(0)'
      } else if (currentY > lastY) {
        header.style.transform = 'translateY(-100%)'
        closeAll()
      } else {
        header.style.transform = 'translateY(0)'
      }

      lastY = currentY
      ticking = false
    })
  }, { passive: true })
</script>
