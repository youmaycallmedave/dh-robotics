---
type NavColumn = { group?: string; links: { label: string; href: string }[] }
type MegaItem = { key: string; title: string; desc: string; img: string; href: string }
type Mega = { id: string; label: string; items: MegaItem[] }

// Products mega-menu — Figma 01.1 Menu → "Product Menu / Desktop" (11667:76739)
// Левый рельс переключает правую карточку; Smart Actuators раскрывается в подсписок.
// Правая часть панели бывает двух видов:
//  - hero  — одна большая карточка с заголовком, описанием и кнопкой (All Products)
//  - сетка — карточки продуктов; раскладка выводится из их количества (см. gridClass)
// Два типа карточек из макета:
//  - без desc — изображение на всю плашку, подпись сверху и круглая кнопка снизу
//    (Dexterous Hand, Smart Actuators)
//  - с desc — иконка продукта 80x80, название серии и описание (Electric Grippers)
type ProductCard = { label: string; href: string; img: string; desc?: string }

type ProductMenuNode = {
  key: string
  label: string
  title: string
  desc: string
  href: string
  img?: string
  cards?: ProductCard[]
}

type ProductMenuItem = ProductMenuNode & {
  logoIcon?: boolean
  children?: ProductMenuNode[]
}

// 1 → одна колонка, 2 → две, 3 → бенто (слева высокая, справа две в столбик),
// 4 → 2×2, дальше → четыре колонки. Проверено по Figma: Dexterous Hand (3),
// Smart Actuators (4), Electric Grippers (12).
function gridClass(n: number) {
  if (n === 1) return 'grid-cols-1'
  if (n === 2) return 'grid-cols-2'
  if (n === 3) return 'grid-cols-2 grid-rows-2'
  if (n === 4) return 'grid-cols-2'
  return 'grid-cols-4'
}

