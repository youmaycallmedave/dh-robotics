      { key: 'servo-drives',             label: 'Servo Drives',             title: 'Servo Drives',             desc: 'Compact drives that deliver accurate motion control across the product range.', href: '/products', img: '/images/dh56-feat-2.jpg' },
    ],
  },
  {
    key: 'ifm',
    label: 'Intelligent Flexible Motion System',
    title: 'Intelligent Flexible Motion System',
