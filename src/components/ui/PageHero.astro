---
import Button from './Button.astro'
import ScrollIndicator from './ScrollIndicator.astro'

interface Props {
  title: string
  description?: string
  image?: string
  imageAlt?: string
  scrollTarget?: string
  buttonLabel?: string
  buttonHref?: string
  buttonVariant?: 'black' | 'blue' | 'red' | 'white'
}

const {
  title,
  description,
  image,
  imageAlt = '',
  scrollTarget,
  buttonLabel,
  buttonHref,
  buttonVariant = 'black',
} = Astro.props
---

<section class="bg-bg-primary pt-page pb-md">
  <div class="global-padding">
    <div class="mx-auto max-w-[1200px] flex items-start justify-between gap-10 max-lg:flex-col">

      <div class="flex flex-col justify-between h-[360px] max-lg:h-auto max-lg:gap-8 shrink-0 w-[491px] max-lg:w-full">
        <div class="flex flex-col gap-6">
          <h1 class="text-h1 text-text-primary">{title}</h1>
          {description && (
            <p class="text-medium text-text-primary max-w-[390px]">{description}</p>
          )}
          {buttonLabel && buttonHref && (
            <div>
              <Button label={buttonLabel} href={buttonHref} variant={buttonVariant} />
            </div>
          )}
        </div>
        {scrollTarget && (
          <ScrollIndicator href={`#${scrollTarget}`} />
        )}
      </div>

      {image && (
        <div class="bg-bg-secondary rounded-small overflow-hidden shrink-0 w-[592px] h-[360px] max-lg:w-full max-lg:h-auto max-lg:aspect-video">
          <img src={image} alt={imageAlt} class="w-full h-full object-cover" />
        </div>
      )}

    </div>
  </div>
</section>
