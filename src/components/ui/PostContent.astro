---
import type { PostBlock } from '../../types/post'

interface Props {
  blocks: PostBlock[]
}

const { blocks } = Astro.props

function getYoutubeId(url: string): string | null {
  if (!url) return null
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/))([a-zA-Z0-9_-]{11})/)
  return match ? match[1] : null
}
---

{blocks.map((block) => {
  if (block.type === 'text') return (
    <div class="flex flex-col gap-8">
      {block.heading && <h4 class="text-h4 mob-h5 text-text-primary">{block.heading}</h4>}
      <div class="flex flex-col gap-0">
        {block.paragraphs.map(p => (
          <p class="text-large text-text-primary mb-[26px] last:mb-0">{p}</p>
        ))}
      </div>
    </div>
  )

  if (block.type === 'image') return (
    <div class="bg-bg-secondary rounded-[8px] overflow-hidden w-full h-[440px] max-lg:h-auto max-lg:aspect-video">
      <img src={block.src} alt={block.alt} class="w-full h-full object-cover" loading="lazy" />
    </div>
  )

  if (block.type === 'video') {
    const youtubeId = getYoutubeId(block.alt)
    return (
      <div
        class="video-embed relative bg-bg-secondary rounded-[8px] overflow-hidden w-full aspect-video group cursor-pointer"
        data-youtube={youtubeId ?? ''}
        data-url={block.alt}
      >
        {block.src
          ? <img src={block.src} alt="" class="w-full h-full object-cover" loading="lazy" />
          : youtubeId
            ? <img src={`https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg`} alt="" class="w-full h-full object-cover" loading="lazy" />
            : <div class="w-full h-full bg-black/10"></div>
        }
        <div class="absolute inset-0 flex items-center justify-center bg-black/10 group-hover:bg-black/20 transition-colors duration-300">
          <div class="size-[100px] max-lg:size-20 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
            <svg viewBox="0 0 100 71" fill="none" class="w-full h-auto" aria-hidden="true">
              <rect width="100" height="70.588" rx="8" fill="#FF0000"/>
              <path d="M40 20L65 35.294L40 50.588V20Z" fill="white"/>
            </svg>
          </div>
        </div>
      </div>
    )
  }

  if (block.type === 'callout') return (
    <div class="bg-bg-tertiary p-10 max-lg:p-8">
      <p class="text-h6 text-text-alternate">{block.text}</p>
    </div>
  )

  if (block.type === 'list') return (
    <div class="flex flex-col gap-6">
      {block.intro && <p class="text-large-medium text-text-primary">{block.intro}</p>}
      {block.ordered
        ? (
          <ol class="list-decimal pl-6 flex flex-col gap-2">
            {block.items.map(item => (
              <li class="text-large text-text-primary text-trim-off">{item}</li>
            ))}
          </ol>
        )
        : (
          <ul class="list-disc pl-6 flex flex-col gap-2">
            {block.items.map(item => (
              <li class="text-large text-text-primary text-trim-off">{item}</li>
            ))}
          </ul>
        )
      }
    </div>
  )
})}

<script>
  document.querySelectorAll<HTMLElement>('.video-embed').forEach(el => {
    el.addEventListener('click', () => {
      const youtubeId = el.dataset.youtube
      const url = el.dataset.url

      if (youtubeId) {
        el.innerHTML = `<iframe
          src="https://www.youtube.com/embed/${youtubeId}?autoplay=1"
          class="w-full h-full"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        ></iframe>`
        el.classList.remove('cursor-pointer')
      } else if (url) {
        window.open(url, '_blank', 'noopener,noreferrer')
      }
    })
  })
</script>
