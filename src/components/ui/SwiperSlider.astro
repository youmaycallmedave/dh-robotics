---
import 'swiper/css'

interface Props {
  id: string
  title?: string
  description?: string
  viewMoreHref?: string
  viewMoreLabel?: string
  slideWidth?: number
  slideMobileWidth?: number
  gap?: number
  class?: string
}

const {
  id,
  title,
  description,
  viewMoreHref,
  viewMoreLabel = 'View more',
  slideWidth = 562,
  slideMobileWidth = 320,
  gap = 0,
  class: className = '',
} = Astro.props
---

<div class:list={['swiper-section', className]}>

  {(title || description) && (
    <div class="flex flex-col gap-10 mb-14 max-lg:gap-6 max-lg:mb-10 max-w-[694px]">
      {title && <h3 class="text-h3 text-text-primary">{title}</h3>}
      {description && <p class="text-regular text-text-primary">{description}</p>}
    </div>
  )}

  <div
    class="swiper-slider-wrap"
    data-swiper-id={id}
    data-slide-width={slideWidth}
    data-slide-mobile-width={slideMobileWidth}
    data-gap={gap}
  >
    <div class={`swiper ${id}`}>
      <div class="swiper-wrapper">
        <slot />
      </div>
    </div>
  </div>

  <div class="flex items-center gap-10 mt-10 max-lg:mt-8">
    <div class="flex-1 h-px bg-border-other-2 relative">
      <div class={`${id}-progress absolute left-0 top-0 h-px bg-fg-alternative transition-all duration-300 ease-out`} style="width: 33%"></div>
    </div>
    <div class="flex items-center gap-4 shrink-0">
      <button
        class={`${id}-prev size-8 border border-border-other-2 rounded-[4px] flex items-center justify-center hover:border-border-alternative transition-colors duration-200 cursor-pointer`}
        aria-label="Previous"
      >
        <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        class={`${id}-next size-8 border border-border-other-2 rounded-[4px] flex items-center justify-center hover:border-border-alternative transition-colors duration-200 cursor-pointer`}
        aria-label="Next"
      >
        <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    {viewMoreHref && (
      <a href={viewMoreHref} class="inline-flex items-center gap-2 text-small-caps text-text-primary hover:text-text-secondary transition-colors duration-200 shrink-0">
        <span>{viewMoreLabel}</span>
        <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    )}
  </div>

</div>

<style>
  .swiper-slider-wrap .swiper {
    overflow: visible !important;
  }
  .swiper-slider-wrap .swiper-wrapper {
    align-items: stretch;
  }
  .swiper-slider-wrap .swiper-slide {
    height: auto;
    margin-right: -1px !important;
  }
</style>

<script>
  import Swiper from 'swiper'
  import { Navigation } from 'swiper/modules'

  document.querySelectorAll<HTMLElement>('.swiper-slider-wrap').forEach(wrap => {
    const uid = wrap.dataset.swiperId
    if (!uid) return

    const slideWidth = parseInt(wrap.dataset.slideWidth || '562')
    const slideMobileWidth = parseInt(wrap.dataset.slideMobileWidth || '320')
    const gap = parseInt(wrap.dataset.gap || '0')

    const progressEl = document.querySelector<HTMLElement>(`.${uid}-progress`)

    const swiper = new Swiper(`.${uid}`, {
      modules: [Navigation],
      slidesPerView: 'auto',
      spaceBetween: gap,
      grabCursor: true,
      navigation: {
        prevEl: `.${uid}-prev`,
        nextEl: `.${uid}-next`,
      },
      on: {
        slideChange(s) {
          if (progressEl) {
            const pct = ((s.activeIndex + 1) / s.slides.length) * 100
            progressEl.style.width = `${Math.min(pct, 100)}%`
          }
        },
      },
    })

    const slides = wrap.querySelectorAll<HTMLElement>('.swiper-slide')
    const setWidths = () => {
      const w = window.innerWidth < 768 ? slideMobileWidth : slideWidth
      slides.forEach(s => { s.style.width = `${w}px` })
    }
    setWidths()
    window.addEventListener('resize', setWidths)

    if (progressEl && swiper.slides.length) {
      progressEl.style.width = `${(1 / swiper.slides.length) * 100}%`
    }
  })
</script>
