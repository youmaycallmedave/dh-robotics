---
import Layout from '../../../layouts/Layout.astro'
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro'
import { client, urlFor } from '../../../lib/sanity'

export async function getStaticPaths() {
  const industries = await client.fetch(`*[_type == "industry"]{ slug }`)
  return industries.map((i: any) => ({ params: { slug: i.slug.current } }))
}

const { slug } = Astro.params

const [industry, allIndustries, allActions] = await Promise.all([
  client.fetch(
    `*[_type == "industry" && slug.current == $slug][0]{
      _id, title, description, image,
      sections[]{ _key, title, text, videoUrl, image, series[]->{ _id, title, slug, heroImage, subtitle, features[]{title} } }
    }`,
    { slug }
  ),
  client.fetch(`*[_type == "industry"] | order(order asc) { _id, title, slug }`),
  client.fetch(`*[_type == "action"] | order(order asc) { _id, title, slug, icon }`),
])

if (!industry) return Astro.redirect('/applications')

const iconMap: Record<string, string> = {
  'grabbing':            '/images/icon-task-grabbing.svg',
  'clamping':            '/images/icon-task-clamping.svg',
  'counterpoint':        '/images/icon-task-counterpoint.svg',
  'transport':           '/images/icon-task-transport.svg',
  'rotation':            '/images/icon-task-rotation.png',
  'assembly':            '/images/icon-task-assembly.svg',
  'loading-unloading':   '/images/icon-task-loading.svg',
  'opening-closing-lid': '/images/icon-task-opening.svg',
}

function getYoutubeId(url: string): string | null {
  const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\s]+)/)
  return m ? m[1] : null
}
---

<Layout title={`${industry.title} — DH Robotics`}>

  <Breadcrumbs crumbs={[
    { label: 'Applications', href: '/applications' },
    { label: industry.title },
  ]} />

  <section class="bg-bg-primary py-[120px] max-lg:py-20">
    <div class="global-padding">
      <div class="mx-auto max-w-[1200px]">

        <!-- Hero: image left + text right -->
        <div class="flex items-start gap-[120px] mb-14 max-lg:flex-col max-lg:gap-10 max-lg:mb-10">
          <!-- Left: hero image -->
          <div class="shrink-0 w-[592px] h-[451px] bg-bg-alternative rounded-[8px] overflow-hidden max-lg:w-full max-lg:h-auto max-lg:aspect-[592/451]">
            {industry.image ? (
              <img
                src={urlFor(industry.image).width(1200).url()}
                alt={industry.title}
                class="w-full h-full object-cover"
              />
            ) : (
              <img src="/images/applications-medical.webp" alt={industry.title} class="w-full h-full object-cover" />
            )}
          </div>

          <!-- Right: title + description -->
          <div class="flex flex-col justify-between self-stretch gap-10 flex-1 min-w-0">
            <div class="flex flex-col gap-10 max-lg:gap-6">
              <h1 class="text-h2 mob-h3 text-text-primary">{industry.title}</h1>
              {industry.description && (
                <p class="text-regular text-text-secondary">{industry.description}</p>
              )}
            </div>
          </div>
        </div>

        <!-- Industry tabs navigation -->
        <div class="border-b border-border-other-2 mb-[120px] max-lg:mb-20 overflow-x-auto">
          <div class="flex gap-10 pb-4 whitespace-nowrap max-lg:gap-6">
            {(allIndustries as any[]).map((ind) => {
              const isActive = ind.slug?.current === slug
              return (
                <a
                  href={`/applications/industry/${ind.slug?.current}`}
                  class:list={[
                    'relative shrink-0 text-tiny-medium pb-1 transition-colors duration-200',
                    isActive ? 'text-text-primary' : 'text-text-secondary hover:text-text-primary',
                  ]}
                >
                  {ind.title}
                  {isActive && (
                    <span class="absolute bottom-[-17px] left-0 w-full h-px bg-text-primary"></span>
                  )}
                </a>
              )
            })}
          </div>
        </div>

        <!-- Classification: sidebar + content -->
        {industry.sections?.length > 0 && (
          <div class="flex flex-col gap-14 max-lg:gap-10">
            <h2 class="text-h2 mob-h3 text-text-primary">Classification</h2>

            <div class="flex items-start gap-10 max-lg:flex-col">

              <!-- Sticky sidebar -->
              <aside class="shrink-0 w-[288px] sticky top-24 max-lg:static max-lg:w-full">
                <ol class="flex flex-col gap-0">
                  {(industry.sections as any[]).map((section, i) => (
                    <li>
                      <a
                        href={`#section-${section._key}`}
                        class="relative block py-3 border-b border-border-other-2 text-small text-text-secondary hover:text-text-primary transition-colors duration-200 section-nav-link"
                        data-key={section._key}
                      >
                        <span class="text-text-tertiary mr-2">{String(i + 1).padStart(2, '0')}.</span>
                        {section.title}
                        <span class="section-nav-line absolute bottom-[-1px] left-0 h-[1px] bg-text-primary w-full origin-left scale-x-0 transition-transform duration-700 ease-[cubic-bezier(0.4,0,0.2,1)]"></span>
                      </a>
                    </li>
                  ))}
                </ol>
              </aside>

              <!-- Main content -->
              <div class="flex-1 flex flex-col min-w-0">
                {(industry.sections as any[]).map((section, i) => {
                  const ytId = section.videoUrl ? getYoutubeId(section.videoUrl) : null
                  const hasMedia = ytId || section.image
                  return (
                    <div
                      id={`section-${section._key}`}
                      class:list={[
                        'flex flex-col gap-10',
                        i < (industry.sections?.length ?? 0) - 1 ? 'pb-16 mb-16 border-b border-border-other-2' : '',
                      ]}
                    >
                      <div class="flex flex-col gap-8">
                        {section.title && (
                          <h3 class="text-h3 mob-h4 text-text-primary">{section.title}</h3>
                        )}
                        {section.text && (
                          <p class="text-small text-text-secondary">{section.text}</p>
                        )}
                      </div>

                      {hasMedia && (
                        <div class="w-full aspect-video bg-bg-secondary rounded-[4px] overflow-hidden relative">
                          {ytId ? (
                            <iframe
                              src={`https://www.youtube.com/embed/${ytId}`}
                              title={section.title ?? ''}
                              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                              allowfullscreen
                              class="absolute inset-0 w-full h-full border-0"
                            />
                          ) : section.image ? (
                            <img
                              src={urlFor(section.image).width(1800).url()}
                              alt={section.title ?? ''}
                              class="absolute inset-0 w-full h-full object-cover"
                            />
                          ) : null}
                        </div>
                      )}

                      {section.series?.length > 0 && (
                        <div class="flex flex-col gap-6">
                          <h4 class="text-h6 text-text-primary">Application Products</h4>
                          <div class="flex flex-wrap gap-4">
                            {(section.series as any[]).map((s) => (
                              <a
                                href={`/products/series/${s.slug?.current}`}
                                class="group w-[288px] shrink-0 flex flex-col bg-bg-secondary"
                              >
                                <div class="h-[259px] overflow-hidden relative">
                                  {s.heroImage ? (
                                    <img
                                      src={urlFor(s.heroImage).width(576).url()}
                                      alt={s.title}
                                      class="absolute inset-0 w-full h-full object-contain"
                                    />
                                  ) : (
                                    <div class="absolute inset-0 flex items-center justify-center">
                                      <span class="text-text-tertiary text-small">{s.title}</span>
                                    </div>
                                  )}
                                </div>
                                <div class="flex flex-col gap-6 p-5">
                                  <div class="flex flex-col gap-4">
                                    <span class="text-h6 text-text-primary tracking-[-0.03125rem]">{s.title}</span>
                                    {s.subtitle && <span class="text-regular text-text-secondary">{s.subtitle}</span>}
                                  </div>
                                  <div class="flex items-end gap-4">
                                    {s.features?.length > 0 && (
                                      <ul class="flex-1 flex flex-col gap-2 min-w-0">
                                        {(s.features as any[]).map((f: any) => (
                                          <li class="flex items-center gap-2">
                                            <svg class="shrink-0" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                              <rect x="5" y="5" width="6" height="6" rx="1" fill="currentColor" class="text-text-primary"/>
                                            </svg>
                                            <span class="text-small text-text-primary leading-[22px]">{f.title}</span>
                                          </li>
                                        ))}
                                      </ul>
                                    )}
                                    <div class="size-10 bg-btn-black-default flex items-center justify-center rounded-[2px] shrink-0 self-end group-hover:opacity-80 transition-opacity duration-200">
                                      <svg width="6" height="10" viewBox="0 0 6 10" fill="none" aria-hidden="true">
                                        <path d="M1 1L5 5L1 9" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                      </svg>
                                    </div>
                                  </div>
                                </div>
                              </a>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  )
                })}
              </div>

            </div>
          </div>
        )}

      </div>
    </div>
  </section>

  <!-- Tasks section at bottom -->
  {allActions.length > 0 && (
    <section class="bg-bg-other py-[120px] max-lg:py-20">
      <div class="global-padding">
        <div class="mx-auto max-w-[1200px]">

          <div class="flex items-end justify-between gap-10 mb-14 max-lg:mb-10">
            <h2 class="text-h2 mob-h3 text-text-primary">Tasks</h2>
            <a href="/applications" class="shrink-0 inline-flex items-center gap-2 text-small-caps text-text-primary hover:opacity-70 transition-opacity mb-1">
              VIEW MORE
              <svg width="5" height="9" viewBox="0 0 5 9" fill="none" aria-hidden="true">
                <path d="M1 1L4 4.5L1 8" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-4 gap-4 max-lg:grid-cols-2 max-sm:grid-cols-1">
            {(allActions as any[]).map((action) => {
              const iconSrc = action.icon
                ? urlFor(action.icon).width(144).url()
                : (iconMap[action.slug?.current] ?? '')
              return (
                <a
                  href={`/applications/action/${action.slug?.current}`}
                  class="group bg-bg-other border border-border-other-2 p-8 flex flex-col justify-between h-[272px] hover:border-text-primary transition-colors duration-200"
                >
                  <div class="flex items-center justify-between">
                    <span class="text-large-medium text-text-primary uppercase leading-[1.3]">{action.title}</span>
                    <div class="shrink-0 size-8 border border-border-other-2 rounded-[4px] flex items-center justify-center text-text-secondary group-hover:border-text-primary group-hover:text-text-primary transition-colors">
                      <svg width="8" height="12" viewBox="0 0 8 12" fill="none" aria-hidden="true">
                        <path d="M2 2L6 6L2 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                  </div>
                  {iconSrc && (
                    <div class="size-[72px]">
                      <img src={iconSrc} alt="" class="size-full object-contain" aria-hidden="true" />
                    </div>
                  )}
                </a>
              )
            })}
          </div>

        </div>
      </div>
    </section>
  )}

</Layout>

<script>
  // Sidebar TOC: FAQ-style animated underline on scroll
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.section-nav-link'))
  const navLines = Array.from(document.querySelectorAll<HTMLElement>('.section-nav-line'))
  const sectionEls = navLinks.map(l => document.getElementById(l.dataset.key ? `section-${l.dataset.key}` : ''))

  function updateActiveToc() {
    const trigger = window.innerHeight * 0.2
    let activeIdx = 0
    sectionEls.forEach((el, i) => {
      if (el && el.getBoundingClientRect().top <= trigger) activeIdx = i
    })
    navLines.forEach((line, i) => {
      line.classList.toggle('scale-x-0', i !== activeIdx)
      line.classList.toggle('scale-x-100', i === activeIdx)
    })
    navLinks.forEach((link, i) => {
      link.classList.toggle('text-text-primary', i === activeIdx)
      link.classList.toggle('text-text-secondary', i !== activeIdx)
    })
  }

  if (sectionEls.length > 0) {
    updateActiveToc()
    window.addEventListener('scroll', updateActiveToc, { passive: true })
  }
</script>
