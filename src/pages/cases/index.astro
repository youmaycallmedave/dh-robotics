---
import Layout from '../../layouts/Layout.astro'
import { client } from '../../lib/sanity'

const cases = await client.fetch(`
  *[_type == "caseStudy"] | order(_createdAt desc) {
    title,
    "slug": slug.current,
    description,
    "logo": logo.asset._ref,
    "thumbnail": media[0].thumbnail.asset._ref,
    "seriesTitle": applicationProduct.series->title,
    "categoryTitle": applicationProduct.series->category->title,
  }
`)

function assetUrl(ref: string | undefined, w = 400) {
  if (!ref) return ''
  return `https://cdn.sanity.io/images/0ufm7kaw/production/${ref.replace('image-', '').replace(/-([a-z]+)$/, '.$1')}?w=${w}&auto=format`
}
---

<Layout title="Demonstration Cases">
  <section class="bg-bg-primary pt-page pb-lg">
    <div class="global-padding">
      <div class="mx-auto max-w-[1200px] flex flex-col gap-14">

        <h1 class="text-h1 mob-h2 text-text-primary">Demonstration Cases</h1>

        <div class="grid grid-cols-3 gap-6 max-lg:grid-cols-2 max-md:grid-cols-1">
          {cases.map((c: any) => (
            <a href={`/cases/${c.slug}`} class="group flex flex-col border border-border-other-2 hover:border-border-alternative transition-colors duration-200 overflow-hidden">

              <!-- Thumbnail -->
              <div class="bg-bg-secondary h-[220px] overflow-hidden shrink-0">
                {c.thumbnail
                  ? <img src={assetUrl(c.thumbnail, 600)} alt={c.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                  : <div class="w-full h-full bg-bg-secondary" />
                }
              </div>

              <!-- Info -->
              <div class="flex flex-col gap-4 p-6">
                <div class="flex items-start justify-between gap-4">
                  <h2 class="text-h5 text-text-primary">{c.title}</h2>
                  {c.logo && (
                    <div class="shrink-0 border border-border-other-2 rounded-[4px] w-16 h-9 flex items-center justify-center p-2 bg-bg-primary">
                      <img src={assetUrl(c.logo, 120)} alt={c.title} class="w-full h-full object-contain" loading="lazy" />
                    </div>
                  )}
                </div>

                {c.description && <p class="text-small text-text-secondary line-clamp-2">{c.description}</p>}

                <div class="flex flex-wrap gap-2 mt-auto pt-2">
                  {c.categoryTitle && (
                    <span class="inline-flex items-center px-2 py-1 bg-bg-secondary text-tiny-medium text-text-secondary">{c.categoryTitle}</span>
                  )}
                  {c.seriesTitle && (
                    <span class="inline-flex items-center px-2 py-1 bg-fg-alternative text-tiny-medium text-text-alternate">{c.seriesTitle}</span>
                  )}
                </div>
              </div>

            </a>
          ))}
        </div>

        {cases.length === 0 && (
          <p class="text-regular text-text-secondary">No cases yet.</p>
        )}

      </div>
    </div>
  </section>
</Layout>
