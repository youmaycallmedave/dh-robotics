---
import Layout from '../layouts/Layout.astro'
import Button from '../components/ui/Button.astro'
import SwiperSlider from '../components/ui/SwiperSlider.astro'
import Accordion from '../components/ui/Accordion.astro'
import { countries } from '../data/countries'
import 'tom-select/dist/css/tom-select.css'
import { client } from '../lib/sanity'

function assetUrl(ref: string | undefined, w = 800) {
  if (!ref) return ''
  return `https://cdn.sanity.io/images/0ufm7kaw/production/${ref.replace('image-', '').replace(/-([a-z]+)$/, '.$1')}?w=${w}&auto=format`
}

// ── Hero slides ──
const heroSlides = [
  {
    tag: 'Dexterous Hands', title: 'Built for the next generation of robotics.',
    subtitle: 'Intelligent End-of-Arm Tooling & Dexterous Hands', href: '/products',
    img: '/images/home/hero-hand.png',
    imgClass: 'absolute right-[-67px] top-[-53.8%] h-[174%] w-auto max-w-none',
  },
  {
    tag: 'Electric Grippers', title: 'Precision gripping for every production line.',
    subtitle: 'Adaptive, parallel and rotary electric grippers', href: '/products/category',
    img: '/images/dh56-hero-product.png',
    imgClass: 'absolute right-[4%] top-1/2 -translate-y-1/2 h-[80%] w-auto max-w-none object-contain',
  },
  {
    tag: 'Smart Actuators', title: 'Motion control engineered for accuracy.',
    subtitle: 'Servo drives, cylinders and linear coil actuators', href: '/products',
    img: '/images/service-technology-product1.webp',
    imgClass: 'absolute right-[4%] top-1/2 -translate-y-1/2 h-[75%] w-auto max-w-none object-contain',
  },
  {
    tag: 'iFM System', title: 'Intelligent flexible motion, ready to deploy.',
    subtitle: 'Plug & play automation for modern factories', href: '/products',
    img: '/images/service-technology-product2.webp',
    imgClass: 'absolute right-[4%] top-1/2 -translate-y-1/2 h-[75%] w-auto max-w-none object-contain',
  },
  {
    tag: 'Hexapods', title: 'Six degrees of freedom, sub-micron precision.',
    subtitle: 'Precision positioning for research and industry', href: '/products',
    img: '/images/service-technology-product3.webp',
    imgClass: 'absolute right-[4%] top-1/2 -translate-y-1/2 h-[75%] w-auto max-w-none object-contain',
  },
]

// ── Proven Success cases (slider) ──
const provenCases = [
  { client: 'KFC', img: '/images/dh56-action.jpg',
    desc: 'The AG-160-95 adaptive gripper was applied to pick up and complete the production of ice cream cones. Task difficulty: precise force control, position control, position repeatability, fast movement.' },
  { client: 'CHANEL', img: '/images/home/industry-medical.jpg',
    desc: 'PGC series grippers handle delicate cosmetic packaging on a high-speed line, keeping surfaces flawless while sustaining full production tempo.' },
  { client: 'NISSAN', img: '/images/dh56-feat-1.jpg',
    desc: 'AG series grippers automate component handling in body assembly, combining envelope adaptive grasping with repeatable positioning.' },
  { client: 'SAMSUNG', img: '/images/dh56-feat-2.jpg',
    desc: 'Precise force control lets our grippers place fragile electronic components without a single micro-damage incident.' },
]

// ── Testimonials (slider) ──
const testimonials = [
  {
    quote: 'Integrating DH-Robotics AG-series grippers into our high-speed electronics assembly lines has been a game-changer.\n\nThanks to the precise force control and envelope adaptive grasping, we managed to seamlessly automate the handling of our most delicate components without a single micro-damage incident. It’s a field-proven, plug-and-play solution that has significantly boosted our production efficiency and OEE.',
    name: 'Tomas Shelbi', role: 'Senior Automation Engineer, Samsung Electronics', avatar: '/images/home/avatar-tomas.jpg',
  },
  {
    quote: 'We replaced pneumatic tooling across two lines and never looked back.\n\nSetup took an afternoon, the control software is straightforward, and repeatability has stayed within spec through months of continuous shifts. Support from the engineering team was quick and genuinely technical.',
    name: 'Marta Nowak', role: 'Process Engineer, Automotive Tier-1 Supplier', avatar: '/images/home/avatar-tomas.jpg',
  },
  {
    quote: 'What sold us was the force control on fragile parts.\n\nOur previous solution damaged roughly one in every few hundred components. Since switching to DH-Robotics grippers that number is effectively zero, and cycle time actually improved.',
    name: 'Kenji Sato', role: 'Head of Manufacturing, Medical Devices', avatar: '/images/home/avatar-tomas.jpg',
  },
]

const whyCards = [
  { title: 'We Create', img: '/images/home/why-create.jpg', icon: 'plus',
    desc: 'We don’t just manufacture grippers — we develop industry-leading motion control solutions that redefine precision, intelligence, and reliability for modern factories.',
    points: ['Precise force control', 'High accurate repeatability', 'Exquisite and compact size'] },
  { title: 'We Build', img: '/images/home/why-build.jpg', icon: 'chip',
    desc: 'We don’t just manufacture grippers — we develop industry-leading motion control solutions that redefine precision, intelligence, and reliability for modern factories.',
    points: ['Real-time perception', 'Smart feedback', 'Intelligent detection'] },
  { title: 'We are on the way to', img: '/images/home/why-future.jpg', icon: 'expand',
    desc: 'We don’t just manufacture grippers — we develop industry-leading motion control solutions that redefine precision, intelligence, and reliability for modern factories.',
    points: ['Precise force control', 'High accurate repeatability', 'Exquisite and compact size'] },
]

// ── CMS: equipment — one tab per product category, its series in the grid ──
let equipment: any[] = []
try {
  const cats = await client.fetch(`*[_type == "productCategory"] | order(order asc){
    title, description, "slug": slug.current,
    "series": *[_type == "productSeries" && references(^._id)] | order(order asc){
      title, subtitle, "slug": slug.current, "img": heroImage.asset._ref
    }
  }`)
  equipment = (cats ?? [])
    .filter((c: any) => c.series?.length)
    .map((c: any) => ({
      title: c.title,
      description: c.description ?? '',
      series: c.series.map((s: any) => ({
        title: s.title,
        img: s.img ? assetUrl(s.img, 1200) : '',
        href: '/products/series',
      })),
    }))
} catch { equipment = [] }

const stats = [
  { value: 'NO.1',      label: 'China electric actuator sales' },
  { value: '60+',       label: 'Countries and regions coverage' },
  { value: '50+',       label: 'Product series, covering multiple industries' },
  { value: '120%',      label: 'Compound growth rate over the past 5 years' },
  { value: '300,000+',  label: 'Units shipped in total' },
  { value: '5,000+',    label: 'intelligent manufacturing customers, industry leader' },
]

const industryTabs = ['Medical automation', 'Electronics', 'Automotive', 'Automation', 'Machining', 'Robot New Retail', 'Education Research', 'New energy']

// One slide per tab, so the tab row and the carousel stay in sync
const industries = industryTabs.map(title => ({
  title,
  img: '/images/home/industry-medical.jpg',
  href: title === 'Medical automation' ? '/applications/industry/medical-automation' : '/applications',
}))

const tasks = [
  { title: 'Grabbing',            icon: '/images/icon-task-grabbing.svg',   href: '/applications/action/grabbing' },
  { title: 'Clamping',            icon: '/images/icon-task-clamping.svg',   href: '/applications/action/clamping' },
  { title: 'Counterpoint',        icon: '/images/icon-task-counterpoint.svg', href: '/applications/action/counterpoint' },
  { title: 'Transport',           icon: '/images/icon-task-transport.svg',  href: '/applications/action/transport' },
  { title: 'Rotation',            icon: '/images/icon-task-rotation.png',   href: '/applications/action/rotation' },
  { title: 'Assembly',            icon: '/images/icon-task-assembly.svg',   href: '/applications/action/assembly' },
  { title: 'Loading & Unloading', icon: '/images/icon-task-loading.svg',    href: '/applications/action/loading-unloading' },
  { title: 'Opening & Closing Lid', icon: '/images/icon-task-opening.svg',  href: '/applications/action/opening-closing-lid' },
]

const supportLinks = [
  { question: 'Download center',        answer: 'Product datasheets, manuals, 3D models and technical documentation — everything you need to specify and integrate our hardware.' },
  { question: 'User Control Software',  answer: 'DH-Robotics ServoStudio and control plugins for fast setup, debugging and fine-tuning of grippers and actuators.' },
  { question: 'Support Hub',            answer: 'Guides, tutorials and direct answers from our engineering team, from first integration to production tuning.' },
  { question: 'DH-Robotics Technology', answer: 'The self-developed servo control system with precision force control behind every DH-Robotics product.' },
]

const trustedLogos = [
  { name: 'Huawei',  src: '/images/logos/huawei.svg',  h: 'h-[83px]' },
  { name: 'Toyota',  src: '/images/logos/toyota.svg',  h: 'h-[70px]' },
  { name: 'DJI',     src: '/images/logos/dji.svg',     h: 'h-[62px]' },
  { name: 'Nissan',  src: '/images/logos/nissan.svg',  h: 'h-[100px]' },
  { name: 'Samsung', src: '/images/logos/samsung.svg', h: 'h-[49px]' },
  { name: 'Bosch',   src: '/images/logos/bosch.svg',   h: 'h-[28px]' },
  { name: 'KFC',     src: '/images/logos/kfc.svg',     h: 'h-[84px]' },
  { name: 'Hyundai', src: '/images/logos/hyundai.svg', h: 'h-[19px]' },
]

// ── CMS: resources (news + events) ──
let posts: any[] = []
try {
  const raw = await client.fetch(`*[_type in ["news","event"]] | order(date desc)[0...8]{
    _type, title, "slug": slug.current, date, category, "img": heroImage.asset._ref
  }`)
  posts = (raw ?? []).map((p: any) => ({
    title: p.title,
    href: p._type === 'event' ? `/events/${p.slug}` : `/news/${p.slug}`,
    date: p.date ? new Date(p.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '',
    tag: p._type === 'event' ? 'Event' : (p.category === 'insights' ? 'Insights' : 'News'),
    img: p.img ? assetUrl(p.img, 800) : '/images/news-placeholder.webp',
  }))
} catch { posts = [] }
---
<Layout title="Home">

  <!-- ═══ 1. Hero (slider) ═══ -->
  <section class="bg-bg-other">

    <!-- Desktop -->
    <div class="relative h-[760px] max-lg:hidden">
      <div class="swiper hero-swiper h-full">
        <div class="swiper-wrapper">
          {heroSlides.map(s => (
            <div class="swiper-slide relative overflow-hidden">
              <img src={s.img} alt="" aria-hidden="true" class:list={[s.imgClass, 'pointer-events-none select-none']} />

              <div class="absolute inset-x-0 bottom-8">
                <div class="global-padding">
                  <div class="mx-auto max-w-[1200px]">
                    <div class="w-[528px] flex flex-col gap-6">
                      <div class="flex gap-2 items-center">
                        <span class="inline-flex items-center gap-2 pl-2 pr-3 py-[6px] rounded-[24px] bg-fg-other-1">
                          <span class="size-1 rounded-full bg-fg-tertiary"></span>
                          <span class="text-tiny-medium text-trim-off text-text-tertiary uppercase">S</span>
                          <span class="w-3 h-px bg-fg-tertiary"></span>
                          <span class="text-tiny-medium text-trim-off text-text-tertiary uppercase">{s.tag}</span>
                        </span>
                        <span class="inline-flex items-center gap-2 pl-2 pr-3 py-[6px] rounded-[24px] bg-fg-other-3">
                          <span class="size-1 rounded-full bg-fg-quaternary"></span>
                          <span class="text-tiny-medium text-trim-off text-text-quaternary uppercase">New</span>
                        </span>
                      </div>
                      <h1 class="text-h3 text-text-primary">{s.title}</h1>
                      <p class="text-large text-text-primary max-w-[318px]">{s.subtitle}</p>
                      <Button label="Explore" href={s.href} variant="black" />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Controls (in container, right side) -->
      <div class="absolute inset-x-0 bottom-8 z-10 pointer-events-none">
        <div class="global-padding">
          <div class="mx-auto max-w-[1200px] flex justify-end">
            <div class="flex items-center gap-8 pointer-events-auto">
              <div class="hero-dots flex items-center gap-2 px-3 py-2"></div>
              <div class="flex items-center gap-4">
                <button class="hero-prev size-10 rounded-full bg-bg-primary flex items-center justify-center transition-opacity cursor-pointer" aria-label="Previous">
                  <svg class="size-6" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button class="hero-next size-10 rounded-full bg-bg-primary flex items-center justify-center hover:bg-bg-secondary transition-colors cursor-pointer" aria-label="Next">
                  <svg class="size-6" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile -->
    <div class="lg:hidden">
      <div class="swiper hero-swiper-m">
        <div class="swiper-wrapper">
          {heroSlides.map(s => (
            <div class="swiper-slide">
              <div class="bg-bg-primary global-padding pt-12 pb-10">
                <div class="flex flex-col items-center gap-6 text-center">
                  <div class="flex gap-2 items-center justify-center flex-wrap">
                    <span class="inline-flex items-center gap-2 pl-2 pr-3 py-[6px] rounded-[24px] bg-fg-other-1">
                      <span class="size-1 rounded-full bg-fg-tertiary"></span>
                      <span class="text-tiny-medium text-trim-off text-text-tertiary uppercase">S</span>
                      <span class="w-3 h-px bg-fg-tertiary"></span>
                      <span class="text-tiny-medium text-trim-off text-text-tertiary uppercase">{s.tag}</span>
                    </span>
                    <span class="inline-flex items-center gap-2 pl-2 pr-3 py-[6px] rounded-[24px] bg-fg-other-3">
                      <span class="size-1 rounded-full bg-fg-quaternary"></span>
                      <span class="text-tiny-medium text-trim-off text-text-quaternary uppercase">New</span>
                    </span>
                  </div>
                  <h1 class="text-h3 text-text-primary">{s.title}</h1>
                  <p class="text-large text-text-primary max-w-[280px]">{s.subtitle}</p>
                  <div class="flex justify-center">
                    <Button label="Explore" href={s.href} variant="black" />
                  </div>
                </div>
              </div>
              <div class="relative h-[376px] overflow-hidden">
                <img src={s.img} alt="" aria-hidden="true"
                  class="absolute left-1/2 -translate-x-1/2 top-7 w-[94%] max-w-none object-contain pointer-events-none select-none" />
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="relative -mt-16 z-10">
        <div class="global-padding">
          <div class="flex items-center justify-between">
            <div class="hero-dots-m flex items-center gap-2 px-3 py-2"></div>
            <div class="flex items-center gap-4">
              <button class="hero-prev-m size-10 rounded-full bg-bg-primary flex items-center justify-center cursor-pointer" aria-label="Previous">
                <svg class="size-6" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="hero-next-m size-10 rounded-full bg-bg-primary flex items-center justify-center cursor-pointer" aria-label="Next">
                <svg class="size-6" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

  </section>


  <!-- ═══ 2. Proven Success ═══ -->
  <section class="proven-stack bg-bg-primary pt-20 pb-[120px] max-lg:pt-12 max-lg:pb-16">
    <div class="global-padding">
      <div class="mx-auto max-w-[1200px]">

        <div class="proven-stage relative">

        <!-- Heading pins inside its own track, which ends where the stack does,
             so heading and cards release together instead of overlapping -->
        <div class="proven-head-track lg:absolute lg:inset-x-0 lg:top-0" style="bottom: var(--proven-release, 0px)">
          <div class="proven-head lg:sticky lg:top-[96px] z-10 bg-bg-primary">
            <p class="text-regular text-text-primary text-center max-w-[500px] mx-auto">
              Watch our intelligent grippers and motion control solutions in action across global manufacturing lines, delivering real-world efficiency and precision.
            </p>
            <h2 class="text-h1 mob-h2 text-text-primary text-center mt-10 max-lg:mt-8">Proven Success</h2>
          </div>
        </div>

        <div class="proven-body max-lg:mt-10 flex items-start gap-10 max-lg:flex-col max-lg:gap-8" style="padding-top: var(--proven-head-h, 0px)">

          <!-- Left rail: client names, pinned (desktop) -->
          <div class="shrink-0 w-[160px] lg:sticky lg:top-[var(--proven-top)] flex flex-col gap-8 items-center max-lg:hidden">
            {provenCases.map((c, i) => (
              <span class:list={['proven-tab text-h5 text-text-primary transition-opacity duration-300', i === 0 ? 'is-active' : '']}>{c.client}</span>
            ))}
          </div>

          <!-- Cards stack: every card sticks at the same offset, so each covers the last.
               Description rides along with its own card and cross-fades on the swap. -->
          <ul class="flex-1 min-w-0 w-full flex flex-col gap-8 list-none p-0 m-0">
            {provenCases.map((c, i) => (
              <li class="proven-card lg:sticky lg:top-[var(--proven-top)]" data-proven={i}>
                <div class="flex items-start gap-10 max-lg:flex-col max-lg:gap-5">
                  <div class="proven-media flex-1 min-w-0 w-full rounded-tiny overflow-hidden bg-bg-secondary aspect-[640/483] lg:max-h-[calc(100svh-var(--proven-top)-40px)]">
                    <img src={c.img} alt={c.client} class="w-full h-full object-cover" loading="lazy" />
                  </div>
                  <div class="proven-meta shrink-0 lg:w-[260px] max-lg:w-full flex flex-col gap-3">
                    <span class="text-h6 text-text-primary lg:hidden">{c.client}</span>
                    <p class="text-small text-text-secondary">{c.desc}</p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 3. Trusted by Industry Giants ═══ -->
  <section class="bg-bg-primary pb-[120px] max-lg:pb-16">
    <div class="global-padding">
      <div class="mx-auto max-w-[1200px]">
        <h3 class="text-h5 mob-h6 text-text-primary text-center">Trusted by Industry Giants</h3>
      </div>
    </div>

    <!-- Infinite marquee -->
    <div class="logo-marquee relative mt-12 max-lg:mt-8 overflow-hidden">
      <div class="logo-track flex items-center w-max">
        {[0, 1].map(() => (
          <div class="flex items-center shrink-0" aria-hidden="false">
            {trustedLogos.map(logo => (
              <span class="w-[216px] h-[129px] max-lg:w-[162px] max-lg:h-[96px] shrink-0 flex items-center justify-center px-1">
                <img src={logo.src} alt={logo.name} class:list={[logo.h, 'w-auto max-w-full object-contain max-lg:h-auto max-lg:max-h-[56px]']} />
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 4. Why DH-Robotics ═══ -->
  <section class="bg-bg-other pt-[120px] pb-[72px] max-lg:pt-16 max-lg:pb-10">
    <div class="global-padding">
      <div class="mx-auto max-w-[1200px] text-center">
        <h2 class="text-h2 mob-h3 text-text-primary">Why DH-Robotics</h2>
        <p class="text-regular text-text-primary max-w-[592px] mx-auto mt-8 max-lg:mt-6">
          We don’t just manufacture grippers — we develop industry-leading motion control solutions that redefine precision, intelligence, and reliability for modern factories.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-bg-other pb-[120px] max-lg:pb-16">
    <div class="global-padding">
      <div class="mx-auto max-w-[1200px] grid grid-cols-3 gap-4 max-lg:grid-cols-1">
        {whyCards.map(card => (
          <div class="why-card group relative h-[700px] max-lg:h-[440px] rounded-tiny overflow-hidden bg-bg-secondary">
            <img src={card.img} alt={card.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />

            <!-- Legibility gradient (fades out once the panel colours in) -->
            <div class="absolute inset-x-0 bottom-0 h-[220px] bg-gradient-to-t from-fg-alternative/55 to-transparent pointer-events-none transition-opacity duration-500 lg:group-hover:opacity-0 max-lg:opacity-0"></div>

            <!-- Bottom-anchored content: grows upward on hover, background + text colours flip -->
            <div class="absolute inset-x-0 bottom-0 p-6">
              <div class="why-bg absolute inset-0 bg-bg-primary opacity-0 transition-opacity duration-500 lg:group-hover:opacity-100 max-lg:opacity-100"></div>

              <div class="relative flex flex-col gap-6">
                <div class="flex items-center gap-4">
                  <span class="why-icon size-14 shrink-0 flex items-center justify-center rounded-tiny transition-colors duration-500 lg:group-hover:bg-bg-secondary max-lg:bg-bg-secondary">
                    <svg class="why-glyph size-12 lg:group-hover:size-6 max-lg:size-6 text-text-alternate lg:group-hover:text-text-primary max-lg:text-text-primary transition-all duration-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      {card.icon === 'plus' && <><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></>}
                      {card.icon === 'chip' && <><rect x="6" y="6" width="12" height="12" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></>}
                      {card.icon === 'expand' && <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>}
                    </svg>
                  </span>
                  <span class="text-h5 mob-h6 text-text-alternate lg:group-hover:text-text-primary max-lg:text-text-primary origin-left lg:group-hover:scale-[0.85] max-lg:scale-[0.85] transition-all duration-500">{card.title}</span>
                </div>

                <!-- Details reveal: grid-rows 0fr -> 1fr lifts the whole block up -->
                <div class="grid grid-rows-[0fr] lg:group-hover:grid-rows-[1fr] max-lg:grid-rows-[1fr] transition-[grid-template-rows] duration-500 ease-out">
                  <div class="overflow-hidden">
                    <div class="flex flex-col gap-6">
                      <p class="text-small text-text-secondary">{card.desc}</p>
                      <ul class="flex flex-col gap-3">
                        {card.points.map(p => (
                          <li class="text-small text-text-primary">- {p}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 5. Equipment ═══ -->
  <section class="bg-bg-primary pt-[120px] pb-14 max-lg:pt-16 max-lg:pb-10">
    <div class="global-padding">
      <div class="mx-auto max-w-[1200px] text-center">
        <h2 class="text-h1 mob-h2 text-text-primary">Equipment</h2>
        <p class="text-regular text-text-primary max-w-[491px] mx-auto mt-8 max-lg:mt-6">
          DH-Robotics provides high-performance and reliable electric actuator solutions, enhancing intelligent gripping and precision motion control.
        </p>
      </div>
    </div>
  </section>

  {equipment.length > 0 && (
