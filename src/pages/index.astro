<style>
  /* Infinite logo marquee — track holds two identical sets, so -50% loops seamlessly */
  .logo-track {
    animation: logo-scroll 40s linear infinite;
  }
  @keyframes logo-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-track { animation: none; }
  }
  /* Fade the edges so logos appear/disappear softly */
  .logo-marquee::before,
  .logo-marquee::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    width: 120px;
    z-index: 1;
    pointer-events: none;
  }
  .logo-marquee::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg-primary), transparent);
  }
  .logo-marquee::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg-primary), transparent);
  }

  /* ── Country picker (Tom Select) styled for the dark-blue form ── */
  #contact-country + .ts-wrapper { --ts-fg: var(--color-text-alternate); }

  :global(.ts-wrapper) {
    border-bottom: 1px solid color-mix(in srgb, var(--color-text-alternate) 40%, transparent);
    transition: border-color 0.2s ease;
  }
  :global(.ts-wrapper.focus) { border-bottom-color: var(--color-text-alternate); }

  /* base tom-select.css paints .single.input-active and .full white — keep it transparent */
  :global(.ts-wrapper .ts-control),
  :global(.ts-wrapper.single.input-active .ts-control),
  :global(.ts-wrapper.full .ts-control) {
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0.75rem 1.5rem 0.75rem 0;
    box-shadow: none;
    color: var(--color-text-alternate);
    font-size: var(--text-regular-size, 1rem);
    line-height: 1.25;
    min-height: calc(1.25em + 1.5rem);
    cursor: pointer;
  }
  :global(.ts-wrapper .ts-control input) {
    color: var(--color-text-alternate);
    font-size: inherit;
    line-height: inherit;
  }
  :global(.ts-wrapper .ts-control input::placeholder) {
    color: color-mix(in srgb, var(--color-text-alternate) 50%, transparent);
    opacity: 1;
  }
  /* Chevron matching the native select next to it */
  :global(.ts-wrapper.single .ts-control::after) {
    content: '';
    position: absolute;
    right: 4px;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    margin-top: -0.3125rem;
    border: 0;
    border-right: 1.5px solid var(--color-text-alternate);
    border-bottom: 1.5px solid var(--color-text-alternate);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    pointer-events: none;
  }
  :global(.ts-wrapper.single.dropdown-active .ts-control::after) {
    margin-top: -0.0625rem;
    transform: rotate(-135deg);
  }

  /* Dropdown sits on white so the long list stays readable */
  :global(.ts-dropdown) {
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border-other-2);
    border-radius: 4px;
    box-shadow: 0 16px 40px rgba(10, 15, 21, 0.18);
    margin-top: 4px;
    overflow: hidden;
  }
  :global(.ts-dropdown .ts-dropdown-content) { max-height: 260px; }
  :global(.ts-dropdown .option) {
    color: var(--color-text-primary);
    padding: 0.625rem 0.875rem;
  }
  :global(.ts-dropdown .option.active) {
    background: var(--color-fg-other-4);
    color: var(--color-text-primary);
  }
  :global(.ts-dropdown .no-results) {
    color: var(--color-text-secondary);
    padding: 0.625rem 0.875rem;
  }

  /* Proven Success: client names act as slider tabs */
  /* Offset the stacked cards sit at — clears the pinned heading above them */
  .proven-stack { --proven-top: 340px; }
  @media (max-width: 1023px) { .proven-stack { --proven-top: 0px; } }

  .proven-tab { opacity: 0.4; }
  .proven-tab.is-active { opacity: 1; }

  /* Scroll drives these per frame — keep a short ease so a fast flick still reads smoothly */
  .proven-media { will-change: transform, filter; transition: transform 0.12s linear, filter 0.12s linear; }
  .proven-meta { transition: opacity 0.2s linear; }

  @media (prefers-reduced-motion: reduce) {
    .proven-media { transition: none; filter: none !important; transform: none !important; }
  }

  /* Equipment tabs: inactive dimmed to 40%, active full (per design) */
  .eq-tab { opacity: 0.4; transition: opacity 0.2s ease; }
  .eq-tab:hover, .eq-tab.is-active { opacity: 1; }

  .eq-line { background: rgba(0, 0, 0, 0.16); position: relative; }
  .eq-line.is-active::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-fg-alternative);
  }

  /* Industry carousel: fixed 600px slides, centred with peeks on both sides */
  .industry-swiper { overflow: visible; }
  .industry-swiper .swiper-slide {
    width: 600px;
    max-width: calc(100vw - 32px);
  }

  .ind-tab { color: var(--color-text-secondary); }
  .ind-tab:hover, .ind-tab.is-active { color: var(--color-text-primary); }
  .ind-tab.is-active::after {
    content: ''; position: absolute; left: 0; bottom: -1px;
    width: 100%; height: 2px; background: var(--color-fg-alternative);
  }

  .res-tab { color: var(--color-text-secondary); }
  .res-tab:hover, .res-tab.is-active { color: var(--color-text-primary); }
  .res-tab.is-active::after {
    content: ''; position: absolute; left: 0; bottom: -1px;
    width: 100%; height: 2px; background: var(--color-fg-alternative);
  }
</style>

<script>
  import Swiper from 'swiper'
  import { Navigation } from 'swiper/modules'
  import 'swiper/css'
  import TomSelect from 'tom-select'

  // ── Country picker with search ──
  {
    const el = document.getElementById('contact-country')
    if (el) {
      const ts = new TomSelect(el, {
        placeholder: 'Enter your country/region…',
        maxOptions: null,
        items: [],
        sortField: { field: 'text', direction: 'asc' },
        // match from the start of any word, so "kor" finds "South Korea"
        score: function (search: string) {
          const q = search.toLowerCase().trim()
          return (item: any) => {
            const t = String(item.text).toLowerCase()
            if (!q) return 1
            if (t.startsWith(q)) return 3
            if (t.split(/[\s-]+/).some(w => w.startsWith(q))) return 2
            return t.includes(q) ? 1 : 0
          }
        },
      })
      ts.clear(true)
    }
  }

  function initTabGroup(selector: string) {
    const tabs = Array.from(document.querySelectorAll<HTMLElement>(selector))
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.toggle('is-active', t === tab))
      })
    })
  }
  // ── Stats count up once the grid scrolls into view ──
  {
    const grid = document.getElementById('stats-grid')
    const values = Array.from(document.querySelectorAll<HTMLElement>('.stat-value'))
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (grid && values.length && !reduced) {
      // "300,000+" -> prefix "", digits "300,000", suffix "+"
      const parsed = values.map(el => {
        const raw = el.dataset.count ?? el.textContent ?? ''
        const m = raw.match(/[\d][\d,]*(\.\d+)?/)
        if (!m) return null
        const digits = m[0]
        return {
          el,
          prefix: raw.slice(0, m.index),
          suffix: raw.slice(m.index! + digits.length),
          target: parseFloat(digits.replace(/,/g, '')),
          decimals: (digits.split('.')[1] ?? '').length,
          grouped: digits.includes(','),
        }
      }).filter(Boolean) as any[]

      const format = (p: any, n: number) => {
        const v = p.decimals ? n.toFixed(p.decimals) : String(Math.round(n))
        return p.prefix + (p.grouped ? Number(v).toLocaleString('en-US') : v) + p.suffix
      }

      parsed.forEach(p => { p.el.textContent = format(p, 0) })

      const DURATION = 1600
      const run = () => {
        const start = performance.now()
        const tick = (now: number) => {
          const t = Math.min((now - start) / DURATION, 1)
          const eased = 1 - Math.pow(1 - t, 4)
          parsed.forEach(p => { p.el.textContent = format(p, p.target * eased) })
          if (t < 1) requestAnimationFrame(tick)
          else parsed.forEach(p => { p.el.textContent = p.el.dataset.count! })
        }
        requestAnimationFrame(tick)
      }

      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) { io.disconnect(); run() }
        })
      }, { threshold: 0.35 })
      io.observe(grid)
    }
  }

  // Equipment tabs switch the category panel and drive the progress lines
  {
    const tabs = Array.from(document.querySelectorAll<HTMLElement>('.eq-tab'))
    const lines = Array.from(document.querySelectorAll<HTMLElement>('.eq-line'))
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.eq-panel'))
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t, j) => t.classList.toggle('is-active', j === i))
        lines.forEach((l, j) => l.classList.toggle('is-active', j === i))
        panels.forEach((p, j) => p.classList.toggle('hidden', j !== i))
      })
    })
  }
  // .ind-tab is driven by the industry carousel (see sync below), not this helper
  // ── Resources tabs filter the slider ──
  {
    const tabs = Array.from(document.querySelectorAll<HTMLElement>('.res-tab'))
    const wrap = document.querySelector<HTMLElement>('[data-swiper-id="resources-slider"]')
    const swiperEl = document.querySelector<HTMLElement>('.swiper.resources-slider')
    const empty = document.getElementById('resources-empty')

    const track = swiperEl?.querySelector<HTMLElement>('.swiper-wrapper')

    if (tabs.length && wrap && track) {
      const allSlides = Array.from(track.querySelectorAll<HTMLElement>('.swiper-slide'))

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.toggle('is-active', t === tab))

          const want = (tab.textContent || '').trim()
          const keep = want === 'All'
            ? allSlides
            : allSlides.filter(n => n.dataset.resTag === want)

          track.replaceChildren(...keep)

          empty?.classList.toggle('hidden', keep.length > 0)
          wrap.closest('.swiper-section')?.classList.toggle('hidden', keep.length === 0)
          ;(wrap as any).sliderRefresh?.()
        })
      })
    }
  }

  // ── Hero slider ──
  // Graduated dots: size shrinks with distance from the active slide (per design)
  const DOT_SIZES = [10, 8, 6, 4, 2]

  function buildDotSlider(swiperSel: string, dotsSel: string, prevSel: string, nextSel: string) {
    const el = document.querySelector<HTMLElement>(swiperSel)
    const dotsWrap = document.querySelector<HTMLElement>(dotsSel)
    if (!el || !dotsWrap) return

    const count = el.querySelectorAll('.swiper-slide').length
    dotsWrap.innerHTML = ''
    const dots: HTMLElement[] = []
    for (let i = 0; i < count; i++) {
      const d = document.createElement('button')
      d.className = 'hero-dot rounded-full bg-fg-alternative shrink-0 cursor-pointer transition-all duration-300'
      d.setAttribute('aria-label', `Go to slide ${i + 1}`)
      dotsWrap.appendChild(d)
      dots.push(d)
    }

    const paint = (active: number) => {
      dots.forEach((d, i) => {
        const size = DOT_SIZES[Math.min(Math.abs(i - active), DOT_SIZES.length - 1)]
        d.style.width = `${size}px`
        d.style.height = `${size}px`
        d.style.opacity = i === active ? '1' : '0.3'
      })
    }

    const swiper = new Swiper(swiperSel, {
      modules: [Navigation],
      slidesPerView: 1,
      spaceBetween: 0,
      speed: 600,
      navigation: { prevEl: prevSel, nextEl: nextSel },
      on: {
        afterInit: (s: any) => paint(s.activeIndex),
        slideChange: (s: any) => paint(s.activeIndex),
      },
    })

    dots.forEach((d, i) => d.addEventListener('click', () => swiper.slideTo(i)))
    paint(swiper.activeIndex)
  }

  buildDotSlider('.hero-swiper', '.hero-dots', '.hero-prev', '.hero-next')
  buildDotSlider('.hero-swiper-m', '.hero-dots-m', '.hero-prev-m', '.hero-next-m')
  buildDotSlider('.testimonial-swiper', '.testimonial-dots', '.testimonial-prev', '.testimonial-next')

  // ── Proven Success: cards stack via CSS sticky; the rails follow the top card ──
  {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.proven-card'))
    const tabs = Array.from(document.querySelectorAll<HTMLElement>('.proven-tab'))
    const media = cards.map(c => c.querySelector<HTMLElement>('.proven-media'))
    const metas = cards.map(c => c.querySelector<HTMLElement>('.proven-meta'))

    if (cards.length) {
      let current = -1
      let ticking = false

      const stage = document.querySelector<HTMLElement>('.proven-stage')
      const head = document.querySelector<HTMLElement>('.proven-head')
      const HEAD_TOP = 96
      const HEAD_GAP = 56

      // The heading is pinned higher than the cards, so its track has to end early —
      // otherwise it stays put after the stack releases and the photos ride over it.
      const layout = () => {
        if (!stage || !head) return
        if (window.innerWidth < 1024) {
          stage.style.removeProperty('--proven-head-h')
          stage.style.removeProperty('--proven-release')
          return
        }
        const headH = head.getBoundingClientRect().height
        const cardTop = parseFloat(getComputedStyle(cards[0]).top) || 0
        const cardH = cards[0].getBoundingClientRect().height
        // The heading is out of flow, so the body has to reserve its height plus the gap
        stage.style.setProperty('--proven-head-h', `${headH + HEAD_GAP}px`)
        stage.style.setProperty('--proven-release', `${Math.max(0, (cardTop + cardH) - (HEAD_TOP + headH))}px`)
      }

      const clamp = (n: number) => Math.min(Math.max(n, 0), 1)

      const reset = () => {
        media.forEach(m => { if (m) m.style.cssText = '' })
        metas.forEach(m => { if (m) m.style.cssText = '' })
      }

      const apply = () => {
        ticking = false
        if (window.innerWidth < 1024) { reset(); return }

        // Every card sticks at the same offset, so the last one that reached it is on top
        const stickTop = parseFloat(getComputedStyle(cards[0]).top)
        if (Number.isNaN(stickTop)) return
        const span = cards[0].getBoundingClientRect().height + 32

        let active = 0
        cards.forEach((card, i) => {
          const top = card.getBoundingClientRect().top
          if (top <= stickTop + 2) active = i

          // arrive: 0 while the card is still coming up, 1 once it has landed
          const arrive = clamp(1 - (top - stickTop) / span)
          // cover: how far the next card has come over this one
          const next = cards[i + 1]
          const cover = next ? clamp(1 - (next.getBoundingClientRect().top - stickTop) / span) : 0

          const m = media[i]
          if (m) {
            m.style.transform = `translateY(${-32 * cover}px) scale(${1 - 0.07 * cover})`
            m.style.filter = cover > 0.01 ? `blur(${8 * cover}px)` : ''
            m.style.transformOrigin = 'center top'
          }
          // Hand off in sequence, not in parallel: the outgoing text is gone before
          // the incoming one starts, with a brief empty beat in between
          const out = clamp((0.55 - cover) / 0.4)
          const into = clamp((arrive - 0.6) / 0.4)
          const meta = metas[i]
          if (meta) meta.style.opacity = String(Math.min(out, into))
        })

        if (active !== current) {
          current = active
          tabs.forEach((t, i) => t.classList.toggle('is-active', i === active))
        }
      }

      layout()
      apply()
      window.addEventListener('scroll', () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(apply)
      }, { passive: true })
      window.addEventListener('resize', () => { layout(); apply() })
    }
  }

  // ── Industry Applications: centred peek carousel, synced with the tab row ──
  {
    const el = document.querySelector<HTMLElement>('.industry-swiper')
    const progress = document.querySelector<HTMLElement>('.industry-progress')
    const tabsWrap = document.getElementById('industry-tabs')
    const tabs = Array.from(document.querySelectorAll<HTMLElement>('.ind-tab'))

    if (el) {
      const sync = (s: any) => {
        const i = s.activeIndex
        if (progress) progress.style.width = `${((i + 1) / s.slides.length) * 100}%`
        tabs.forEach((t, j) => t.classList.toggle('is-active', j === i))
        // keep the active tab visible while the row scrolls horizontally
        const active = tabs[i]
        if (active && tabsWrap) {
          const a = active.getBoundingClientRect()
          const w = tabsWrap.getBoundingClientRect()
          if (a.left < w.left || a.right > w.right) {
            // centre the active tab within the scroll container
            const delta = a.left - w.left - w.width / 2 + a.width / 2
            tabsWrap.scrollTo({ left: tabsWrap.scrollLeft + delta, behavior: 'smooth' })
          }
        }
      }

      const swiper = new Swiper('.industry-swiper', {
        modules: [Navigation],
        slidesPerView: 'auto',
        centeredSlides: true,
        spaceBetween: 16,
        grabCursor: true,
        navigation: { prevEl: '.industry-prev', nextEl: '.industry-next' },
        on: { afterInit: sync, slideChange: sync },
      })

      // Clicking a tab drives the carousel
      tabs.forEach((tab, i) => tab.addEventListener('click', () => swiper.slideTo(i)))
    }
  }
</script>
