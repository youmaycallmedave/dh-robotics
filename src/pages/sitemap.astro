---
import Layout from '../layouts/Layout.astro'
import Section from '../components/ui/Section.astro'
---
<Layout title="Sitemap">
  <Section pt="page" pb="lg">
    <div class="py-16 flex flex-col gap-10">

      <h1 class="text-h2 text-text-primary">DH Robotics — Sitemap</h1>

      <div class="flex flex-col gap-3">
        <h2 class="text-h5 text-text-primary border-b border-border-other-2 pb-2">Home</h2>
        <ul class="flex flex-col gap-3">
          <li><a href="/" class="text-regular text-text-tertiary hover:underline">Home</a></li>
          <li><a href="/styleguide" class="text-regular text-text-tertiary hover:underline">Style Guide</a></li>
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-h5 text-text-primary border-b border-border-other-2 pb-2">Products</h2>
        <ul class="flex flex-col gap-3">
          <li><a href="/products" class="text-regular text-text-tertiary hover:underline">Products — Index</a></li>
          <li><a href="/products/category" class="text-regular text-text-tertiary hover:underline">Products — Category</a></li>
          <li><a href="/products/series" class="text-regular text-text-tertiary hover:underline">Products — Series</a></li>
          <li><a href="/products/product" class="text-regular text-text-tertiary hover:underline">Products — Single Product</a></li>
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-h5 text-text-primary border-b border-border-other-2 pb-2">Applications</h2>
        <ul class="flex flex-col gap-3">
          <li class="text-regular" style="color: #22c55e"><a href="/applications" style="color: #22c55e">Applications — Index</a> ✓</li>
          <li class="text-regular" style="color: #22c55e"><a href="/applications/industry/medical-automation" style="color: #22c55e">Industry — Medical Automation</a> ✓</li>
          <li class="text-regular" style="color: #22c55e"><a href="/applications/action/grabbing" style="color: #22c55e">Action — Grabbing</a> ✓</li>
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-h5 text-text-primary border-b border-border-other-2 pb-2">Support</h2>
        <ul class="flex flex-col gap-3">
          <li class="text-regular" style="color: #22c55e"><a href="/support" style="color: #22c55e">Support — Index</a> ✓</li>
          <li class="text-regular" style="color: #f59e0b"><a href="/support/technology" style="color: #f59e0b">Technology</a> draft</li>
          <li class="text-regular" style="color: #22c55e"><a href="/support/software" style="color: #22c55e">Software</a> ✓</li>
          <li class="text-regular" style="color: #f59e0b">Support Hub — Template <span style="opacity:.7">(/support/[slug] — свёрстан, ждёт материалов в Sanity)</span></li>
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-h5 text-text-primary border-b border-border-other-2 pb-2">Explore</h2>
        <ul class="flex flex-col gap-3">
          <li class="text-regular" style="color: #22c55e"><a href="/news" style="color: #22c55e">News — Index</a> ✓</li>
          <li class="text-regular" style="color: #22c55e"><a href="/news/template" style="color: #22c55e">News — Template</a> ✓</li>
          <li class="text-regular" style="color: #22c55e"><a href="/events" style="color: #22c55e">Events — Index</a> ✓</li>
          <li class="text-regular" style="color: #22c55e"><a href="/events/template" style="color: #22c55e">Events — Template</a> ✓</li>
          <li><a href="/cases" class="text-regular text-text-tertiary hover:underline">Cases — Index</a></li>
          <li class="text-regular" style="color: #22c55e"><a href="/cases/template" style="color: #22c55e">Cases — Template</a> ✓</li>
          <li class="text-regular" style="color: #22c55e"><a href="/explore/downloads" style="color: #22c55e">Downloads</a> ✓</li>
          <li class="text-regular" style="color: #22c55e"><a href="/explore/faq" style="color: #22c55e">FAQ</a> ✓</li>
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-h5 text-text-primary border-b border-border-other-2 pb-2">Other</h2>
        <ul class="flex flex-col gap-3">
          <li class="text-regular" style="color: #22c55e"><a href="/contact" style="color: #22c55e">Contact us</a> ✓</li>
          <li class="text-regular" style="color: #22c55e"><a href="/privacy-policy" style="color: #22c55e">Privacy Policy</a> ✓</li>
          <li class="text-regular" style="color: #22c55e"><a href="/search" style="color: #22c55e">Search</a> ✓</li>
          <li class="text-regular" style="color: #22c55e"><a href="/404" style="color: #22c55e">404</a> ✓</li>
        </ul>
      </div>

    </div>
  </Section>
</Layout>
