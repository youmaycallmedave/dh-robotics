---
import Layout from '../layouts/Layout.astro'
import Button from '../components/ui/Button.astro'
import ScrollIndicator from '../components/ui/ScrollIndicator.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
---

<Layout title="Support">

  <Breadcrumbs crumbs={[{ label: 'Support' }]} />

  <!-- Hero -->
  <section class="bg-bg-primary pt-[208px] pb-14 max-lg:pt-[72px] max-lg:pb-10">
    <div class="global-padding">
      <div class="mx-auto max-w-[795px] flex flex-col gap-10 max-lg:gap-9">
        <h1 class="text-h1 mob-h2 text-text-primary">Support</h1>
        <div class="flex items-end justify-between gap-10">
          <p class="text-regular text-text-primary max-w-[592px]">
            Based on the accurately understanding on the customer needs, DH-Robotics develops the electric grippers and actuators with the advantages of "precision, intelligence, flexibility, and User-friendly". After 6 years development, DH-Robotics already became the leading company of precision motion control solutions in Chinese market.
          </p>
          <ScrollIndicator variant="vertical" href="#service-cards" showOnMobile={true} />
        </div>
      </div>
    </div>
  </section>

  <!-- Cards — div, не section, чтобы overflow:clip не ломал sticky -->
  <div id="service-cards" class="bg-bg-primary pb-lg max-lg:pt-0 max-lg:pb-[72px]">
    <div class="global-padding">
      <div class="flex items-start gap-0">

        <!-- Sticky sidebar (xl+) -->
        <div class="hidden xl:block shrink-0 w-[200px] self-stretch">
          <div id="service-nav" class="sticky top-[45vh] flex flex-col gap-5 pl-4 border-l border-border-secondary ml-auto w-fit mr-2">
            <div id="service-nav-indicator" class="absolute -left-px top-0 w-px h-[9px] bg-fg-alternative transition-transform duration-300 ease-out"></div>
            <a href="#service-software" data-nav-link="0" class="text-tiny-medium text-text-primary whitespace-nowrap hover:text-text-tertiary transition-colors duration-150">User control software</a>
            {/* HIDDEN (draft): Technology — restore when page is ready */}
            {/* <a href="#service-technology" data-nav-link="1" class="text-tiny-medium text-text-secondary whitespace-nowrap hover:text-text-tertiary transition-colors duration-150">Technology</a> */}
          </div>
        </div>

        <!-- Cards -->
        <div class="flex-1 flex flex-col gap-14 max-lg:gap-10 items-center">

          <!-- Card: Software -->
          <div id="service-software" class="relative h-[483px] rounded-[4px] overflow-hidden w-full max-w-[795px] max-lg:h-[343px]">
            <img
              src="/images/service-content-1.webp"
              alt=""
              class="absolute inset-0 w-full h-full object-cover"
              aria-hidden="true"
            />
            <img
              src="/images/service-software-overlay.png"
              alt=""
              class="absolute right-0 top-1/2 -translate-y-1/2 h-full w-auto -scale-y-100 pointer-events-none"
              aria-hidden="true"
            />
            <div class="absolute top-10 left-10 flex flex-col gap-4 w-[220px] max-lg:top-6 max-lg:left-6 max-lg:w-[295px]">
              <div class="flex flex-col gap-5">
                <h2 class="text-h4 mob-h5 text-text-primary">User control software</h2>
                <p class="text-tiny-medium text-text-primary opacity-70 w-[187px] max-lg:w-auto">Learn about the host computer debugging software</p>
              </div>
              <Button label="Explore" href="/support/software" variant="black" />
            </div>
          </div>

          {/* HIDDEN (draft): DH-Robotics Technology card — restore when page is ready */}
          {/*
          <div id="service-technology" class="relative h-[483px] rounded-[4px] overflow-hidden w-full max-w-[795px] bg-[#f9f9f9] max-lg:h-[343px]">
            <img
              src="/images/service-content-2.webp"
              alt="DH-Robotics Technology"
              class="absolute inset-0 w-full h-full object-cover object-left-top"
            />
            <div class="absolute top-10 left-10 flex flex-col gap-4 w-[263px] max-lg:top-6 max-lg:left-6 max-lg:w-[295px]">
              <div class="flex flex-col gap-5">
                <h2 class="text-h4 mob-h5 text-text-primary">DH-Robotics Technology</h2>
                <p class="text-tiny-medium text-text-primary opacity-70">With deep technical background, DH-Robotics has developed the robotic and precision motion control technologies for many years.</p>
              </div>
              <Button label="Explore" href="/support/technology" variant="black" />
            </div>
          </div>
          */}

        </div>

        <!-- Right spacer to keep cards visually centered -->
        <div class="hidden xl:block shrink-0 w-[200px]"></div>

      </div>
    </div>
  </div>

</Layout>

<script>
  const nav = document.getElementById('service-nav')
  const indicator = document.getElementById('service-nav-indicator')
  const navLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-link]'))
  const cards = [
    document.getElementById('service-software'),
    // HIDDEN (draft): document.getElementById('service-technology'),
  ]

  function updateActive() {
    const threshold = window.innerHeight * 0.5
    let activeIdx = 0

    cards.forEach((card, i) => {
      if (card && card.getBoundingClientRect().top <= threshold) activeIdx = i
    })

    navLinks.forEach((link, i) => {
      link.classList.toggle('text-text-primary', i === activeIdx)
      link.classList.toggle('text-text-secondary', i !== activeIdx)
    })

    const activeLink = navLinks[activeIdx]
    if (activeLink && indicator) {
      const offset = activeLink.offsetTop + (activeLink.offsetHeight - 9) / 2
      indicator.style.transform = `translateY(${Math.max(0, offset)}px)`
    }
  }

  if (nav) {
    updateActive()
    window.addEventListener('scroll', updateActive, { passive: true })
  }

  // Smooth scroll for sidebar links
  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault()
      const id = link.getAttribute('href')?.slice(1)
      if (id) document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' })
    })
  })
</script>
